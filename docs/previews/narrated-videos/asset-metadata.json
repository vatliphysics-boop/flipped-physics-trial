    "mp4Bytes": 4664141,
    "mediaPath": "public/videos/nuclear-lessons/b21.mp4",
    "metadata": {
      "codec": "h264",
      "width": 1920,
      "height": 1080,
      "fps": 30,
      "frames": 2694,
      "seconds": 89.8,
      "bytes": 4664141,
      "renderedMotionFrames": 829,
      "capturedFrames": 843,
      "audio": {
        "codec": "aac",
        "sampleRate": 48000,
        "channels": 1,
        "startSeconds": 0,
        "durationSeconds": 89.8
      },
      "scenes": [
        {
          "sceneIndex": 0,
          "from": 0,
          "durationFrames": 563,
          "motionFrames": 64,
          "cues": [
            {
              "from": 15,
              "duration": 251,
              "text": "Hai hạt alpha cùng có động năng xa tâm 8 MeV. Ta chỉ đổi tham số va chạm."
            },
            {
              "from": 269,
              "duration": 270,
              "text": "Đường tới A cách tâm vàng 90 fm. Đường tới B cách 10 fm. Em dự đoán hạt nào lệch nhiều hơn?"
            }
          ]
        },
        {
          "sceneIndex": 1,
          "from": 563,
          "durationFrames": 369,
          "motionFrames": 339,
          "cues": [
            {
              "from": 15,
              "duration": 174,
              "text": "Theo dõi lượt A. Lực đẩy điện làm đường đi của hạt alpha cong dần."
            },
            {
              "from": 192,
              "duration": 153,
              "text": "Góc lệch là góc giữa hướng tới và hướng đi khi hạt ở xa tâm."
            }
          ]
        },
        {
          "sceneIndex": 2,
          "from": 932,
          "durationFrames": 407,
          "motionFrames": 234,
          "cues": [
            {
              "from": 15,
              "duration": 215,
              "text": "Giữ cùng động năng và cùng đồng hồ. Hạt ở lượt B đi gần tâm vàng hơn và lệch mạnh hơn."
            },
            {
              "from": 233,
              "duration": 150,
              "text": "Góc lệch của A khoảng 18 độ, của B khoảng 110 độ."
            }
          ]
        },
        {
          "sceneIndex": 3,
          "from": 1339,
          "durationFrames": 422,
          "motionFrames": 64,
          "cues": [
            {
              "from": 15,
              "duration": 158,
              "text": "Tán xạ góc lớn cho thấy điện tích dương tập trung trong một vùng nhỏ."
            },
            {
              "from": 176,
              "duration": 222,
              "text": "A đếm nucleon, Z đếm proton. Số neutron N bằng A trừ Z."
            }
          ]
        },
        {
          "sceneIndex": 4,
          "from": 1761,
          "durationFrames": 439,
          "motionFrames": 64,
          "cues": [
            {
              "from": 15,
              "duration": 227,
              "text": "Carbon-12 và carbon-13 đều có 6 proton. Carbon-13 có thêm 1 neutron."
            },
            {
              "from": 245,
              "duration": 170,
              "text": "Màu và vị trí của các quả cầu chỉ là quy ước để quan sát cấu tạo."
            }
          ]
        },
        {
          "sceneIndex": 5,
          "from": 2200,
          "durationFrames": 494,
          "motionFrames": 64,
          "cues": [
            {
              "from": 15,
              "duration": 239,
              "text": "Hai lượt minh họa không cho biết tần suất tán xạ. Trong thí nghiệm lá vàng, rất ít hạt lệch góc lớn."
            },
            {
              "from": 257,
              "duration": 213,
              "text": "Tự kiểm tra. Carbon-14 có 6 proton. Lấy 14 trừ 6 được 8 neutron."
            }
          ]
        }
      ]
    },
