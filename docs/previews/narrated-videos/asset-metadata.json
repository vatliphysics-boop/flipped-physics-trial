      "scenes": [
        {
          "sceneIndex": 0,
          "from": 0,
          "durationFrames": 474,
          "motionFrames": 64,
          "cues": [
            {
              "from": 15,
              "duration": 294,
              "text": "Bảng 25.1 cho độ phóng xạ ban đầu 151 Bq. Một nửa là 75,5 Bq."
            },
            {
              "from": 312,
              "duration": 138,
              "text": "Em hãy tìm hai mốc đo nằm hai bên mức nửa ban đầu."
            }
          ]
        },
        {
          "sceneIndex": 1,
          "from": 474,
          "durationFrames": 434,
          "motionFrames": 404,
          "cues": [
            {
              "from": 15,
              "duration": 203,
              "text": "Giữ độ phóng xạ ban đầu. Thử chu kì 40 giây và theo dõi đường lí thuyết."
            },
            {
              "from": 221,
              "duration": 189,
              "text": "Các chấm đánh dấu số liệu SGK, được giữ nguyên khi ta đổi chu kì thử."
            }
          ]
        },
        {
          "sceneIndex": 2,
          "from": 908,
          "durationFrames": 386,
          "motionFrames": 356,
          "cues": [
            {
              "from": 15,
              "duration": 208,
              "text": "Thử tiếp chu kì 60 giây. Đường này giảm chậm hơn đường ứng với chu kì 40 giây."
            },
            {
              "from": 226,
              "duration": 136,
              "text": "Đặt hai đường cùng trục để so sánh tại cùng một thời điểm."
            }
          ]
        },
        {
          "sceneIndex": 3,
          "from": 1294,
          "durationFrames": 580,
          "motionFrames": 64,
          "cues": [
            {
              "from": 15,
              "duration": 359,
              "text": "Tại 30 giây, hai dự báo khoảng 89,8 và 106,8 Bq. Số liệu SGK tại đó là 85 Bq."
            },
            {
              "from": 377,
              "duration": 179,
              "text": "Nội suy tuyến tính giữa hai điểm kẹp mức nửa cho khoảng 39,5 giây."
            }
          ]
        },
        {
          "sceneIndex": 4,
          "from": 1874,
          "durationFrames": 413,
          "motionFrames": 64,
          "cues": [
            {
              "from": 15,
              "duration": 153,
              "text": "Em hãy giải thích vì sao đường lí thuyết có thể lệch khỏi số liệu trong bảng."
            },
            {
              "from": 171,
              "duration": 218,
              "text": "Khi nộp bài, ghi rõ cách ước lượng chu kì và tách kết quả ấy khỏi hai giả thuyết đã thử."
            }
          ]
