  "B24": {
    "mp4Sha256": "ac60f3904431fda14c25f3fdef0afd4702613f2d74236e4ee7e882f3d3c7c3f4",
    "mp4Bytes": 3879423,
    "mediaPath": "public/videos/nuclear-lessons/b24.mp4",
    "metadata": {
      "codec": "h264",
      "width": 1920,
      "height": 1080,
      "fps": 30,
      "frames": 2159,
      "seconds": 71.966667,
      "bytes": 3879423,
      "renderedMotionFrames": 1122,
      "capturedFrames": 1131,
      "audio": {
        "codec": "aac",
        "sampleRate": 48000,
        "channels": 1,
        "startSeconds": 0,
        "durationSeconds": 71.966
      },
      "scenes": [
        {
          "sceneIndex": 0,
          "from": 0,
          "durationFrames": 394,
          "motionFrames": 64,
          "cues": [
            {
              "from": 15,
              "duration": 182,
              "text": "Thanh điều khiển hấp thụ neutron. Ta chọn ba mức cắm khác nhau trong mô hình."
            },
            {
              "from": 200,
              "duration": 170,
              "text": "Thang phần trăm là quy ước. Không suy vị trí vận hành lò thật từ thang này."
            }
          ]
        },
        {
          "sceneIndex": 1,
          "from": 394,
          "durationFrames": 367,
          "motionFrames": 337,
          "cues": [
            {
              "from": 15,
              "duration": 203,
              "text": "Rút thanh ở mức quy ước bằng không. Chỉ số bắt đầu ở 1 và tăng theo các thế hệ."
            },
            {
              "from": 221,
              "duration": 122,
              "text": "Trong lượt này, hệ số nhân k lớn hơn 1."
            }
          ]
        },
        {
          "sceneIndex": 2,
          "from": 761,
          "durationFrames": 484,
          "motionFrames": 234,
          "cues": [
            {
              "from": 15,
              "duration": 215,
              "text": "So sánh ba mức cắm. Hệ số nhân lần lượt là 1,4; 1 và 0,6."
            },
            {
              "from": 233,
              "duration": 227,
              "text": "Chỉ số ở thế hệ thứ tư cho thấy xu hướng tăng, giữ nguyên và giảm. Đây là mô hình định tính."
            }
          ]
        },
        {
          "sceneIndex": 3,
          "from": 1245,
          "durationFrames": 453,
          "motionFrames": 423,
          "cues": [
            {
              "from": 15,
              "duration": 220,
              "text": "Trong lò nước áp lực, vòng sơ cấp truyền nhiệt ở bộ sinh hơi. Hai dòng nước không trộn lẫn."
            },
            {
              "from": 238,
              "duration": 191,
              "text": "Hơi thứ cấp quay tua-bin kéo máy phát. Hơi sau tua-bin được làm nguội ở bình ngưng."
            }
          ]
        },
        {
          "sceneIndex": 4,
          "from": 1698,
          "durationFrames": 461,
          "motionFrames": 64,
          "cues": [
            {
              "from": 15,
              "duration": 213,
              "text": "Hãy phân biệt hai chức năng. Thanh điều khiển hấp thụ neutron. Bộ sinh hơi trao đổi nhiệt."
            },
            {
              "from": 231,
              "duration": 206,
              "text": "Trong ứng dụng khác, bức xạ còn hỗ trợ y học, sinh học và bảo quản thực phẩm."
            }
          ]
        }
      ]
    },
