  "B22": {
    "mp4Sha256": "3e76c5e71595a710b562298f2a500f80cc3b6075fb896bae641d1af06c5b5e66",
    "mp4Bytes": 3790638,
    "mediaPath": "public/videos/nuclear-lessons/b22.mp4",
    "metadata": {
      "codec": "h264",
      "width": 1920,
      "height": 1080,
      "fps": 30,
      "frames": 2256,
      "seconds": 75.2,
      "bytes": 3790638,
      "renderedMotionFrames": 485,
      "capturedFrames": 498,
      "audio": {
        "codec": "aac",
        "sampleRate": 48000,
        "channels": 1,
        "startSeconds": 0,
        "durationSeconds": 75.2
      },
      "scenes": [
        {
          "sceneIndex": 0,
          "from": 0,
          "durationFrames": 439,
          "motionFrames": 64,
          "cues": [
            {
              "from": 15,
              "duration": 146,
              "text": "Hạt nhân liên kết nhẹ hơn tổng khối lượng các nucleon tự do."
            },
            {
              "from": 164,
              "duration": 251,
              "text": "Lấy độ hụt khối nhân bình phương tốc độ ánh sáng. Chia tiếp cho số nucleon để tính năng lượng liên kết riêng."
            }
          ]
        },
        {
          "sceneIndex": 1,
          "from": 439,
          "durationFrames": 448,
          "motionFrames": 229,
          "cues": [
            {
              "from": 15,
              "duration": 210,
              "text": "Một neutron tới bị uranium-235 hấp thụ. Hạt nhân kích thích biến dạng rồi tách."
            },
            {
              "from": 228,
              "duration": 196,
              "text": "Kênh minh họa cho yttri-95, iốt-138 và 3 neutron."
            }
          ]
        },
        {
          "sceneIndex": 2,
          "from": 887,
          "durationFrames": 386,
          "motionFrames": 64,
          "cues": [
            {
              "from": 15,
              "duration": 172,
              "text": "Bây giờ giữ nguyên uranium-235, nhưng bỏ neutron tới."
            },
            {
              "from": 190,
              "duration": 172,
              "text": "Không có tác nhân kích phát, kênh phân hạch cảm ứng vừa xét chưa khởi phát."
            }
          ]
        },
        {
          "sceneIndex": 3,
          "from": 1273,
          "durationFrames": 518,
          "motionFrames": 64,
          "cues": [
            {
              "from": 15,
              "duration": 220,
              "text": "Mỗi vế có 236 nucleon và tổng điện tích bằng 92 lần điện tích nguyên tố."
            },
            {
              "from": 238,
              "duration": 256,
              "text": "Khối lượng giảm. Từ chênh lệch khối lượng, kênh này tỏa xấp xỉ 178 MeV."
            }
          ]
        },
        {
          "sceneIndex": 4,
          "from": 1791,
          "durationFrames": 465,
          "motionFrames": 64,
          "cues": [
            {
              "from": 15,
              "duration": 198,
              "text": "Trong phản ứng tổng hợp, đơteri và triti tạo helium-4 và một neutron."
            },
            {
              "from": 216,
              "duration": 225,
              "text": "Em hãy kiểm tra: mỗi vế có 5 nucleon và tổng điện tích bằng 2 lần điện tích nguyên tố."
            }
          ]
        }
      ]
    },
