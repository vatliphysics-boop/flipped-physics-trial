[{"id": "sgk-kntt-nuclear-001", "kind": "written", "topic": "B21", "chapter": "Vật lí hạt nhân", "level": "Thông hiểu", "prompt": "Các nhà khoa học đã làm thế nào để phát hiện hạt nhân có kích thước nhỏ hơn nhiều so với nguyên tử, dù không thể quan sát bằng kính hiển vi quang học?", "explanation": "Dùng thí nghiệm tán xạ hạt alpha qua lá vàng; kết hợp đa số hạt đi gần thẳng và số ít lệch mạnh để suy ra vùng điện tích dương tập trung rất nhỏ.", "points": 1, "source": {"book": "Sách giáo khoa Vật lí 12 · Kết nối tri thức", "bookId": "sgk-kntt", "sequence": 1, "label": "Câu 1 · Khởi động tr. 91", "pages": [93], "printedPages": [91]}, "bloom": {"level": "understand", "rationale": "Giải thích hoặc diễn giải mối quan hệ vật lí từ kiến thức đã học.", "review": "reviewed"}, "status": "ready", "notes": ["Phần dẫn đối chiếu trực quan bản mẫu SGK tháng 1/2024; lời giải do người biên soạn xây dựng, không phải đáp án chính thức của nhà xuất bản.", "Nhãn Bloom là phân loại nội bộ theo yêu cầu trả lời; chưa thẩm định độc lập."], "figure": {"url": "/api/book-bank/asset?file=sgk-kntt%2Fverified-figures%2Fhinh-21-2.png", "description": "Hình 21.2. Bố trí thí nghiệm tán xạ hạt alpha", "origin": "source_crop"}}, {"id": "sgk-kntt-nuclear-002", "kind": "written", "topic": "B21", "chapter": "Vật lí hạt nhân", "level": "Thông hiểu", "prompt": "Dựa vào thí nghiệm tán xạ hạt alpha: tần suất đốm sáng lớn nhất tại vị trí (1), đối diện nguồn phát trong Hình 21.2b, chứng tỏ điều gì?", "explanation": "Đa số hạt alpha đi qua lá vàng gần như thẳng; phần lớn thể tích nguyên tử là khoảng trống.", "points": 1, "source": {"book": "Sách giáo khoa Vật lí 12 · Kết nối tri thức", "bookId": "sgk-kntt", "sequence": 2, "label": "Câu 2 · Hoạt động 1a tr. 92", "pages": [94], "printedPages": [92]}, "bloom": {"level": "understand", "rationale": "Giải thích hoặc diễn giải mối quan hệ vật lí từ kiến thức đã học.", "review": "reviewed"}, "status": "ready", "notes": ["Phần dẫn đối chiếu trực quan bản mẫu SGK tháng 1/2024; lời giải do người biên soạn xây dựng, không phải đáp án chính thức của nhà xuất bản.", "Nhãn Bloom là phân loại nội bộ theo yêu cầu trả lời; chưa thẩm định độc lập."], "figure": {"url": "/api/book-bank/asset?file=sgk-kntt%2Fverified-figures%2Fhinh-21-2.png", "description": "Hình 21.2. Bố trí thí nghiệm tán xạ hạt alpha", "origin": "source_crop"}}, {"id": "sgk-kntt-nuclear-003", "kind": "written", "topic": "B21", "chapter": "Vật lí hạt nhân", "level": "Thông hiểu", "prompt": "Tại sao có một số hạt alpha đổi hướng chuyển động khi đi qua lá vàng?", "explanation": "Hạt alpha mang điện dương chịu lực đẩy tĩnh điện khi đi gần hạt nhân vàng mang điện dương.", "points": 1, "source": {"book": "Sách giáo khoa Vật lí 12 · Kết nối tri thức", "bookId": "sgk-kntt", "sequence": 3, "label": "Câu 3 · Hoạt động 1b tr. 92", "pages": [94], "printedPages": [92]}, "bloom": {"level": "understand", "rationale": "Giải thích hoặc diễn giải mối quan hệ vật lí từ kiến thức đã học.", "review": "reviewed"}, "status": "ready", "notes": ["Phần dẫn đối chiếu trực quan bản mẫu SGK tháng 1/2024; lời giải do người biên soạn xây dựng, không phải đáp án chính thức của nhà xuất bản.", "Nhãn Bloom là phân loại nội bộ theo yêu cầu trả lời; chưa thẩm định độc lập."], "figure": {"url": "/api/book-bank/asset?file=sgk-kntt%2Fverified-figures%2Fhinh-21-2.png", "description": "Hình 21.2. Bố trí thí nghiệm tán xạ hạt alpha", "origin": "source_crop"}}, {"id": "sgk-kntt-nuclear-004", "kind": "written", "topic": "B21", "chapter": "Vật lí hạt nhân", "level": "Thông hiểu", "prompt": "Tần suất hạt alpha bật lại tới vị trí (2) chỉ bằng $10^{-4}$ lần tần suất hạt đi qua tới vị trí (1). Kết quả đó chứng tỏ điều gì?", "explanation": "Điện tích dương và phần lớn khối lượng nguyên tử tập trung trong hạt nhân rất nhỏ; chỉ rất ít hạt đi đủ gần hạt nhân để bị lệch góc lớn.", "points": 1, "source": {"book": "Sách giáo khoa Vật lí 12 · Kết nối tri thức", "bookId": "sgk-kntt", "sequence": 4, "label": "Câu 4 · Hoạt động 1c tr. 92", "pages": [94], "printedPages": [92]}, "bloom": {"level": "understand", "rationale": "Giải thích hoặc diễn giải mối quan hệ vật lí từ kiến thức đã học.", "review": "reviewed"}, "status": "ready", "notes": ["Phần dẫn đối chiếu trực quan bản mẫu SGK tháng 1/2024; lời giải do người biên soạn xây dựng, không phải đáp án chính thức của nhà xuất bản.", "Nhãn Bloom là phân loại nội bộ theo yêu cầu trả lời; chưa thẩm định độc lập."], "figure": {"url": "/api/book-bank/asset?file=sgk-kntt%2Fverified-figures%2Fhinh-21-2.png", "description": "Hình 21.2. Bố trí thí nghiệm tán xạ hạt alpha", "origin": "source_crop"}}, {"id": "sgk-kntt-nuclear-005", "kind": "written", "topic": "B21", "chapter": "Vật lí hạt nhân", "level": "Nhận biết", "prompt": "Mô tả mô hình hành tinh nguyên tử của Rutherford trong Hình 21.5a.", "explanation": "Hạt nhân rất nhỏ, mang điện dương ở tâm; electron chuyển động xung quanh, phần lớn thể tích nguyên tử là khoảng trống.", "points": 1, "source": {"book": "Sách giáo khoa Vật lí 12 · Kết nối tri thức", "bookId": "sgk-kntt", "sequence": 5, "label": "Câu 5 · Hoạt động 2a tr. 92", "pages": [94], "printedPages": [92]}, "bloom": {"level": "remember", "rationale": "Nhắc lại các thành phần của mô hình đã giới thiệu.", "review": "reviewed"}, "status": "ready", "notes": ["Phần dẫn đối chiếu trực quan bản mẫu SGK tháng 1/2024; lời giải do người biên soạn xây dựng, không phải đáp án chính thức của nhà xuất bản.", "Nhãn Bloom là phân loại nội bộ theo yêu cầu trả lời; chưa thẩm định độc lập."], "figure": {"url": "/api/book-bank/asset?file=sgk-kntt%2Fverified-figures%2Fhinh-21-5.png", "description": "Hình 21.5. Một số mô hình nguyên tử", "origin": "source_crop"}}, {"id": "sgk-kntt-nuclear-006", "kind": "written", "topic": "B21", "chapter": "Vật lí hạt nhân", "level": "Vận dụng", "prompt": "Giải thích mô hình cấu tạo nguyên tử của Rutherford dựa vào kết quả tán xạ ở các ý 1a, 1b, 1c.", "explanation": "Liên hệ hạt đi thẳng với khoảng trống; hạt lệch mạnh với lực đẩy của vùng điện tích dương tập trung; hạt bật ngược hiếm với kích thước hạt nhân rất nhỏ.", "points": 1, "source": {"book": "Sách giáo khoa Vật lí 12 · Kết nối tri thức", "bookId": "sgk-kntt", "sequence": 6, "label": "Câu 6 · Hoạt động 2b tr. 92", "pages": [94], "printedPages": [92]}, "bloom": {"level": "analyze", "rationale": "Phân tách ba bằng chứng và nối mỗi bằng chứng với một đặc điểm cấu trúc.", "review": "reviewed"}, "status": "ready", "notes": ["Phần dẫn đối chiếu trực quan bản mẫu SGK tháng 1/2024; lời giải do người biên soạn xây dựng, không phải đáp án chính thức của nhà xuất bản.", "Nhãn Bloom là phân loại nội bộ theo yêu cầu trả lời; chưa thẩm định độc lập."], "figure": {"url": "/api/book-bank/asset?file=sgk-kntt%2Fverified-figures%2Fhinh-21-2.png", "description": "Hình 21.2. Bố trí thí nghiệm tán xạ hạt alpha", "origin": "source_crop"}}, {"id": "sgk-kntt-nuclear-007", "kind": "written", "topic": "B21", "chapter": "Vật lí hạt nhân", "level": "Vận dụng", "prompt": "Xác định khối lượng proton và neutron theo đơn vị amu. Dữ kiện cùng trang: $m_p=1{,}67262\\times10^{-27}$ kg; $m_n=1{,}67493\\times10^{-27}$ kg; $1\\ \\mathrm{amu}=1{,}66054\\times10^{-27}$ kg.", "explanation": "$m_p\\approx1{,}00728$ amu; $m_n\\approx1{,}00866$ amu. Chia mỗi khối lượng theo kg cho khối lượng ứng với 1 amu.", "points": 1, "source": {"book": "Sách giáo khoa Vật lí 12 · Kết nối tri thức", "bookId": "sgk-kntt", "sequence": 7, "label": "Câu 7 · Câu hỏi tr. 93", "pages": [95], "printedPages": [93]}, "bloom": {"level": "apply", "rationale": "Thực hiện phép đổi đơn vị bằng số liệu đã cho.", "review": "reviewed"}, "status": "ready", "notes": ["Phần dẫn đối chiếu trực quan bản mẫu SGK tháng 1/2024; lời giải do người biên soạn xây dựng, không phải đáp án chính thức của nhà xuất bản.", "Nhãn Bloom là phân loại nội bộ theo yêu cầu trả lời; chưa thẩm định độc lập."]}, {"id": "sgk-kntt-nuclear-009", "kind": "written", "topic": "B21", "chapter": "Vật lí hạt nhân", "level": "Thông hiểu", "prompt": "Trong kí hiệu hạt nhân, đại lượng $N=A-Z$ cho biết số lượng loại hạt nào? Vì sao?", "explanation": "N là số neutron, vì A là tổng proton và neutron còn Z là số proton.", "points": 1, "source": {"book": "Sách giáo khoa Vật lí 12 · Kết nối tri thức", "bookId": "sgk-kntt", "sequence": 9, "label": "Câu 9 · Câu hỏi 1 tr. 95", "pages": [97], "printedPages": [95]}, "bloom": {"level": "understand", "rationale": "Giải thích hoặc diễn giải mối quan hệ vật lí từ kiến thức đã học.", "review": "reviewed"}, "status": "ready", "notes": ["Phần dẫn đối chiếu trực quan bản mẫu SGK tháng 1/2024; lời giải do người biên soạn xây dựng, không phải đáp án chính thức của nhà xuất bản.", "Nhãn Bloom là phân loại nội bộ theo yêu cầu trả lời; chưa thẩm định độc lập."]}, {"id": "sgk-kntt-nuclear-010", "kind": "written", "topic": "B21", "chapter": "Vật lí hạt nhân", "level": "Thông hiểu", "prompt": "Bằng cách nào có thể tìm số Z và số N của hạt nhân có kí hiệu dạng ${}^{A}\\mathrm{X}$?", "explanation": "Tra số hiệu nguyên tử Z của nguyên tố X trong bảng tuần hoàn; lấy N=A−Z.", "points": 1, "source": {"book": "Sách giáo khoa Vật lí 12 · Kết nối tri thức", "bookId": "sgk-kntt", "sequence": 10, "label": "Câu 10 · Câu hỏi 2 tr. 95", "pages": [97], "printedPages": [95]}, "bloom": {"level": "understand", "rationale": "Giải thích hoặc diễn giải mối quan hệ vật lí từ kiến thức đã học.", "review": "reviewed"}, "status": "ready", "notes": ["Phần dẫn đối chiếu trực quan bản mẫu SGK tháng 1/2024; lời giải do người biên soạn xây dựng, không phải đáp án chính thức của nhà xuất bản.", "Nhãn Bloom là phân loại nội bộ theo yêu cầu trả lời; chưa thẩm định độc lập."]}, {"id": "sgk-kntt-nuclear-011", "kind": "written", "topic": "B21", "chapter": "Vật lí hạt nhân", "level": "Vận dụng", "prompt": "Viết kí hiệu hạt nhân vàng (Au), helium (He), nitrogen (N), biết số nucleon lần lượt là 197; 4; 14.", "explanation": "${}^{197}_{79}\\mathrm{Au}$; ${}^{4}_{2}\\mathrm{He}$; ${}^{14}_{7}\\mathrm{N}$. Dùng bảng tuần hoàn để xác định Z.", "points": 1, "source": {"book": "Sách giáo khoa Vật lí 12 · Kết nối tri thức", "bookId": "sgk-kntt", "sequence": 11, "label": "Câu 11 · Câu hỏi 3 tr. 95", "pages": [97], "printedPages": [95]}, "bloom": {"level": "apply", "rationale": "Sử dụng số khối đã cho và bảng tuần hoàn để lập kí hiệu hạt nhân.", "review": "reviewed"}, "status": "ready", "notes": ["Phần dẫn đối chiếu trực quan bản mẫu SGK tháng 1/2024; lời giải do người biên soạn xây dựng, không phải đáp án chính thức của nhà xuất bản.", "Nhãn Bloom là phân loại nội bộ theo yêu cầu trả lời; chưa thẩm định độc lập."]}, {"id": "sgk-kntt-nuclear-012", "kind": "written", "topic": "B21", "chapter": "Vật lí hạt nhân", "level": "Thông hiểu", "prompt": "Giải thích tại sao các chất cấu tạo từ cùng một loại nguyên tố nhưng khối lượng riêng vẫn có thể khác nhau.", "explanation": "Các đồng vị cùng Z nhưng khác N nên khối lượng nguyên tử khác nhau. Ngoài thành phần đồng vị, khối lượng riêng còn phụ thuộc cấu trúc và trạng thái vật chất; chỉ so sánh do đồng vị khi các điều kiện khác tương đương.", "points": 1, "source": {"book": "Sách giáo khoa Vật lí 12 · Kết nối tri thức", "bookId": "sgk-kntt", "sequence": 12, "label": "Câu 12 · Câu hỏi đồng vị tr. 95", "pages": [97], "printedPages": [95]}, "bloom": {"level": "understand", "rationale": "Giải thích hoặc diễn giải mối quan hệ vật lí từ kiến thức đã học.", "review": "reviewed"}, "status": "ready", "notes": ["Phần dẫn đối chiếu trực quan bản mẫu SGK tháng 1/2024; lời giải do người biên soạn xây dựng, không phải đáp án chính thức của nhà xuất bản.", "Nhãn Bloom là phân loại nội bộ theo yêu cầu trả lời; chưa thẩm định độc lập."]}, {"id": "sgk-kntt-nuclear-013", "kind": "written", "topic": "B22", "chapter": "Vật lí hạt nhân", "level": "Thông hiểu", "prompt": "Người ta đã thực hiện thí nghiệm phát hiện phản ứng hạt nhân như thế nào? Các hạt nhân có thể biến đổi thành các hạt nhân khác không?", "explanation": "Bắn hạt alpha vào nitrogen; vết tương tác trong buồng sương cho bằng chứng tạo oxygen và proton. Phản ứng minh họa: ${}^{4}_{2}\\mathrm{He}+{}^{14}_{7}\\mathrm{N}\\to{}^{17}_{8}\\mathrm{O}+{}^{1}_{1}\\mathrm{H}$.", "points": 1, "source": {"book": "Sách giáo khoa Vật lí 12 · Kết nối tri thức", "bookId": "sgk-kntt", "sequence": 13, "label": "Câu 13 · Khởi động tr. 96", "pages": [98], "printedPages": [96]}, "bloom": {"level": "understand", "rationale": "Giải thích hoặc diễn giải mối quan hệ vật lí từ kiến thức đã học.", "review": "reviewed"}, "status": "ready", "notes": ["Phần dẫn đối chiếu trực quan bản mẫu SGK tháng 1/2024; lời giải do người biên soạn xây dựng, không phải đáp án chính thức của nhà xuất bản.", "Nhãn Bloom là phân loại nội bộ theo yêu cầu trả lời; chưa thẩm định độc lập."], "figure": {"url": "/api/book-bank/asset?file=sgk-kntt%2Fverified-figures%2Fhinh-22-2.png", "description": "Hình 22.2. Ảnh kết quả thí nghiệm của Blackett", "origin": "source_crop"}}, {"id": "sgk-kntt-nuclear-014", "kind": "written", "topic": "B22", "chapter": "Vật lí hạt nhân", "level": "Vận dụng", "prompt": "So sánh tổng điện tích và tổng số nucleon của các hạt nhân trước và sau tương tác trong Hình 22.2.", "explanation": "Trước: Z=2+7=9, A=4+14=18. Sau: Z=8+1=9, A=17+1=18. Hai tổng được bảo toàn.", "points": 1, "source": {"book": "Sách giáo khoa Vật lí 12 · Kết nối tri thức", "bookId": "sgk-kntt", "sequence": 14, "label": "Câu 14 · Hoạt động tr. 97", "pages": [99], "printedPages": [97]}, "bloom": {"level": "apply", "rationale": "Đọc kí hiệu trong hình và tính hai tổng ở mỗi vế.", "review": "reviewed"}, "status": "ready", "notes": ["Phần dẫn đối chiếu trực quan bản mẫu SGK tháng 1/2024; lời giải do người biên soạn xây dựng, không phải đáp án chính thức của nhà xuất bản.", "Nhãn Bloom là phân loại nội bộ theo yêu cầu trả lời; chưa thẩm định độc lập."], "figure": {"url": "/api/book-bank/asset?file=sgk-kntt%2Fverified-figures%2Fhinh-22-2.png", "description": "Hình 22.2. Ảnh kết quả thí nghiệm của Blackett", "origin": "source_crop"}}, {"id": "sgk-kntt-nuclear-015", "kind": "written", "topic": "B22", "chapter": "Vật lí hạt nhân", "level": "Thông hiểu", "prompt": "Trình bày sự khác nhau giữa phản ứng hạt nhân và phản ứng hóa học.", "explanation": "Phản ứng hạt nhân thay đổi cấu tạo hạt nhân và có thể biến đổi nguyên tố; phản ứng hóa học chủ yếu sắp xếp electron/liên kết, hạt nhân nguyên tử giữ nguyên.", "points": 1, "source": {"book": "Sách giáo khoa Vật lí 12 · Kết nối tri thức", "bookId": "sgk-kntt", "sequence": 15, "label": "Câu 15 · Câu hỏi tr. 97", "pages": [99], "printedPages": [97]}, "bloom": {"level": "understand", "rationale": "Giải thích hoặc diễn giải mối quan hệ vật lí từ kiến thức đã học.", "review": "reviewed"}, "status": "ready", "notes": ["Phần dẫn đối chiếu trực quan bản mẫu SGK tháng 1/2024; lời giải do người biên soạn xây dựng, không phải đáp án chính thức của nhà xuất bản.", "Nhãn Bloom là phân loại nội bộ theo yêu cầu trả lời; chưa thẩm định độc lập."]}, {"id": "sgk-kntt-nuclear-016", "kind": "written", "topic": "B22", "chapter": "Vật lí hạt nhân", "level": "Vận dụng", "prompt": "Viết biểu thức liên hệ số khối và điện tích trong phản ứng ${}^{A_1}_{Z_1}\\mathrm{X}_1+{}^{A_2}_{Z_2}\\mathrm{X}_2\\to{}^{A_3}_{Z_3}\\mathrm{X}_3+{}^{A_4}_{Z_4}\\mathrm{X}_4$.", "explanation": "$A_1+A_2=A_3+A_4$; $Z_1+Z_2=Z_3+Z_4$.", "points": 1, "source": {"book": "Sách giáo khoa Vật lí 12 · Kết nối tri thức", "bookId": "sgk-kntt", "sequence": 16, "label": "Câu 16 · Hoạt động 1 tr. 97", "pages": [99], "printedPages": [97]}, "bloom": {"level": "apply", "rationale": "Áp dụng hai định luật bảo toàn vào phản ứng được cho.", "review": "reviewed"}, "status": "ready", "notes": ["Phần dẫn đối chiếu trực quan bản mẫu SGK tháng 1/2024; lời giải do người biên soạn xây dựng, không phải đáp án chính thức của nhà xuất bản.", "Nhãn Bloom là phân loại nội bộ theo yêu cầu trả lời; chưa thẩm định độc lập."]}, {"id": "sgk-kntt-nuclear-017", "kind": "written", "topic": "B22", "chapter": "Vật lí hạt nhân", "level": "Vận dụng", "prompt": "Khi ${}^{235}_{92}\\mathrm{U}$ hấp thụ neutron, tạo hạt nhân X rồi phân rã thành ${}^{99}_{42}\\mathrm{Mo}$, ba neutron và hạt nhân Y. a) Viết các phương trình. b) Dùng bảng tuần hoàn xác định X, Y.", "explanation": "${}^{235}_{92}\\mathrm{U}+{}^{1}_{0}\\mathrm{n}\\to{}^{236}_{92}\\mathrm{U}^{*}$; ${}^{236}_{92}\\mathrm{U}^{*}\\to{}^{99}_{42}\\mathrm{Mo}+{}^{134}_{50}\\mathrm{Sn}+3{}^{1}_{0}\\mathrm{n}$. X là uranium-236 kích thích, Y là tin-134.", "points": 1, "source": {"book": "Sách giáo khoa Vật lí 12 · Kết nối tri thức", "bookId": "sgk-kntt", "sequence": 17, "label": "Câu 17 · Hoạt động 2 tr. 97", "pages": [99], "printedPages": [97]}, "bloom": {"level": "apply", "rationale": "Tính A, Z chưa biết theo bảo toàn, rồi tra tên nguyên tố.", "review": "reviewed"}, "status": "ready", "notes": ["Phần dẫn đối chiếu trực quan bản mẫu SGK tháng 1/2024; lời giải do người biên soạn xây dựng, không phải đáp án chính thức của nhà xuất bản.", "Nhãn Bloom là phân loại nội bộ theo yêu cầu trả lời; chưa thẩm định độc lập."]}, {"id": "sgk-kntt-nuclear-018", "kind": "written", "topic": "B22", "chapter": "Vật lí hạt nhân", "level": "Thông hiểu", "prompt": "Vì sao tách các nucleon ra khỏi hạt nhân cần một năng lượng lớn?", "explanation": "Phải cung cấp năng lượng để thắng liên kết do tương tác hạt nhân mạnh giữa các nucleon.", "points": 1, "source": {"book": "Sách giáo khoa Vật lí 12 · Kết nối tri thức", "bookId": "sgk-kntt", "sequence": 18, "label": "Câu 18 · Câu hỏi tr. 98", "pages": [100], "printedPages": [98]}, "bloom": {"level": "understand", "rationale": "Giải thích hoặc diễn giải mối quan hệ vật lí từ kiến thức đã học.", "review": "reviewed"}, "status": "ready", "notes": ["Phần dẫn đối chiếu trực quan bản mẫu SGK tháng 1/2024; lời giải do người biên soạn xây dựng, không phải đáp án chính thức của nhà xuất bản.", "Nhãn Bloom là phân loại nội bộ theo yêu cầu trả lời; chưa thẩm định độc lập."]}, {"id": "sgk-kntt-nuclear-019", "kind": "written", "topic": "B22", "chapter": "Vật lí hạt nhân", "level": "Thông hiểu", "prompt": "Nêu mối liên hệ giữa độ bền vững của hạt nhân và năng lượng liên kết riêng.", "explanation": "Năng lượng liên kết riêng lớn biểu thị nucleon được liên kết chặt hơn theo cách so sánh ở SGK. Độ bền đối với từng kênh phân rã còn phụ thuộc cấu trúc và điều kiện năng lượng, không chỉ một đại lượng E/A.", "points": 1, "source": {"book": "Sách giáo khoa Vật lí 12 · Kết nối tri thức", "bookId": "sgk-kntt", "sequence": 19, "label": "Câu 19 · Hoạt động 1 tr. 98", "pages": [100], "printedPages": [98]}, "bloom": {"level": "understand", "rationale": "Giải thích hoặc diễn giải mối quan hệ vật lí từ kiến thức đã học.", "review": "reviewed"}, "status": "ready", "notes": ["Phần dẫn đối chiếu trực quan bản mẫu SGK tháng 1/2024; lời giải do người biên soạn xây dựng, không phải đáp án chính thức của nhà xuất bản.", "Nhãn Bloom là phân loại nội bộ theo yêu cầu trả lời; chưa thẩm định độc lập."]}, {"id": "sgk-kntt-nuclear-020", "kind": "written", "topic": "B22", "chapter": "Vật lí hạt nhân", "level": "Thông hiểu", "prompt": "Từ Hình 22.3, chỉ ra hai hạt nhân bền vững nhất và ước lượng năng lượng liên kết riêng của chúng.", "explanation": "Trong các điểm được gắn nhãn trên hình, ${}^{56}\\mathrm{Fe}$ và ${}^{89}\\mathrm{Y}$ gần đỉnh; khoảng 8,8 MeV/nuclon. Đây là ước lượng từ đồ thị SGK, không phải khẳng định hai đồng vị bền nhất trong toàn bộ bảng nuclide.", "points": 1, "source": {"book": "Sách giáo khoa Vật lí 12 · Kết nối tri thức", "bookId": "sgk-kntt", "sequence": 20, "label": "Câu 20 · Hoạt động 2a tr. 98", "pages": [100], "printedPages": [98]}, "bloom": {"level": "understand", "rationale": "Diễn giải điểm cực đại của đồ thị trong phạm vi các điểm được biểu diễn.", "review": "reviewed"}, "status": "ready", "notes": ["Phần dẫn đối chiếu trực quan bản mẫu SGK tháng 1/2024; lời giải do người biên soạn xây dựng, không phải đáp án chính thức của nhà xuất bản.", "Nhãn Bloom là phân loại nội bộ theo yêu cầu trả lời; chưa thẩm định độc lập."], "figure": {"url": "/api/book-bank/asset?file=sgk-kntt%2Fverified-figures%2Fhinh-22-3.png", "description": "Hình 22.3. Năng lượng liên kết riêng theo số khối", "origin": "source_crop"}}, {"id": "sgk-kntt-nuclear-021", "kind": "written", "topic": "B22", "chapter": "Vật lí hạt nhân", "level": "Vận dụng", "prompt": "Từ Hình 22.3, xác định năm hạt nhân nhẹ ($A\\le30$) và bốn hạt nhân nặng ($A\\ge160$) có năng lượng liên kết riêng nhỏ hơn 8,2 MeV.", "explanation": "Nhẹ: ${}^{2}\\mathrm{H}$, ${}^{4}\\mathrm{He}$, ${}^{6}\\mathrm{Li}$, ${}^{9}\\mathrm{Be}$, ${}^{11}\\mathrm{B}$. Nặng: ${}^{160}\\mathrm{Dy}$, ${}^{197}\\mathrm{Au}$, ${}^{209}\\mathrm{Bi}$, ${}^{238}\\mathrm{U}$. Đọc theo các điểm được gắn nhãn, có sai số ước lượng.", "points": 1, "source": {"book": "Sách giáo khoa Vật lí 12 · Kết nối tri thức", "bookId": "sgk-kntt", "sequence": 21, "label": "Câu 21 · Hoạt động 2b tr. 98", "pages": [100], "printedPages": [98]}, "bloom": {"level": "analyze", "rationale": "Lọc các điểm theo đồng thời miền số khối và ngưỡng năng lượng.", "review": "reviewed"}, "status": "ready", "notes": ["Phần dẫn đối chiếu trực quan bản mẫu SGK tháng 1/2024; lời giải do người biên soạn xây dựng, không phải đáp án chính thức của nhà xuất bản.", "Nhãn Bloom là phân loại nội bộ theo yêu cầu trả lời; chưa thẩm định độc lập."], "figure": {"url": "/api/book-bank/asset?file=sgk-kntt%2Fverified-figures%2Fhinh-22-3.png", "description": "Hình 22.3. Năng lượng liên kết riêng theo số khối", "origin": "source_crop"}}, {"id": "sgk-kntt-nuclear-022", "kind": "written", "topic": "B22", "chapter": "Vật lí hạt nhân", "level": "Vận dụng", "prompt": "Tính độ hụt khối hạt nhân ${}^{16}_{8}\\mathrm{O}$, biết khối lượng hạt nhân là 15,99492 amu. Dùng $m_p=1{,}00728$ amu, $m_n=1{,}00866$ amu từ bài.", "explanation": "$\\Delta m=8m_p+8m_n-m_O=0{,}13260$ amu. Giá trị khối lượng ở bản mẫu cần đối chiếu cách dùng khối lượng hạt nhân/nguyên tử; đáp số này theo đúng dữ kiện đã cho.", "points": 1, "source": {"book": "Sách giáo khoa Vật lí 12 · Kết nối tri thức", "bookId": "sgk-kntt", "sequence": 22, "label": "Câu 22 · Câu hỏi tr. 99", "pages": [101], "printedPages": [99]}, "bloom": {"level": "apply", "rationale": "Thay Z, N và khối lượng vào công thức độ hụt khối.", "review": "reviewed"}, "status": "ready", "notes": ["Phần dẫn đối chiếu trực quan bản mẫu SGK tháng 1/2024; lời giải do người biên soạn xây dựng, không phải đáp án chính thức của nhà xuất bản.", "Nhãn Bloom là phân loại nội bộ theo yêu cầu trả lời; chưa thẩm định độc lập."]}, {"id": "sgk-kntt-nuclear-023", "kind": "written", "topic": "B22", "chapter": "Vật lí hạt nhân", "level": "Vận dụng", "prompt": "Tính năng lượng liên kết và năng lượng liên kết riêng của ${}^{4}_{2}\\mathrm{He}$. Dữ kiện cùng bài: khối lượng hạt nhân 4,00015 amu, $m_p=1{,}00728$ amu, $m_n=1{,}00866$ amu; $1\\ \\mathrm{amu}\\,c^2=931{,}5$ MeV.", "explanation": "$\\Delta m=0{,}03173$ amu; $E_{lk}\\approx29{,}557$ MeV; $E_{lk}/A\\approx7{,}389$ MeV/nuclon, theo số liệu đã cho.", "points": 1, "source": {"book": "Sách giáo khoa Vật lí 12 · Kết nối tri thức", "bookId": "sgk-kntt", "sequence": 23, "label": "Câu 23 · Hoạt động a tr. 100", "pages": [102], "printedPages": [100]}, "bloom": {"level": "apply", "rationale": "Dùng độ hụt khối, rồi đổi sang năng lượng và chia cho số nucleon.", "review": "reviewed"}, "status": "ready", "notes": ["Phần dẫn đối chiếu trực quan bản mẫu SGK tháng 1/2024; lời giải do người biên soạn xây dựng, không phải đáp án chính thức của nhà xuất bản.", "Nhãn Bloom là phân loại nội bộ theo yêu cầu trả lời; chưa thẩm định độc lập."]}, {"id": "sgk-kntt-nuclear-024", "kind": "written", "topic": "B22", "chapter": "Vật lí hạt nhân", "level": "Vận dụng", "prompt": "Tìm hệ số chuyển đổi giữa amu và $\\mathrm{MeV}/c^2$. Dùng $1\\ \\mathrm{amu}=1{,}66054\\times10^{-27}$ kg, $c\\approx3{,}00\\times10^8$ m/s và $1\\ \\mathrm{MeV}=1{,}60218\\times10^{-13}$ J.", "explanation": "$1\\ \\mathrm{amu}\\approx932{,}8\\ \\mathrm{MeV}/c^2$ với c làm tròn như đề. Dùng c chính xác hơn cho hệ số chuẩn khoảng 931,5. Ghi rõ mức làm tròn sử dụng.", "points": 1, "source": {"book": "Sách giáo khoa Vật lí 12 · Kết nối tri thức", "bookId": "sgk-kntt", "sequence": 24, "label": "Câu 24 · Hoạt động b tr. 100", "pages": [102], "printedPages": [100]}, "bloom": {"level": "apply", "rationale": "Đổi khối lượng sang năng lượng bằng E=mc² rồi đổi J sang MeV.", "review": "reviewed"}, "status": "ready", "notes": ["Phần dẫn đối chiếu trực quan bản mẫu SGK tháng 1/2024; lời giải do người biên soạn xây dựng, không phải đáp án chính thức của nhà xuất bản.", "Nhãn Bloom là phân loại nội bộ theo yêu cầu trả lời; chưa thẩm định độc lập."]}, {"id": "sgk-kntt-nuclear-025", "kind": "written", "topic": "B22", "chapter": "Vật lí hạt nhân", "level": "Thông hiểu", "prompt": "Phân hạch hạt nhân là gì? Nêu đặc điểm phản ứng phân hạch uranium.", "explanation": "Một hạt nhân nặng bị tách thành các mảnh nhẹ hơn; uranium-235 hấp thụ neutron tạo uranium-236 kích thích rồi phân hạch, giải phóng neutron và năng lượng. Các nhánh sản phẩm có thể khác nhau.", "points": 1, "source": {"book": "Sách giáo khoa Vật lí 12 · Kết nối tri thức", "bookId": "sgk-kntt", "sequence": 25, "label": "Câu 25 · Hoạt động tr. 101", "pages": [103], "printedPages": [101]}, "bloom": {"level": "understand", "rationale": "Giải thích hoặc diễn giải mối quan hệ vật lí từ kiến thức đã học.", "review": "reviewed"}, "status": "ready", "notes": ["Phần dẫn đối chiếu trực quan bản mẫu SGK tháng 1/2024; lời giải do người biên soạn xây dựng, không phải đáp án chính thức của nhà xuất bản.", "Nhãn Bloom là phân loại nội bộ theo yêu cầu trả lời; chưa thẩm định độc lập."], "figure": {"url": "/api/book-bank/asset?file=sgk-kntt%2Fverified-figures%2Fhinh-22-6.png", "description": "Hình 22.6. Tiến trình phân hạch uranium-235", "origin": "source_crop"}}, {"id": "sgk-kntt-nuclear-026", "kind": "written", "topic": "B22", "chapter": "Vật lí hạt nhân", "level": "Thông hiểu", "prompt": "Nêu đặc điểm phản ứng phân hạch dây chuyền.", "explanation": "Neutron từ một lần phân hạch kích thích các lần phân hạch tiếp theo. Phản ứng duy trì khi trung bình đủ neutron gây phân hạch mới; có thể tắt, ổn định hoặc tăng tùy điều kiện.", "points": 1, "source": {"book": "Sách giáo khoa Vật lí 12 · Kết nối tri thức", "bookId": "sgk-kntt", "sequence": 26, "label": "Câu 26 · Câu hỏi 1 tr. 101", "pages": [103], "printedPages": [101]}, "bloom": {"level": "understand", "rationale": "Giải thích hoặc diễn giải mối quan hệ vật lí từ kiến thức đã học.", "review": "reviewed"}, "status": "ready", "notes": ["Phần dẫn đối chiếu trực quan bản mẫu SGK tháng 1/2024; lời giải do người biên soạn xây dựng, không phải đáp án chính thức của nhà xuất bản.", "Nhãn Bloom là phân loại nội bộ theo yêu cầu trả lời; chưa thẩm định độc lập."], "figure": {"url": "/api/book-bank/asset?file=sgk-kntt%2Fverified-figures%2Fhinh-22-7.png", "description": "Hình 22.7. Minh họa phản ứng phân hạch dây chuyền", "origin": "source_crop"}}, {"id": "sgk-kntt-nuclear-027", "kind": "written", "topic": "B22", "chapter": "Vật lí hạt nhân", "level": "Vận dụng", "prompt": "Tính năng lượng tỏa khi phân hạch hoàn toàn 1 kg ${}^{235}_{92}\\mathrm{U}$; mỗi phân hạch tỏa 200 MeV. Dùng $N_A=6{,}022\\times10^{23}\\ \\mathrm{mol}^{-1}$, $1\\ \\mathrm{MeV}=1{,}602\\times10^{-13}$ J.", "explanation": "$Q=(1000/235)N_A\\times200\\times1{,}602\\times10^{-13}\\approx8{,}21\\times10^{13}$ J.", "points": 1, "source": {"book": "Sách giáo khoa Vật lí 12 · Kết nối tri thức", "bookId": "sgk-kntt", "sequence": 27, "label": "Câu 27 · Câu hỏi 2 tr. 101", "pages": [103], "printedPages": [101]}, "bloom": {"level": "apply", "rationale": "Tính số hạt từ khối lượng và nhân năng lượng mỗi phân hạch.", "review": "reviewed"}, "status": "ready", "notes": ["Phần dẫn đối chiếu trực quan bản mẫu SGK tháng 1/2024; lời giải do người biên soạn xây dựng, không phải đáp án chính thức của nhà xuất bản.", "Nhãn Bloom là phân loại nội bộ theo yêu cầu trả lời; chưa thẩm định độc lập."]}, {"id": "sgk-kntt-nuclear-028", "kind": "written", "topic": "B22", "chapter": "Vật lí hạt nhân", "level": "Nhận biết", "prompt": "Tổng hợp hạt nhân là gì? Nêu điều kiện xảy ra phản ứng tổng hợp hạt nhân.", "explanation": "Các hạt nhân nhẹ kết hợp thành hạt nhân nặng hơn. Cần đủ năng lượng để vượt rào đẩy Coulomb; trong nhiệt hạch cần nhiệt độ, mật độ và thời gian duy trì phù hợp.", "points": 1, "source": {"book": "Sách giáo khoa Vật lí 12 · Kết nối tri thức", "bookId": "sgk-kntt", "sequence": 28, "label": "Câu 28 · Câu hỏi 1 tr. 103", "pages": [105], "printedPages": [103]}, "bloom": {"level": "remember", "rationale": "Nhắc lại định nghĩa và các điều kiện đã giới thiệu.", "review": "reviewed"}, "status": "ready", "notes": ["Phần dẫn đối chiếu trực quan bản mẫu SGK tháng 1/2024; lời giải do người biên soạn xây dựng, không phải đáp án chính thức của nhà xuất bản.", "Nhãn Bloom là phân loại nội bộ theo yêu cầu trả lời; chưa thẩm định độc lập."]}, {"id": "sgk-kntt-nuclear-029", "kind": "written", "topic": "B22", "chapter": "Vật lí hạt nhân", "level": "Thông hiểu", "prompt": "So sánh định tính tổng hợp hạt nhân và phân hạch về nhiên liệu và điều kiện xảy ra phản ứng.", "explanation": "Tổng hợp dùng các hạt nhân nhẹ, cần điều kiện đưa chúng đến đủ gần nhau; phân hạch dùng hạt nhân nặng, có thể được kích thích bằng neutron thích hợp. So sánh theo cùng hai tiêu chí.", "points": 1, "source": {"book": "Sách giáo khoa Vật lí 12 · Kết nối tri thức", "bookId": "sgk-kntt", "sequence": 29, "label": "Câu 29 · Câu hỏi 2 tr. 103", "pages": [105], "printedPages": [103]}, "bloom": {"level": "understand", "rationale": "Giải thích hoặc diễn giải mối quan hệ vật lí từ kiến thức đã học.", "review": "reviewed"}, "status": "ready", "notes": ["Phần dẫn đối chiếu trực quan bản mẫu SGK tháng 1/2024; lời giải do người biên soạn xây dựng, không phải đáp án chính thức của nhà xuất bản.", "Nhãn Bloom là phân loại nội bộ theo yêu cầu trả lời; chưa thẩm định độc lập."]}, {"id": "sgk-kntt-nuclear-030", "kind": "written", "topic": "B23", "chapter": "Vật lí hạt nhân", "level": "Thông hiểu", "prompt": "Trong thí nghiệm Becquerel, tấm phim có vết sáng dù mẫu uranium được để trong bóng tối. Nguyên nhân nào gây tác dụng lên phim?", "explanation": "Bức xạ phát ra tự phát từ chất chứa uranium tác động lên phim; hiện tượng không đòi hỏi mẫu được chiếu sáng trước.", "points": 1, "source": {"book": "Sách giáo khoa Vật lí 12 · Kết nối tri thức", "bookId": "sgk-kntt", "sequence": 30, "label": "Câu 30 · Khởi động tr. 104", "pages": [106], "printedPages": [104]}, "bloom": {"level": "understand", "rationale": "Giải thích hoặc diễn giải mối quan hệ vật lí từ kiến thức đã học.", "review": "reviewed"}, "status": "ready", "notes": ["Phần dẫn đối chiếu trực quan bản mẫu SGK tháng 1/2024; lời giải do người biên soạn xây dựng, không phải đáp án chính thức của nhà xuất bản.", "Nhãn Bloom là phân loại nội bộ theo yêu cầu trả lời; chưa thẩm định độc lập."]}, {"id": "sgk-kntt-nuclear-031", "kind": "written", "topic": "B23", "chapter": "Vật lí hạt nhân", "level": "Thông hiểu", "prompt": "Hiện tượng phóng xạ có tính tự phát hay phụ thuộc nhiệt độ, áp suất của môi trường?", "explanation": "Theo mô hình SGK, phân rã phóng xạ có tính tự phát, không bị điều khiển bởi thay đổi nhiệt độ, áp suất thông thường.", "points": 1, "source": {"book": "Sách giáo khoa Vật lí 12 · Kết nối tri thức", "bookId": "sgk-kntt", "sequence": 31, "label": "Câu 31 · Hoạt động 1 tr. 104", "pages": [106], "printedPages": [104]}, "bloom": {"level": "understand", "rationale": "Giải thích hoặc diễn giải mối quan hệ vật lí từ kiến thức đã học.", "review": "reviewed"}, "status": "ready", "notes": ["Phần dẫn đối chiếu trực quan bản mẫu SGK tháng 1/2024; lời giải do người biên soạn xây dựng, không phải đáp án chính thức của nhà xuất bản.", "Nhãn Bloom là phân loại nội bộ theo yêu cầu trả lời; chưa thẩm định độc lập."]}, {"id": "sgk-kntt-nuclear-032", "kind": "written", "topic": "B23", "chapter": "Vật lí hạt nhân", "level": "Thông hiểu", "prompt": "Có thể điều khiển hiện tượng phóng xạ không? Tại sao?", "explanation": "Không điều khiển thời điểm phân rã từng hạt nhân bằng điều kiện môi trường thông thường; có thể kiểm soát phơi nhiễm bằng che chắn, khoảng cách và thời gian.", "points": 1, "source": {"book": "Sách giáo khoa Vật lí 12 · Kết nối tri thức", "bookId": "sgk-kntt", "sequence": 32, "label": "Câu 32 · Hoạt động 2 tr. 104", "pages": [106], "printedPages": [104]}, "bloom": {"level": "understand", "rationale": "Giải thích hoặc diễn giải mối quan hệ vật lí từ kiến thức đã học.", "review": "reviewed"}, "status": "ready", "notes": ["Phần dẫn đối chiếu trực quan bản mẫu SGK tháng 1/2024; lời giải do người biên soạn xây dựng, không phải đáp án chính thức của nhà xuất bản.", "Nhãn Bloom là phân loại nội bộ theo yêu cầu trả lời; chưa thẩm định độc lập."]}, {"id": "sgk-kntt-nuclear-033", "kind": "written", "topic": "B23", "chapter": "Vật lí hạt nhân", "level": "Vận dụng", "prompt": "Bảng 23.1: các khoảng 0–5; 5–10; 10–15; 15–20; 20–25; 25–30 s có số tia ghi nhận lần lượt 1; 3; 2; 0; 3; 1. a) Nhận xét số lượng phân rã trong những khoảng bằng nhau. b) Có dự đoán chính xác thời điểm và số lượng phân rã từng khoảng được không?", "explanation": "Số đếm dao động, không bằng nhau dù khoảng thời gian bằng nhau. Không dự đoán chính xác thời điểm phân rã từng hạt hay từng số đếm; chỉ dự đoán thống kê khi xét nhiều hạt/lượt. Số đếm còn phụ thuộc hiệu suất ghi nhận.", "points": 1, "source": {"book": "Sách giáo khoa Vật lí 12 · Kết nối tri thức", "bookId": "sgk-kntt", "sequence": 33, "label": "Câu 33 · Hoạt động tr. 105", "pages": [107], "printedPages": [105]}, "bloom": {"level": "analyze", "rationale": "So sánh các khoảng đo và phân biệt kết quả ngẫu nhiên với dự đoán thống kê.", "review": "reviewed"}, "status": "ready", "notes": ["Phần dẫn đối chiếu trực quan bản mẫu SGK tháng 1/2024; lời giải do người biên soạn xây dựng, không phải đáp án chính thức của nhà xuất bản.", "Nhãn Bloom là phân loại nội bộ theo yêu cầu trả lời; chưa thẩm định độc lập."]}, {"id": "sgk-kntt-nuclear-034", "kind": "written", "topic": "B23", "chapter": "Vật lí hạt nhân", "level": "Nhận biết", "prompt": "Nêu các tính chất tia phóng xạ $\\alpha$.", "explanation": "Là hạt nhân ${}^{4}_{2}\\mathrm{He}$, điện tích +2e, ion hóa mạnh và đâm xuyên kém; bị lệch trong điện/từ trường.", "points": 1, "source": {"book": "Sách giáo khoa Vật lí 12 · Kết nối tri thức", "bookId": "sgk-kntt", "sequence": 34, "label": "Câu 34 · Câu hỏi alpha 1 tr. 106", "pages": [108], "printedPages": [106]}, "bloom": {"level": "remember", "rationale": "Nhắc lại bản chất và tính chất của loại bức xạ.", "review": "reviewed"}, "status": "ready", "notes": ["Phần dẫn đối chiếu trực quan bản mẫu SGK tháng 1/2024; lời giải do người biên soạn xây dựng, không phải đáp án chính thức của nhà xuất bản.", "Nhãn Bloom là phân loại nội bộ theo yêu cầu trả lời; chưa thẩm định độc lập."], "figure": {"url": "/api/book-bank/asset?file=sgk-kntt%2Fverified-figures%2Fhinh-23-4.png", "description": "Hình 23.4. Khả năng đâm xuyên của các tia phóng xạ", "origin": "source_crop"}}, {"id": "sgk-kntt-nuclear-035", "kind": "written", "topic": "B23", "chapter": "Vật lí hạt nhân", "level": "Vận dụng", "prompt": "Viết phương trình phân rã $\\alpha$ của ${}^{235}_{92}\\mathrm{U}$.", "explanation": "${}^{235}_{92}\\mathrm{U}\\to{}^{231}_{90}\\mathrm{Th}+{}^{4}_{2}\\mathrm{He}$.", "points": 1, "source": {"book": "Sách giáo khoa Vật lí 12 · Kết nối tri thức", "bookId": "sgk-kntt", "sequence": 35, "label": "Câu 35 · Câu hỏi alpha 2 tr. 106", "pages": [108], "printedPages": [106]}, "bloom": {"level": "apply", "rationale": "Áp dụng bảo toàn A và điện tích cho phân rã alpha.", "review": "reviewed"}, "status": "ready", "notes": ["Phần dẫn đối chiếu trực quan bản mẫu SGK tháng 1/2024; lời giải do người biên soạn xây dựng, không phải đáp án chính thức của nhà xuất bản.", "Nhãn Bloom là phân loại nội bộ theo yêu cầu trả lời; chưa thẩm định độc lập."]}, {"id": "sgk-kntt-nuclear-036", "kind": "written", "topic": "B23", "chapter": "Vật lí hạt nhân", "level": "Nhận biết", "prompt": "Nêu các tính chất phóng xạ $\\beta$.", "explanation": "$\\beta^-$ là electron, $\\beta^+$ là positron, vận tốc lớn; mức ion hóa và đâm xuyên khác alpha; chịu lực trong điện/từ trường.", "points": 1, "source": {"book": "Sách giáo khoa Vật lí 12 · Kết nối tri thức", "bookId": "sgk-kntt", "sequence": 36, "label": "Câu 36 · Câu hỏi beta 1 tr. 106", "pages": [108], "printedPages": [106]}, "bloom": {"level": "remember", "rationale": "Nhắc lại bản chất hai loại tia beta.", "review": "reviewed"}, "status": "ready", "notes": ["Phần dẫn đối chiếu trực quan bản mẫu SGK tháng 1/2024; lời giải do người biên soạn xây dựng, không phải đáp án chính thức của nhà xuất bản.", "Nhãn Bloom là phân loại nội bộ theo yêu cầu trả lời; chưa thẩm định độc lập."]}, {"id": "sgk-kntt-nuclear-037", "kind": "written", "topic": "B23", "chapter": "Vật lí hạt nhân", "level": "Vận dụng", "prompt": "Viết phương trình phân rã $\\beta^-$ của ${}^{90}_{38}\\mathrm{Sr}$ và $\\beta^+$ của ${}^{18}_{9}\\mathrm{F}$.", "explanation": "${}^{90}_{38}\\mathrm{Sr}\\to{}^{90}_{39}\\mathrm{Y}+{}^{0}_{-1}\\mathrm{e}+\\mathrm{antineutrino}$; ${}^{18}_{9}\\mathrm{F}\\to{}^{18}_{8}\\mathrm{O}+{}^{0}_{1}\\mathrm{e}+\\nu$.", "points": 1, "source": {"book": "Sách giáo khoa Vật lí 12 · Kết nối tri thức", "bookId": "sgk-kntt", "sequence": 37, "label": "Câu 37 · Câu hỏi beta 2 tr. 106", "pages": [108], "printedPages": [106]}, "bloom": {"level": "apply", "rationale": "Áp dụng quy tắc giữ A, thay Z đúng chiều và bảo toàn điện tích.", "review": "reviewed"}, "status": "ready", "notes": ["Phần dẫn đối chiếu trực quan bản mẫu SGK tháng 1/2024; lời giải do người biên soạn xây dựng, không phải đáp án chính thức của nhà xuất bản.", "Nhãn Bloom là phân loại nội bộ theo yêu cầu trả lời; chưa thẩm định độc lập."]}, {"id": "sgk-kntt-nuclear-038", "kind": "written", "topic": "B23", "chapter": "Vật lí hạt nhân", "level": "Nhận biết", "prompt": "Nêu các tính chất phóng xạ $\\gamma$.", "explanation": "Là photon năng lượng cao, không mang điện, không lệch trong điện/từ trường, đâm xuyên mạnh; phát khi hạt nhân chuyển về mức năng lượng thấp hơn.", "points": 1, "source": {"book": "Sách giáo khoa Vật lí 12 · Kết nối tri thức", "bookId": "sgk-kntt", "sequence": 38, "label": "Câu 38 · Câu hỏi gamma 1 tr. 107", "pages": [109], "printedPages": [107]}, "bloom": {"level": "remember", "rationale": "Nhắc lại bản chất và tính chất gamma.", "review": "reviewed"}, "status": "ready", "notes": ["Phần dẫn đối chiếu trực quan bản mẫu SGK tháng 1/2024; lời giải do người biên soạn xây dựng, không phải đáp án chính thức của nhà xuất bản.", "Nhãn Bloom là phân loại nội bộ theo yêu cầu trả lời; chưa thẩm định độc lập."]}, {"id": "sgk-kntt-nuclear-039", "kind": "written", "topic": "B23", "chapter": "Vật lí hạt nhân", "level": "Vận dụng", "prompt": "Technetium ${}^{99}_{43}\\mathrm{Tc}^{*}$ là đồng vị phát gamma dùng trong chụp ảnh y học hạt nhân. Viết phương trình phân rã này.", "explanation": "${}^{99}_{43}\\mathrm{Tc}^{*}\\to{}^{99}_{43}\\mathrm{Tc}+\\gamma$. Số A và Z không đổi.", "points": 1, "source": {"book": "Sách giáo khoa Vật lí 12 · Kết nối tri thức", "bookId": "sgk-kntt", "sequence": 39, "label": "Câu 39 · Câu hỏi gamma 2 tr. 107", "pages": [109], "printedPages": [107]}, "bloom": {"level": "apply", "rationale": "Áp dụng đặc điểm chuyển mức năng lượng không thay đổi A, Z.", "review": "reviewed"}, "status": "ready", "notes": ["Phần dẫn đối chiếu trực quan bản mẫu SGK tháng 1/2024; lời giải do người biên soạn xây dựng, không phải đáp án chính thức của nhà xuất bản.", "Nhãn Bloom là phân loại nội bộ theo yêu cầu trả lời; chưa thẩm định độc lập."]}, {"id": "sgk-kntt-nuclear-040", "kind": "written", "topic": "B23", "chapter": "Vật lí hạt nhân", "level": "Thông hiểu", "prompt": "Giải thích hướng lệch của các tia phóng xạ trong điện trường và từ trường ở Hình 23.3.", "explanation": "$\\alpha,\\beta^+$ mang điện dương và $\\beta^-$ mang điện âm nên lực điện có chiều ngược nhau; gamma trung hòa nên không lệch. Trong từ trường dùng lực Lorentz theo hướng vận tốc, từ trường và dấu điện tích.", "points": 1, "source": {"book": "Sách giáo khoa Vật lí 12 · Kết nối tri thức", "bookId": "sgk-kntt", "sequence": 40, "label": "Câu 40 · Hoạt động 1 tr. 107", "pages": [109], "printedPages": [107]}, "bloom": {"level": "understand", "rationale": "Giải thích đường đi từ điện tích và lực tương ứng.", "review": "reviewed"}, "status": "ready", "notes": ["Phần dẫn đối chiếu trực quan bản mẫu SGK tháng 1/2024; lời giải do người biên soạn xây dựng, không phải đáp án chính thức của nhà xuất bản.", "Nhãn Bloom là phân loại nội bộ theo yêu cầu trả lời; chưa thẩm định độc lập."], "figure": {"url": "/api/book-bank/asset?file=sgk-kntt%2Fverified-figures%2Fhinh-23-3.png", "description": "Hình 23.3. Sự lệch các tia phóng xạ trong điện trường và từ trường", "origin": "source_crop"}}, {"id": "sgk-kntt-nuclear-041", "kind": "written", "topic": "B23", "chapter": "Vật lí hạt nhân", "level": "Thông hiểu", "prompt": "Giải thích vì sao tia alpha, beta và gamma có khả năng đâm xuyên khác nhau.", "explanation": "Bản chất, khối lượng, điện tích và cơ chế tương tác với vật chất khác nhau. Alpha mất năng lượng nhanh do ion hóa mạnh; beta thường xuyên sâu hơn; photon gamma tương tác theo cơ chế khác và xuyên sâu hơn trong mô tả định tính SGK.", "points": 1, "source": {"book": "Sách giáo khoa Vật lí 12 · Kết nối tri thức", "bookId": "sgk-kntt", "sequence": 41, "label": "Câu 41 · Hoạt động 2 tr. 107", "pages": [109], "printedPages": [107]}, "bloom": {"level": "understand", "rationale": "Giải thích hoặc diễn giải mối quan hệ vật lí từ kiến thức đã học.", "review": "reviewed"}, "status": "ready", "notes": ["Phần dẫn đối chiếu trực quan bản mẫu SGK tháng 1/2024; lời giải do người biên soạn xây dựng, không phải đáp án chính thức của nhà xuất bản.", "Nhãn Bloom là phân loại nội bộ theo yêu cầu trả lời; chưa thẩm định độc lập."], "figure": {"url": "/api/book-bank/asset?file=sgk-kntt%2Fverified-figures%2Fhinh-23-4.png", "description": "Hình 23.4. Khả năng đâm xuyên của các tia phóng xạ", "origin": "source_crop"}}, {"id": "sgk-kntt-nuclear-042", "kind": "written", "topic": "B23", "chapter": "Vật lí hạt nhân", "level": "Nhận biết", "prompt": "Phát biểu định nghĩa chu kì bán rã.", "explanation": "Khoảng thời gian để số hạt nhân chưa phân rã của mẫu giảm còn một nửa giá trị ban đầu theo mô hình thống kê.", "points": 1, "source": {"book": "Sách giáo khoa Vật lí 12 · Kết nối tri thức", "bookId": "sgk-kntt", "sequence": 42, "label": "Câu 42 · Câu hỏi 1 tr. 108", "pages": [110], "printedPages": [108]}, "bloom": {"level": "remember", "rationale": "Nhắc lại định nghĩa chu kì bán rã.", "review": "reviewed"}, "status": "ready", "notes": ["Phần dẫn đối chiếu trực quan bản mẫu SGK tháng 1/2024; lời giải do người biên soạn xây dựng, không phải đáp án chính thức của nhà xuất bản.", "Nhãn Bloom là phân loại nội bộ theo yêu cầu trả lời; chưa thẩm định độc lập."]}, {"id": "sgk-kntt-nuclear-043", "kind": "written", "topic": "B23", "chapter": "Vật lí hạt nhân", "level": "Vận dụng", "prompt": "Đồng vị ${}^{15}_{8}\\mathrm{O}$ sau 244 s có 75% số hạt nhân ban đầu đã phân rã. Tính chu kì bán rã.", "explanation": "Còn 25% nên $244=2T$, do đó $T=122$ s.", "points": 1, "source": {"book": "Sách giáo khoa Vật lí 12 · Kết nối tri thức", "bookId": "sgk-kntt", "sequence": 43, "label": "Câu 43 · Câu hỏi 2 tr. 108", "pages": [110], "printedPages": [108]}, "bloom": {"level": "apply", "rationale": "Chuyển phần đã phân rã sang phần còn lại và áp dụng định luật bán rã.", "review": "reviewed"}, "status": "ready", "notes": ["Phần dẫn đối chiếu trực quan bản mẫu SGK tháng 1/2024; lời giải do người biên soạn xây dựng, không phải đáp án chính thức của nhà xuất bản.", "Nhãn Bloom là phân loại nội bộ theo yêu cầu trả lời; chưa thẩm định độc lập."]}, {"id": "sgk-kntt-nuclear-044", "kind": "written", "topic": "B23", "chapter": "Vật lí hạt nhân", "level": "Thông hiểu", "prompt": "Nêu ý nghĩa của hằng số phóng xạ.", "explanation": "$\\lambda=\\ln2/T$ đặc trưng tốc độ phân rã của đồng vị; với nhiều hạt, độ phóng xạ trung bình $H=\\lambda N$.", "points": 1, "source": {"book": "Sách giáo khoa Vật lí 12 · Kết nối tri thức", "bookId": "sgk-kntt", "sequence": 44, "label": "Câu 44 · Câu hỏi 1 tr. 109", "pages": [111], "printedPages": [109]}, "bloom": {"level": "understand", "rationale": "Giải thích hoặc diễn giải mối quan hệ vật lí từ kiến thức đã học.", "review": "reviewed"}, "status": "ready", "notes": ["Phần dẫn đối chiếu trực quan bản mẫu SGK tháng 1/2024; lời giải do người biên soạn xây dựng, không phải đáp án chính thức của nhà xuất bản.", "Nhãn Bloom là phân loại nội bộ theo yêu cầu trả lời; chưa thẩm định độc lập."]}, {"id": "sgk-kntt-nuclear-045", "kind": "written", "topic": "B23", "chapter": "Vật lí hạt nhân", "level": "Vận dụng", "prompt": "Dược chất Flortaucipir chứa ${}^{18}_{9}\\mathrm{F}$ có chu kì bán rã khoảng 110 phút. Sau bao lâu lượng đồng vị giảm còn 10% và 1% lúc đầu?", "explanation": "$t=T\\log_2(N_0/N)$; khoảng 365,4 phút (10%) và 730,8 phút (1%).", "points": 1, "source": {"book": "Sách giáo khoa Vật lí 12 · Kết nối tri thức", "bookId": "sgk-kntt", "sequence": 45, "label": "Câu 45 · Câu hỏi 2a tr. 109", "pages": [111], "printedPages": [109]}, "bloom": {"level": "apply", "rationale": "Giải phương trình suy giảm mũ cho hai tỉ lệ đã cho.", "review": "reviewed"}, "status": "ready", "notes": ["Phần dẫn đối chiếu trực quan bản mẫu SGK tháng 1/2024; lời giải do người biên soạn xây dựng, không phải đáp án chính thức của nhà xuất bản.", "Nhãn Bloom là phân loại nội bộ theo yêu cầu trả lời; chưa thẩm định độc lập."]}, {"id": "sgk-kntt-nuclear-046", "kind": "written", "topic": "B23", "chapter": "Vật lí hạt nhân", "level": "Vận dụng", "prompt": "Mỗi mL Flortaucipir có độ phóng xạ ban đầu $10^9$ Bq, đồng vị ${}^{18}_{9}\\mathrm{F}$ có T=110 phút. Tính số hạt đồng vị trong mỗi mL lúc đầu và sau một ngày.", "explanation": "$N_0=H_0T/\\ln2\\approx9{,}52\\times10^{12}$ hạt, với T=6600 s. Sau 1440 phút: $N\\approx1{,}09\\times10^9$ hạt.", "points": 1, "source": {"book": "Sách giáo khoa Vật lí 12 · Kết nối tri thức", "bookId": "sgk-kntt", "sequence": 46, "label": "Câu 46 · Câu hỏi 2b tr. 109", "pages": [111], "printedPages": [109]}, "bloom": {"level": "apply", "rationale": "Đổi thời gian thống nhất, dùng H=λN rồi suy giảm theo thời gian.", "review": "reviewed"}, "status": "ready", "notes": ["Phần dẫn đối chiếu trực quan bản mẫu SGK tháng 1/2024; lời giải do người biên soạn xây dựng, không phải đáp án chính thức của nhà xuất bản.", "Nhãn Bloom là phân loại nội bộ theo yêu cầu trả lời; chưa thẩm định độc lập."]}, {"id": "sgk-kntt-nuclear-047", "kind": "written", "topic": "B23", "chapter": "Vật lí hạt nhân", "level": "Vận dụng", "prompt": "Tìm hiểu tác hại của phóng xạ đến sức khỏe: a) các loại phơi nhiễm; b) biểu hiện; c) cách phòng tránh.", "explanation": "Phân biệt chiếu xạ ngoài với chất phóng xạ vào cơ thể; tác động phụ thuộc loại bức xạ, mức và thời gian phơi nhiễm. Phòng tránh theo kiểm soát nguồn, thời gian, khoảng cách, che chắn và hướng dẫn chuyên môn. Khi trình bày biểu hiện phải dùng nguồn y tế có tác giả/cơ quan; không suy chẩn đoán cho cá nhân.", "points": 1, "source": {"book": "Sách giáo khoa Vật lí 12 · Kết nối tri thức", "bookId": "sgk-kntt", "sequence": 47, "label": "Câu 47 · Hoạt động 1 tr. 111", "pages": [113], "printedPages": [111]}, "bloom": {"level": "analyze", "rationale": "Phân loại con đường phơi nhiễm và liên hệ với biện pháp bảo vệ; cần bằng chứng nguồn.", "review": "reviewed"}, "status": "ready", "notes": ["Phần dẫn đối chiếu trực quan bản mẫu SGK tháng 1/2024; lời giải do người biên soạn xây dựng, không phải đáp án chính thức của nhà xuất bản.", "Nhãn Bloom là phân loại nội bộ theo yêu cầu trả lời; chưa thẩm định độc lập."]}, {"id": "sgk-kntt-nuclear-048", "kind": "written", "topic": "B23", "chapter": "Vật lí hạt nhân", "level": "Vận dụng", "prompt": "Nêu tên các địa điểm/vật có nguy cơ phóng xạ ở Hình 23.9. Nếu gặp các biển cảnh báo đó, em sẽ làm gì?", "explanation": "Nhà máy/khu vực hạt nhân, thiết bị chứa nguồn, phòng đặt máy gia tốc, phòng PET/CT. Không tự tiếp cận hoặc mở vật chứa; làm theo biển và hướng dẫn của người phụ trách.", "points": 1, "source": {"book": "Sách giáo khoa Vật lí 12 · Kết nối tri thức", "bookId": "sgk-kntt", "sequence": 48, "label": "Câu 48 · Hoạt động 2 tr. 111", "pages": [113], "printedPages": [111]}, "bloom": {"level": "apply", "rationale": "Áp dụng ý nghĩa biển cảnh báo vào tình huống cụ thể.", "review": "reviewed"}, "status": "ready", "notes": ["Phần dẫn đối chiếu trực quan bản mẫu SGK tháng 1/2024; lời giải do người biên soạn xây dựng, không phải đáp án chính thức của nhà xuất bản.", "Nhãn Bloom là phân loại nội bộ theo yêu cầu trả lời; chưa thẩm định độc lập."], "figure": {"url": "/api/book-bank/asset?file=sgk-kntt%2Fverified-figures%2Fhinh-23-9.png", "description": "Hình 23.9. Biển cảnh báo phóng xạ trong nhiều trường hợp", "origin": "source_crop"}}, {"id": "sgk-kntt-nuclear-049", "kind": "written", "topic": "B23", "chapter": "Vật lí hạt nhân", "level": "Thông hiểu", "prompt": "Tìm hiểu và nêu thêm nguyên tắc an toàn phóng xạ. Việc tuân thủ quy tắc có vai trò gì?", "explanation": "Kiểm soát nguồn và tiếp cận, dùng thiết bị bảo vệ/giám sát phù hợp, đào tạo và làm theo quy trình đơn vị. Vai trò: giảm phơi nhiễm không cần thiết và nguy cơ nhiễm bẩn; không tự thực hành với nguồn thật.", "points": 1, "source": {"book": "Sách giáo khoa Vật lí 12 · Kết nối tri thức", "bookId": "sgk-kntt", "sequence": 49, "label": "Câu 49 · Hoạt động 1 tr. 112", "pages": [114], "printedPages": [112]}, "bloom": {"level": "understand", "rationale": "Giải thích hoặc diễn giải mối quan hệ vật lí từ kiến thức đã học.", "review": "reviewed"}, "status": "ready", "notes": ["Phần dẫn đối chiếu trực quan bản mẫu SGK tháng 1/2024; lời giải do người biên soạn xây dựng, không phải đáp án chính thức của nhà xuất bản.", "Nhãn Bloom là phân loại nội bộ theo yêu cầu trả lời; chưa thẩm định độc lập."]}, {"id": "sgk-kntt-nuclear-050", "kind": "written", "topic": "B23", "chapter": "Vật lí hạt nhân", "level": "Thông hiểu", "prompt": "Nguồn và chất thải phóng xạ được bảo quản trong thiết bị lưu trữ (Hình 23.12) hoặc hầm cách li nguồn nước (Hình 24.2). Người ta áp dụng nguyên tắc an toàn nào?", "explanation": "Che chắn bằng vật liệu thích hợp, lưu giữ/kiểm soát nguồn, cách li tránh chất phóng xạ phát tán vào môi trường và nguồn nước. Nêu cả che chắn bức xạ và ngăn nhiễm bẩn.", "points": 1, "source": {"book": "Sách giáo khoa Vật lí 12 · Kết nối tri thức", "bookId": "sgk-kntt", "sequence": 50, "label": "Câu 50 · Hoạt động 2 tr. 112", "pages": [114], "printedPages": [112]}, "bloom": {"level": "understand", "rationale": "Giải thích hoặc diễn giải mối quan hệ vật lí từ kiến thức đã học.", "review": "reviewed"}, "status": "ready", "notes": ["Phần dẫn đối chiếu trực quan bản mẫu SGK tháng 1/2024; lời giải do người biên soạn xây dựng, không phải đáp án chính thức của nhà xuất bản.", "Nhãn Bloom là phân loại nội bộ theo yêu cầu trả lời; chưa thẩm định độc lập."], "figure": {"url": "/api/book-bank/asset?file=sgk-kntt%2Fverified-figures%2Fhinh-23-12.png", "description": "Hình 23.12. Thiết bị bảo quản dược chất phóng xạ", "origin": "source_crop"}}, {"id": "sgk-kntt-nuclear-051", "kind": "written", "topic": "B24", "chapter": "Vật lí hạt nhân", "level": "Vận dụng", "prompt": "Nhà máy điện hạt nhân có những ưu điểm và nhược điểm gì?", "explanation": "Nêu khả năng phát điện ổn định, nhiên liệu có mật độ năng lượng cao và phát thải trực tiếp thấp; cân nhắc chi phí đầu tư, chất thải, an toàn, thời gian xây dựng và tháo dỡ. Kết luận cần tiêu chí so sánh, không chỉ liệt kê.", "points": 1, "source": {"book": "Sách giáo khoa Vật lí 12 · Kết nối tri thức", "bookId": "sgk-kntt", "sequence": 51, "label": "Câu 51 · Khởi động tr. 114", "pages": [116], "printedPages": [114]}, "bloom": {"level": "evaluate", "rationale": "Cân nhắc lợi ích và hạn chế theo các tiêu chí năng lượng, môi trường và kinh tế.", "review": "reviewed"}, "status": "ready", "notes": ["Phần dẫn đối chiếu trực quan bản mẫu SGK tháng 1/2024; lời giải do người biên soạn xây dựng, không phải đáp án chính thức của nhà xuất bản.", "Nhãn Bloom là phân loại nội bộ theo yêu cầu trả lời; chưa thẩm định độc lập."]}, {"id": "sgk-kntt-nuclear-052", "kind": "written", "topic": "B24", "chapter": "Vật lí hạt nhân", "level": "Thông hiểu", "prompt": "Vì sao nhà máy điện hạt nhân thường được xây cạnh hồ, sông hoặc bờ biển?", "explanation": "Cần nguồn nước để làm mát/ngưng tụ và thải nhiệt; vị trí còn phải đáp ứng điều kiện an toàn, địa chất, môi trường.", "points": 1, "source": {"book": "Sách giáo khoa Vật lí 12 · Kết nối tri thức", "bookId": "sgk-kntt", "sequence": 52, "label": "Câu 52 · Câu hỏi 1 tr. 116", "pages": [118], "printedPages": [116]}, "bloom": {"level": "understand", "rationale": "Giải thích hoặc diễn giải mối quan hệ vật lí từ kiến thức đã học.", "review": "reviewed"}, "status": "ready", "notes": ["Phần dẫn đối chiếu trực quan bản mẫu SGK tháng 1/2024; lời giải do người biên soạn xây dựng, không phải đáp án chính thức của nhà xuất bản.", "Nhãn Bloom là phân loại nội bộ theo yêu cầu trả lời; chưa thẩm định độc lập."]}, {"id": "sgk-kntt-nuclear-053", "kind": "written", "topic": "B24", "chapter": "Vật lí hạt nhân", "level": "Thông hiểu", "prompt": "Liệt kê các nguy cơ ảnh hưởng sức khỏe con người và môi trường nếu xảy ra sự cố tại lò phản ứng hạt nhân.", "explanation": "Có thể phát tán chất phóng xạ, gây chiếu xạ/nhiễm bẩn, ảnh hưởng nước, đất và hệ sinh thái. Mức nguy cơ tùy kịch bản sự cố và biện pháp kiểm soát; không khẳng định mọi sự cố có hậu quả như nhau.", "points": 1, "source": {"book": "Sách giáo khoa Vật lí 12 · Kết nối tri thức", "bookId": "sgk-kntt", "sequence": 53, "label": "Câu 53 · Câu hỏi 2 tr. 116", "pages": [118], "printedPages": [116]}, "bloom": {"level": "understand", "rationale": "Giải thích hoặc diễn giải mối quan hệ vật lí từ kiến thức đã học.", "review": "reviewed"}, "status": "ready", "notes": ["Phần dẫn đối chiếu trực quan bản mẫu SGK tháng 1/2024; lời giải do người biên soạn xây dựng, không phải đáp án chính thức của nhà xuất bản.", "Nhãn Bloom là phân loại nội bộ theo yêu cầu trả lời; chưa thẩm định độc lập."]}, {"id": "sgk-kntt-nuclear-054", "kind": "written", "topic": "B24", "chapter": "Vật lí hạt nhân", "level": "Thông hiểu", "prompt": "Nêu vai trò nhà máy điện hạt nhân trong đời sống.", "explanation": "Cung cấp điện năng, góp phần bảo đảm nguồn điện ổn định; liên hệ điều kiện của hệ thống điện và quản lí an toàn.", "points": 1, "source": {"book": "Sách giáo khoa Vật lí 12 · Kết nối tri thức", "bookId": "sgk-kntt", "sequence": 54, "label": "Câu 54 · Thảo luận 1 tr. 116", "pages": [118], "printedPages": [116]}, "bloom": {"level": "understand", "rationale": "Giải thích hoặc diễn giải mối quan hệ vật lí từ kiến thức đã học.", "review": "reviewed"}, "status": "ready", "notes": ["Phần dẫn đối chiếu trực quan bản mẫu SGK tháng 1/2024; lời giải do người biên soạn xây dựng, không phải đáp án chính thức của nhà xuất bản.", "Nhãn Bloom là phân loại nội bộ theo yêu cầu trả lời; chưa thẩm định độc lập."]}, {"id": "sgk-kntt-nuclear-055", "kind": "written", "topic": "B24", "chapter": "Vật lí hạt nhân", "level": "Vận dụng", "prompt": "Đánh giá ưu điểm, nhược điểm và cơ hội phát triển của nhà máy điện hạt nhân.", "explanation": "So sánh theo phát điện ổn định, phát thải vòng đời, chi phí, thời gian xây dựng, chất thải và an toàn; dẫn nguồn cho nhận định cơ hội, tránh chỉ khẳng định ưu/nhược điểm.", "points": 1, "source": {"book": "Sách giáo khoa Vật lí 12 · Kết nối tri thức", "bookId": "sgk-kntt", "sequence": 55, "label": "Câu 55 · Thảo luận 2 tr. 116", "pages": [118], "printedPages": [116]}, "bloom": {"level": "evaluate", "rationale": "Đưa ra nhận định có tiêu chí và bằng chứng, cân nhắc các phương án.", "review": "reviewed"}, "status": "ready", "notes": ["Phần dẫn đối chiếu trực quan bản mẫu SGK tháng 1/2024; lời giải do người biên soạn xây dựng, không phải đáp án chính thức của nhà xuất bản.", "Nhãn Bloom là phân loại nội bộ theo yêu cầu trả lời; chưa thẩm định độc lập."]}, {"id": "sgk-kntt-nuclear-056", "kind": "written", "topic": "B24", "chapter": "Vật lí hạt nhân", "level": "Thông hiểu", "prompt": "Tại sao sử dụng tia gamma trong chụp ảnh phóng xạ cắt lớp bên trong cơ thể?", "explanation": "Photon phát ra từ đồng vị trong cơ thể có thể tới máy dò bên ngoài; hệ ghi nhận và xử lí tái tạo phân bố chất đánh dấu. Phân biệt SPECT với PET: PET ghi cặp photon do hủy positron–electron, không phải tia X từ máy CT.", "points": 1, "source": {"book": "Sách giáo khoa Vật lí 12 · Kết nối tri thức", "bookId": "sgk-kntt", "sequence": 56, "label": "Câu 56 · Thảo luận 1 tr. 117", "pages": [119], "printedPages": [117]}, "bloom": {"level": "understand", "rationale": "Giải thích hoặc diễn giải mối quan hệ vật lí từ kiến thức đã học.", "review": "reviewed"}, "status": "ready", "notes": ["Phần dẫn đối chiếu trực quan bản mẫu SGK tháng 1/2024; lời giải do người biên soạn xây dựng, không phải đáp án chính thức của nhà xuất bản.", "Nhãn Bloom là phân loại nội bộ theo yêu cầu trả lời; chưa thẩm định độc lập."]}, {"id": "sgk-kntt-nuclear-057", "kind": "written", "topic": "B24", "chapter": "Vật lí hạt nhân", "level": "Thông hiểu", "prompt": "Nêu vai trò y học hạt nhân trong đời sống.", "explanation": "Chẩn đoán qua theo dõi chất đánh dấu và điều trị bằng bức xạ phù hợp; thực hiện bởi cơ sở và nhân viên chuyên môn, có quy trình an toàn.", "points": 1, "source": {"book": "Sách giáo khoa Vật lí 12 · Kết nối tri thức", "bookId": "sgk-kntt", "sequence": 57, "label": "Câu 57 · Thảo luận 2 tr. 117", "pages": [119], "printedPages": [117]}, "bloom": {"level": "understand", "rationale": "Giải thích hoặc diễn giải mối quan hệ vật lí từ kiến thức đã học.", "review": "reviewed"}, "status": "ready", "notes": ["Phần dẫn đối chiếu trực quan bản mẫu SGK tháng 1/2024; lời giải do người biên soạn xây dựng, không phải đáp án chính thức của nhà xuất bản.", "Nhãn Bloom là phân loại nội bộ theo yêu cầu trả lời; chưa thẩm định độc lập."]}, {"id": "sgk-kntt-nuclear-058", "kind": "written", "topic": "B24", "chapter": "Vật lí hạt nhân", "level": "Vận dụng", "prompt": "Đánh giá ưu điểm, nhược điểm và cơ hội phát triển y học hạt nhân.", "explanation": "Cân nhắc thông tin chức năng, khả năng chẩn đoán/điều trị với phơi nhiễm, chi phí, thiết bị, nhân lực và cung ứng đồng vị; dùng nguồn y tế có cơ quan/tác giả.", "points": 1, "source": {"book": "Sách giáo khoa Vật lí 12 · Kết nối tri thức", "bookId": "sgk-kntt", "sequence": 58, "label": "Câu 58 · Thảo luận 3 tr. 117", "pages": [119], "printedPages": [117]}, "bloom": {"level": "evaluate", "rationale": "Đánh giá công nghệ bằng tiêu chí lợi ích, hạn chế và điều kiện triển khai.", "review": "reviewed"}, "status": "ready", "notes": ["Phần dẫn đối chiếu trực quan bản mẫu SGK tháng 1/2024; lời giải do người biên soạn xây dựng, không phải đáp án chính thức của nhà xuất bản.", "Nhãn Bloom là phân loại nội bộ theo yêu cầu trả lời; chưa thẩm định độc lập."]}, {"id": "sgk-kntt-nuclear-059", "kind": "written", "topic": "B24", "chapter": "Vật lí hạt nhân", "level": "Thông hiểu", "prompt": "Khi dùng máy xạ trị, tia phóng xạ có tác động lên tế bào khỏe mạnh không? Tìm thông tin về triệu chứng có thể xuất hiện sau xạ trị.", "explanation": "Có thể ảnh hưởng mô khỏe; vị trí và mức tác động tùy kế hoạch điều trị. Khi tìm triệu chứng cần ghi nguồn y tế và điều kiện, không suy chẩn đoán hoặc tự hướng dẫn điều trị từ bài học.", "points": 1, "source": {"book": "Sách giáo khoa Vật lí 12 · Kết nối tri thức", "bookId": "sgk-kntt", "sequence": 59, "label": "Câu 59 · Câu hỏi xạ trị tr. 117", "pages": [119], "printedPages": [117]}, "bloom": {"level": "understand", "rationale": "Giải thích hoặc diễn giải mối quan hệ vật lí từ kiến thức đã học.", "review": "reviewed"}, "status": "ready", "notes": ["Phần dẫn đối chiếu trực quan bản mẫu SGK tháng 1/2024; lời giải do người biên soạn xây dựng, không phải đáp án chính thức của nhà xuất bản.", "Nhãn Bloom là phân loại nội bộ theo yêu cầu trả lời; chưa thẩm định độc lập."]}, {"id": "sgk-kntt-nuclear-060", "kind": "written", "topic": "B24", "chapter": "Vật lí hạt nhân", "level": "Thông hiểu", "prompt": "Nêu vai trò ứng dụng phóng xạ hạt nhân trong công nghệ sinh học và bảo quản thực phẩm.", "explanation": "Gây đột biến có chọn lọc trong nghiên cứu/chọn giống, theo dõi chất đánh dấu; chiếu xạ giảm vi sinh vật hoặc ức chế mọc mầm để bảo quản trong điều kiện phù hợp.", "points": 1, "source": {"book": "Sách giáo khoa Vật lí 12 · Kết nối tri thức", "bookId": "sgk-kntt", "sequence": 60, "label": "Câu 60 · Thảo luận 1 tr. 118", "pages": [120], "printedPages": [118]}, "bloom": {"level": "understand", "rationale": "Giải thích hoặc diễn giải mối quan hệ vật lí từ kiến thức đã học.", "review": "reviewed"}, "status": "ready", "notes": ["Phần dẫn đối chiếu trực quan bản mẫu SGK tháng 1/2024; lời giải do người biên soạn xây dựng, không phải đáp án chính thức của nhà xuất bản.", "Nhãn Bloom là phân loại nội bộ theo yêu cầu trả lời; chưa thẩm định độc lập."]}, {"id": "sgk-kntt-nuclear-061", "kind": "written", "topic": "B24", "chapter": "Vật lí hạt nhân", "level": "Vận dụng", "prompt": "Đánh giá ưu điểm, nhược điểm và cơ hội phát triển các ứng dụng phóng xạ trong công nghệ sinh học và bảo quản thực phẩm.", "explanation": "Đánh giá theo hiệu quả, chất lượng sản phẩm, chi phí thiết bị, kiểm soát quy trình và nhu cầu thực tiễn. Dẫn nguồn cho điều kiện chiếu xạ; không đồng nhất thực phẩm chiếu xạ với thực phẩm nhiễm chất phóng xạ.", "points": 1, "source": {"book": "Sách giáo khoa Vật lí 12 · Kết nối tri thức", "bookId": "sgk-kntt", "sequence": 61, "label": "Câu 61 · Thảo luận 2 tr. 118", "pages": [120], "printedPages": [118]}, "bloom": {"level": "evaluate", "rationale": "Cân nhắc các tiêu chí và dùng bằng chứng cho kết luận.", "review": "reviewed"}, "status": "ready", "notes": ["Phần dẫn đối chiếu trực quan bản mẫu SGK tháng 1/2024; lời giải do người biên soạn xây dựng, không phải đáp án chính thức của nhà xuất bản.", "Nhãn Bloom là phân loại nội bộ theo yêu cầu trả lời; chưa thẩm định độc lập."]}, {"id": "sgk-kntt-nuclear-062", "kind": "written", "topic": "B25", "chapter": "Vật lí hạt nhân", "level": "Nhận biết", "prompt": "Cần vận dụng những kiến thức cơ bản nào để giải bài tập về vật lí hạt nhân?", "explanation": "Cấu trúc/kí hiệu hạt nhân, bảo toàn trong phản ứng, năng lượng liên kết, định luật phóng xạ và ứng dụng; chọn công thức phù hợp dữ kiện.", "points": 1, "source": {"book": "Sách giáo khoa Vật lí 12 · Kết nối tri thức", "bookId": "sgk-kntt", "sequence": 62, "label": "Câu 62 · Khởi động tr. 119", "pages": [121], "printedPages": [119]}, "bloom": {"level": "remember", "rationale": "Nhắc lại các nhóm kiến thức chính của chủ đề.", "review": "reviewed"}, "status": "ready", "notes": ["Phần dẫn đối chiếu trực quan bản mẫu SGK tháng 1/2024; lời giải do người biên soạn xây dựng, không phải đáp án chính thức của nhà xuất bản.", "Nhãn Bloom là phân loại nội bộ theo yêu cầu trả lời; chưa thẩm định độc lập."]}, {"id": "sgk-kntt-nuclear-063", "kind": "written", "topic": "B25", "chapter": "Vật lí hạt nhân", "level": "Thông hiểu", "prompt": "Vì sao khi đưa mẫu phóng xạ (1) lại gần đầu thu điện (2) của tĩnh điện kế đã tích điện (Hình 25.1), độ lệch kim (3) giảm rất nhanh?", "explanation": "Bức xạ ion hóa không khí, làm không khí dẫn điện hơn; điện tích của tĩnh điện kế thất thoát nên kim nhanh về 0. Khác với chỉ đưa điện tích trái dấu đến gây tích điện ngược.", "points": 1, "source": {"book": "Sách giáo khoa Vật lí 12 · Kết nối tri thức", "bookId": "sgk-kntt", "sequence": 63, "label": "Câu 63 · Bài tập ví dụ 1 tr. 119", "pages": [121], "printedPages": [119]}, "bloom": {"level": "understand", "rationale": "Giải thích hoặc diễn giải mối quan hệ vật lí từ kiến thức đã học.", "review": "reviewed"}, "status": "ready", "notes": ["Phần dẫn đối chiếu trực quan bản mẫu SGK tháng 1/2024; lời giải do người biên soạn xây dựng, không phải đáp án chính thức của nhà xuất bản.", "Nhãn Bloom là phân loại nội bộ theo yêu cầu trả lời; chưa thẩm định độc lập."], "figure": {"url": "/api/book-bank/asset?file=sgk-kntt%2Fverified-figures%2Fhinh-25-1.png", "description": "Hình 25.1. Đưa mẫu phóng xạ lại gần tĩnh điện kế", "origin": "source_crop"}}, {"id": "sgk-kntt-nuclear-064", "kind": "written", "topic": "B25", "chapter": "Vật lí hạt nhân", "level": "Vận dụng", "prompt": "Viết phương trình phân hạch ${}^{235}_{92}\\mathrm{U}$ khi hấp thụ một neutron; sản phẩm gồm ${}^{140}_{58}\\mathrm{Ce}$, ${}^{94}_{40}\\mathrm{Zr}$, neutron và các tia $\\beta^-$.", "explanation": "Theo bài toán bảo toàn của SGK: ${}^{235}_{92}\\mathrm{U}+{}^{1}_{0}\\mathrm{n}\\to{}^{140}_{58}\\mathrm{Ce}+{}^{94}_{40}\\mathrm{Zr}+2{}^{1}_{0}\\mathrm{n}+6{}^{0}_{-1}\\mathrm{e}$. Đây là biểu diễn gộp; beta thường được phát trong các phân rã sau phân hạch, không khẳng định sáu electron đồng thời sinh ra ở bước phân hạch tức thời.", "points": 1, "source": {"book": "Sách giáo khoa Vật lí 12 · Kết nối tri thức", "bookId": "sgk-kntt", "sequence": 64, "label": "Câu 64 · Bài tập ví dụ 2 tr. 120", "pages": [122], "printedPages": [120]}, "bloom": {"level": "apply", "rationale": "Dùng đồng thời bảo toàn A và điện tích để tìm hệ số.", "review": "reviewed"}, "status": "ready", "notes": ["Phần dẫn đối chiếu trực quan bản mẫu SGK tháng 1/2024; lời giải do người biên soạn xây dựng, không phải đáp án chính thức của nhà xuất bản.", "Nhãn Bloom là phân loại nội bộ theo yêu cầu trả lời; chưa thẩm định độc lập."]}, {"id": "sgk-kntt-nuclear-065", "kind": "written", "topic": "B25", "chapter": "Vật lí hạt nhân", "level": "Vận dụng", "prompt": "Máy xạ trị dùng ${}^{60}_{27}\\mathrm{Co}$, T=5,3 năm. Theo điều kiện bài toán, cần bảo dưỡng trước khi độ phóng xạ giảm 7% và thay nguồn khi giảm 50%. Thiết lập lịch bảo dưỡng và thay nguồn.", "explanation": "Ngưỡng 7% ứng với t=5,3×ln(1/0,93)/ln2≈0,555 năm≈6,66 tháng; chọn chu kì 6 tháng để trước ngưỡng. Ngưỡng 50% ứng với 5,3 năm. Đây là điều kiện bài toán SGK, không phải quy định bảo dưỡng máy xạ trị thực tế.", "points": 1, "source": {"book": "Sách giáo khoa Vật lí 12 · Kết nối tri thức", "bookId": "sgk-kntt", "sequence": 65, "label": "Câu 65 · Bài tập ví dụ 3 tr. 120", "pages": [122], "printedPages": [120]}, "bloom": {"level": "apply", "rationale": "Dùng suy giảm mũ và chọn mốc thời gian đáp ứng điều kiện cho trước.", "review": "reviewed"}, "status": "ready", "notes": ["Phần dẫn đối chiếu trực quan bản mẫu SGK tháng 1/2024; lời giải do người biên soạn xây dựng, không phải đáp án chính thức của nhà xuất bản.", "Nhãn Bloom là phân loại nội bộ theo yêu cầu trả lời; chưa thẩm định độc lập."], "figure": {"url": "/api/book-bank/asset?file=sgk-kntt%2Fverified-figures%2Fhinh-25-2.png", "description": "Hình 25.2. Máy xạ trị trong bệnh viện", "origin": "source_crop"}}, {"id": "sgk-kntt-nuclear-066", "kind": "choice", "topic": "B25", "chapter": "Vật lí hạt nhân", "level": "Thông hiểu", "prompt": "Lực nào làm thay đổi phương của hạt alpha (${}^{4}_{2}\\mathrm{He}$) khi bắn vào lá vàng mỏng?", "explanation": "C. Lực đẩy tĩnh điện giữa hai hạt nhân mang điện dương.", "points": 1, "source": {"book": "Sách giáo khoa Vật lí 12 · Kết nối tri thức", "bookId": "sgk-kntt", "sequence": 66, "label": "Câu 66 · Bài tập vận dụng 1 tr. 121", "pages": [123], "printedPages": [121]}, "bloom": {"level": "understand", "rationale": "Nhận diện cơ chế gây lệch từ bản chất điện tích của hai hạt.", "review": "reviewed"}, "status": "ready", "notes": ["Phần dẫn đối chiếu trực quan bản mẫu SGK tháng 1/2024; lời giải do người biên soạn xây dựng, không phải đáp án chính thức của nhà xuất bản.", "Nhãn Bloom là phân loại nội bộ theo yêu cầu trả lời; chưa thẩm định độc lập."], "figure": {"url": "/api/book-bank/asset?file=sgk-kntt%2Fverified-figures%2Fhinh-21-2.png", "description": "Hình 21.2. Bố trí thí nghiệm tán xạ hạt alpha", "origin": "source_crop"}, "options": ["Lực hạt nhân giúp hạt nhân ${}^{197}_{79}\\mathrm{Au}$ đẩy ${}^{4}_{2}\\mathrm{He}$.", "Lực hạt nhân giúp hạt nhân ${}^{197}_{79}\\mathrm{Au}$ hút ${}^{4}_{2}\\mathrm{He}$.", "Lực đẩy tĩnh điện giữa hạt nhân ${}^{197}_{79}\\mathrm{Au}$ và ${}^{4}_{2}\\mathrm{He}$.", "Lực hút tĩnh điện giữa electron của nguyên tử vàng và ${}^{4}_{2}\\mathrm{He}$."], "answer": 2}, {"id": "sgk-kntt-nuclear-068", "kind": "written", "topic": "B25", "chapter": "Vật lí hạt nhân", "level": "Vận dụng", "prompt": "Mẫu gỗ cổ ghi nhận 240 phân rã mỗi phút, chứa 25 g carbon gồm ${}^{14}_{6}\\mathrm{C}$ và ${}^{12}_{6}\\mathrm{C}$. T của C-14 là 5730 năm; tỉ lệ C-12:C-14 ở sinh vật sống là $10^{12}:1$. a) Tính số nguyên tử C-14 hiện có. b) Tính tuổi mẫu. Dùng $N_A=6{,}022\\times10^{23}\\ \\mathrm{mol}^{-1}$, một năm 365 ngày.", "explanation": "Giả sử hiệu suất đếm 100%, không có nền và mẫu kín: H=4 Bq; N=H×T/ln2≈1,043×10¹² hạt. N₀≈(25/12)N_A/10¹²≈1,255×10¹² hạt. Tuổi≈1529 năm. Nêu các giả thiết khi chuyển số đếm thành H.", "points": 1, "source": {"book": "Sách giáo khoa Vật lí 12 · Kết nối tri thức", "bookId": "sgk-kntt", "sequence": 68, "label": "Câu 68 · Bài tập vận dụng 3 tr. 121", "pages": [123], "printedPages": [121]}, "bloom": {"level": "apply", "rationale": "Chuyển tốc độ đếm, tính N và giải suy giảm từ tỉ lệ đồng vị ban đầu.", "review": "reviewed"}, "status": "ready", "notes": ["Phần dẫn đối chiếu trực quan bản mẫu SGK tháng 1/2024; lời giải do người biên soạn xây dựng, không phải đáp án chính thức của nhà xuất bản.", "Nhãn Bloom là phân loại nội bộ theo yêu cầu trả lời; chưa thẩm định độc lập."]}, {"id": "sgk-kntt-nuclear-069", "kind": "written", "topic": "B25", "chapter": "Vật lí hạt nhân", "level": "Vận dụng", "prompt": "Nhà máy điện dùng ${}^{235}\\mathrm{U}$; mỗi phân hạch tỏa 200 MeV, hiệu suất 36%, công suất điện 1400 MW. a) Tính khối lượng U-235 tiêu thụ một năm. b) Tính lượng than cần để tạo điện năng tương đương; năng suất tỏa nhiệt than 30 MJ/kg. Dùng năm 365 ngày, $N_A=6{,}022\\times10^{23}\\ \\mathrm{mol}^{-1}$, $1\\ \\mathrm{MeV}=1{,}602\\times10^{-13}$ J.", "explanation": "Q=Pđiện×t/0,36≈1,2264×10¹⁷ J; U-235≈1,494×10³ kg. Với than, đề không cho hiệu suất nhà máy than: mthan=Pđiện×t/(ηthan×30×10⁶). Nếu giả sử ηthan=0,36 thì≈4,088×10⁹ kg; không mặc nhiên lấy cùng hiệu suất nếu chưa nêu giả thiết.", "points": 1, "source": {"book": "Sách giáo khoa Vật lí 12 · Kết nối tri thức", "bookId": "sgk-kntt", "sequence": 69, "label": "Câu 69 · Bài tập vận dụng 4 tr. 121", "pages": [123], "printedPages": [121]}, "bloom": {"level": "analyze", "rationale": "Lập chuỗi chuyển hóa và kiểm tra dữ kiện còn thiếu để so sánh hai loại nhiên liệu.", "review": "reviewed"}, "status": "ready", "notes": ["Phần dẫn đối chiếu trực quan bản mẫu SGK tháng 1/2024; lời giải do người biên soạn xây dựng, không phải đáp án chính thức của nhà xuất bản.", "Nhãn Bloom là phân loại nội bộ theo yêu cầu trả lời; chưa thẩm định độc lập."]}, {"id": "sgk-kntt-nuclear-070", "kind": "written", "topic": "B25", "chapter": "Vật lí hạt nhân", "level": "Vận dụng", "prompt": "Tháng 6/2024, người lái xe cần chờ bao lâu để chiếu xạ cùng lượng thuốc đông y tại Trung tâm chiếu xạ Hà Nội (Hình 25.3), nếu tháng 1/2022 mất 150 phút? Trung tâm vẫn dùng nguồn ${}^{60}_{27}\\mathrm{Co}$ có T=5,3 năm.", "explanation": "Giả sử cùng liều cần thiết, hình học và hiệu suất, tốc độ chiếu tỉ lệ H nên thời gian xử lí tỉ lệ 1/H. Lấy khoảng cách tháng 1/2022→6/2024 là 29 tháng: thời gian≈150×2^(29/(12×5,3))≈205,8 phút. Không có ngày cụ thể nên đây là ước lượng theo tháng.", "points": 1, "source": {"book": "Sách giáo khoa Vật lí 12 · Kết nối tri thức", "bookId": "sgk-kntt", "sequence": 70, "label": "Câu 70 · Bài tập vận dụng 5 tr. 122", "pages": [124], "printedPages": [122]}, "bloom": {"level": "apply", "rationale": "Áp dụng suy giảm nguồn để giữ cùng lượng năng lượng hấp thụ theo giả thiết.", "review": "reviewed"}, "status": "ready", "notes": ["Phần dẫn đối chiếu trực quan bản mẫu SGK tháng 1/2024; lời giải do người biên soạn xây dựng, không phải đáp án chính thức của nhà xuất bản.", "Nhãn Bloom là phân loại nội bộ theo yêu cầu trả lời; chưa thẩm định độc lập."], "figure": {"url": "/api/book-bank/asset?file=sgk-kntt%2Fverified-figures%2Fhinh-25-3.png", "description": "Hình 25.3. Khu nạp nguyên liệu tại Trung tâm chiếu xạ Hà Nội", "origin": "source_crop"}}, {"id": "sgk-kntt-nuclear-071", "kind": "written", "topic": "B25", "chapter": "Vật lí hạt nhân", "level": "Vận dụng", "prompt": "FDG chứa ${}^{18}_{9}\\mathrm{F}$ có T=110 phút, sản xuất bằng bắn phá ${}^{18}_{8}\\mathrm{O}$ trong máy gia tốc (Hình 25.4). a) Xác định hạt tới khi sản phẩm còn có neutron và gamma. b) Hai bệnh nhân cùng cân nặng, dùng cùng đợt FDG ở thời điểm cách nhau 60 phút để đạt cùng độ phóng xạ mỗi kg. Người nào cần lượng FDG nhiều hơn và nhiều hơn bao nhiêu phần trăm?", "explanation": "a) Hạt tới là proton: ${}^{18}_{8}\\mathrm{O}+{}^{1}_{1}\\mathrm{p}\\to{}^{18}_{9}\\mathrm{F}+{}^{1}_{0}\\mathrm{n}+\\gamma$. b) Người tiêm sau cần lượng nhiều hơn, tỉ số $2^{60/110}\\approx1{,}4595$, tăng khoảng 45,95%. Chỉ là bài toán tỉ lệ SGK, không dùng để quyết định liều người thật.", "points": 1, "source": {"book": "Sách giáo khoa Vật lí 12 · Kết nối tri thức", "bookId": "sgk-kntt", "sequence": 71, "label": "Câu 71 · Bài tập vận dụng 6 tr. 122", "pages": [124], "printedPages": [122]}, "bloom": {"level": "apply", "rationale": "Dùng bảo toàn A, Z và suy giảm hoạt tính để lập hai kết quả.", "review": "reviewed"}, "status": "ready", "notes": ["Phần dẫn đối chiếu trực quan bản mẫu SGK tháng 1/2024; lời giải do người biên soạn xây dựng, không phải đáp án chính thức của nhà xuất bản.", "Nhãn Bloom là phân loại nội bộ theo yêu cầu trả lời; chưa thẩm định độc lập."], "figure": {"url": "/api/book-bank/asset?file=sgk-kntt%2Fverified-figures%2Fhinh-25-4.png", "description": "Hình 25.4. Máy gia tốc tại Trung tâm chiếu xạ Hà Nội", "origin": "source_crop"}}, {"id": "ctst-nuclear-001", "kind": "choice", "topic": "B21", "chapter": "Vật lí hạt nhân", "level": "Thông hiểu", "prompt": "Cặp nguyên tử của các hạt nhân nào sau đây không được gọi là đồng vị?", "explanation": "D. Hai hạt nhân có Z khác nhau nên không là đồng vị.", "points": 1, "source": {"book": "Sách bài tập Vật lí 12 · Chân trời sáng tạo", "bookId": "ctst", "sequence": 1, "label": "Câu 14.1", "pages": [61], "printedPages": [61]}, "bloom": {"level": "understand", "rationale": "Diễn giải, so sánh hoặc giải thích ý nghĩa vật lí.", "review": "reviewed"}, "status": "ready", "notes": ["Phần dẫn và phương án đối chiếu ảnh trang sách; lời giải do người biên soạn kiểm tra.", "Nhãn Bloom là phân loại nội bộ, chưa thẩm định độc lập; mức độ ma trận được rà soát riêng."], "options": ["$^{35}_{17}\\mathrm{Cl},{}^{37}_{17}\\mathrm{Cl}$", "$^{1}_{1}\\mathrm{H},{}^{2}_{1}\\mathrm{D}$", "$^{63}_{29}\\mathrm{Cu},{}^{65}_{29}\\mathrm{Cu}$", "$^{3}_{1}\\mathrm{H},{}^{3}_{2}\\mathrm{He}$"], "answer": 3}, {"id": "ctst-nuclear-002", "kind": "choice", "topic": "B21", "chapter": "Vật lí hạt nhân", "level": "Nhận biết", "prompt": "Các nguyên tử được gọi là đồng vị khi hạt nhân của chúng có cùng", "explanation": "D. Cùng số proton, khác số neutron.", "points": 1, "source": {"book": "Sách bài tập Vật lí 12 · Chân trời sáng tạo", "bookId": "ctst", "sequence": 2, "label": "Câu 14.2", "pages": [61], "printedPages": [61]}, "bloom": {"level": "remember", "rationale": "Nhớ lại định nghĩa, tính chất hoặc quy tắc đã học.", "review": "reviewed"}, "status": "ready", "notes": ["Phần dẫn và phương án đối chiếu ảnh trang sách; lời giải do người biên soạn kiểm tra.", "Nhãn Bloom là phân loại nội bộ, chưa thẩm định độc lập; mức độ ma trận được rà soát riêng."], "options": ["khối lượng.", "số neutron.", "số nucleon.", "số proton."], "answer": 3}, {"id": "ctst-nuclear-004", "kind": "choice", "topic": "B21", "chapter": "Vật lí hạt nhân", "level": "Vận dụng", "prompt": "Sử dụng công thức về bán kính hạt nhân, hãy cho biết bán kính hạt nhân $^{207}_{82}\\mathrm{Pb}$ lớn hơn bán kính hạt nhân $^{27}_{13}\\mathrm{Al}$ bao nhiêu lần.", "explanation": "C. Tỉ số $(207/27)^{1/3}\\approx1{,}97$.", "points": 1, "source": {"book": "Sách bài tập Vật lí 12 · Chân trời sáng tạo", "bookId": "ctst", "sequence": 4, "label": "Câu 14.4", "pages": [61], "printedPages": [61]}, "bloom": {"level": "apply", "rationale": "Thực hiện quy tắc hoặc phép tính với dữ kiện của bài.", "review": "reviewed"}, "status": "ready", "notes": ["Phần dẫn và phương án đối chiếu ảnh trang sách; lời giải do người biên soạn kiểm tra.", "Nhãn Bloom là phân loại nội bộ, chưa thẩm định độc lập; mức độ ma trận được rà soát riêng."], "options": ["hơn 2,5 lần.", "hơn 2 lần.", "gần 2 lần.", "1,5 lần."], "answer": 2}, {"id": "ctst-nuclear-005", "kind": "choice", "topic": "B21", "chapter": "Vật lí hạt nhân", "level": "Thông hiểu", "prompt": "Phát biểu nào sau đây sai?", "explanation": "A. Đồng vị không bền có thể có nguồn gốc tự nhiên.", "points": 1, "source": {"book": "Sách bài tập Vật lí 12 · Chân trời sáng tạo", "bookId": "ctst", "sequence": 5, "label": "Câu 14.5", "pages": [61], "printedPages": [61]}, "bloom": {"level": "understand", "rationale": "Diễn giải, so sánh hoặc giải thích ý nghĩa vật lí.", "review": "reviewed"}, "status": "ready", "notes": ["Phần dẫn và phương án đối chiếu ảnh trang sách; lời giải do người biên soạn kiểm tra.", "Nhãn Bloom là phân loại nội bộ, chưa thẩm định độc lập; mức độ ma trận được rà soát riêng."], "options": ["Đồng vị bền chỉ có nguồn gốc tự nhiên, đồng vị không bền chỉ có nguồn gốc nhân tạo.", "Các nguyên tử mà hạt nhân có cùng số proton nhưng có số neutron khác nhau gọi là đồng vị.", "Các đồng vị của cùng một nguyên tố có số neutron khác nhau nhưng tính chất hóa học giống nhau.", "Các đồng vị của cùng một nguyên tố có cùng vị trí trong bảng hệ thống tuần hoàn."], "answer": 0}, {"id": "ctst-nuclear-006", "kind": "choice", "topic": "B21", "chapter": "Vật lí hạt nhân", "level": "Thông hiểu", "prompt": "Trong các nhận định sau đây về kết quả thí nghiệm tán xạ của hạt alpha lên lá vàng mỏng, có bao nhiêu nhận định đúng?\n(1) Phần lớn các hạt alpha xuyên thẳng qua lá vàng mỏng.\n(2) Một tỉ lệ khá lớn các hạt alpha bị lệch khỏi hướng ban đầu với góc lệch lớn hơn 90°.\n(3) Một tỉ lệ rất nhỏ các hạt alpha bị lệch khỏi hướng ban đầu với góc lệch lớn hơn 90°.\n(4) Một số ít hạt alpha bị lệch khỏi phương ban đầu với những góc lệch khác nhau.", "explanation": "C. Các nhận định (1), (3), (4) đúng.", "points": 1, "source": {"book": "Sách bài tập Vật lí 12 · Chân trời sáng tạo", "bookId": "ctst", "sequence": 6, "label": "Câu 14.6", "pages": [61, 62], "printedPages": [61, 62]}, "bloom": {"level": "understand", "rationale": "Diễn giải, so sánh hoặc giải thích ý nghĩa vật lí.", "review": "reviewed"}, "status": "ready", "notes": ["Phần dẫn và phương án đối chiếu ảnh trang sách; lời giải do người biên soạn kiểm tra.", "Nhãn Bloom là phân loại nội bộ, chưa thẩm định độc lập; mức độ ma trận được rà soát riêng."], "options": ["1.", "2.", "3.", "4."], "answer": 2}, {"id": "ctst-nuclear-007", "kind": "choice", "topic": "B21", "chapter": "Vật lí hạt nhân", "level": "Vận dụng", "prompt": "So với hạt nhân $^{12}_{6}\\mathrm{C}$, hạt nhân $^{56}_{27}\\mathrm{Co}$ có nhiều hơn", "explanation": "B. Chênh số neutron: $(56-27)-(12-6)=23$; chênh số proton: $27-6=21$.", "points": 1, "source": {"book": "Sách bài tập Vật lí 12 · Chân trời sáng tạo", "bookId": "ctst", "sequence": 7, "label": "Câu 14.7", "pages": [62], "printedPages": [62]}, "bloom": {"level": "apply", "rationale": "Thực hiện quy tắc hoặc phép tính với dữ kiện của bài.", "review": "reviewed"}, "status": "ready", "notes": ["Phần dẫn và phương án đối chiếu ảnh trang sách; lời giải do người biên soạn kiểm tra.", "Nhãn Bloom là phân loại nội bộ, chưa thẩm định độc lập; mức độ ma trận được rà soát riêng."], "options": ["44 neutron và 21 proton.", "23 neutron và 21 proton.", "44 neutron và 23 proton.", "23 neutron và 23 proton."], "answer": 1}, {"id": "ctst-nuclear-008", "kind": "choice", "topic": "B21", "chapter": "Vật lí hạt nhân", "level": "Vận dụng", "prompt": "Trong nguyên tử của đồng vị phóng xạ $^{210}_{90}\\mathrm{Th}$ có", "explanation": "B. Nguyên tử trung hòa có 90 proton, 90 electron, 120 neutron.", "points": 1, "source": {"book": "Sách bài tập Vật lí 12 · Chân trời sáng tạo", "bookId": "ctst", "sequence": 8, "label": "Câu 14.8", "pages": [62], "printedPages": [62]}, "bloom": {"level": "apply", "rationale": "Thực hiện quy tắc hoặc phép tính với dữ kiện của bài.", "review": "reviewed"}, "status": "ready", "notes": ["Phần dẫn và phương án đối chiếu ảnh trang sách; lời giải do người biên soạn kiểm tra.", "Nhãn Bloom là phân loại nội bộ, chưa thẩm định độc lập; mức độ ma trận được rà soát riêng."], "options": ["90 electron, tổng số proton và electron bằng 210.", "90 proton, tổng số neutron và electron bằng 210.", "90 neutron, tổng số neutron và electron bằng 210.", "90 neutron, tổng số proton và electron bằng 210."], "answer": 1}, {"id": "ctst-nuclear-009-tf-1", "kind": "true_false", "topic": "B21", "chapter": "Vật lí hạt nhân", "level": "Thông hiểu", "prompt": "Trong mỗi phát biểu sau, em hãy chọn đúng hoặc sai.", "explanation": "a) Sai.\nb) Đúng theo điện động lực học cổ điển.\nc) Sai.\nd) Sai.", "points": 1, "source": {"book": "Sách bài tập Vật lí 12 · Chân trời sáng tạo", "bookId": "ctst", "sequence": 9, "label": "Câu 14.9", "pages": [62], "printedPages": [62], "parts": [{"questionId": "ctst-nuclear-009", "book": "Sách bài tập Vật lí 12 · Chân trời sáng tạo", "bookId": "ctst", "sequence": 9, "label": "Câu 14.9", "pages": [62], "printedPages": [62], "statementIndexes": [0, 1, 2, 3]}]}, "bloom": {"level": "understand", "rationale": "Diễn giải, so sánh hoặc giải thích ý nghĩa vật lí.", "review": "reviewed"}, "status": "ready", "notes": ["Phần dẫn và phương án đối chiếu ảnh trang sách; lời giải do người biên soạn kiểm tra.", "Nhãn Bloom là phân loại nội bộ, chưa thẩm định độc lập; mức độ ma trận được rà soát riêng.", "Tách/ghép thành bốn ý cùng chủ đề; lưu vị trí từng ý để đối chiếu nội bộ."], "statements": [{"text": "Hạt nhân nguyên tử trung hòa về điện.", "answer": false, "explanation": "Sai."}, {"text": "Một hệ quả của mẫu nguyên tử Rutherford là tính không bền của nguyên tử do electron mất năng lượng khi chuyển động có gia tốc.", "answer": true, "explanation": "Đúng theo điện động lực học cổ điển."}, {"text": "Hạt nhân nguyên tử được cấu tạo từ proton, neutron và electron.", "answer": false, "explanation": "Sai."}, {"text": "Điện tích dương trong nguyên tử phân bố đều, xen kẽ với các electron nên nguyên tử trung hòa về điện.", "answer": false, "explanation": "Sai."}]}, {"id": "ctst-nuclear-009-tf-2", "kind": "true_false", "topic": "B21", "chapter": "Vật lí hạt nhân", "level": "Thông hiểu", "prompt": "Trong mỗi phát biểu sau, em hãy chọn đúng hoặc sai.", "explanation": "a) Đúng.\nb) Đúng.\nc) Đúng vì e=Z và A=Z+N.\nd) Đúng theo mô hình trạng thái dừng.", "points": 1, "source": {"book": "Sách bài tập Vật lí 12 · Chân trời sáng tạo", "bookId": "ctst", "sequence": 9, "label": "Câu 14.9", "pages": [62], "printedPages": [62], "parts": [{"questionId": "ctst-nuclear-009", "book": "Sách bài tập Vật lí 12 · Chân trời sáng tạo", "bookId": "ctst", "sequence": 9, "label": "Câu 14.9", "pages": [62], "printedPages": [62], "statementIndexes": [4, 5, 6, 7]}]}, "bloom": {"level": "understand", "rationale": "Diễn giải, so sánh hoặc giải thích ý nghĩa vật lí.", "review": "reviewed"}, "status": "ready", "notes": ["Phần dẫn và phương án đối chiếu ảnh trang sách; lời giải do người biên soạn kiểm tra.", "Nhãn Bloom là phân loại nội bộ, chưa thẩm định độc lập; mức độ ma trận được rà soát riêng.", "Tách/ghép thành bốn ý cùng chủ đề; lưu vị trí từng ý để đối chiếu nội bộ."], "statements": [{"text": "Có thể xem khối lượng hạt nhân xấp xỉ bằng khối lượng nguyên tử.", "answer": true, "explanation": "Đúng."}, {"text": "Nguyên tử của đồng vị $^{60}_{27}\\mathrm{Co}$ có 27 proton, 33 neutron và 27 electron.", "answer": true, "explanation": "Đúng."}, {"text": "Khi nguyên tử trung hòa về điện, tổng số electron và neutron bằng số khối của hạt nhân nguyên tử.", "answer": true, "explanation": "Đúng vì e=Z và A=Z+N."}, {"text": "Nguyên tử chỉ tồn tại trong các trạng thái có năng lượng xác định, gọi là các trạng thái dừng. Khi ở trạng thái dừng, nguyên tử không phát xạ.", "answer": true, "explanation": "Đúng theo mô hình trạng thái dừng."}]}, {"id": "ctst-nuclear-010", "kind": "choice", "topic": "B21", "chapter": "Vật lí hạt nhân", "level": "Vận dụng", "prompt": "Biết số Avogadro là $N_A\\approx6{,}022\\times10^{23}\\ \\mathrm{mol}^{-1}$, khối lượng mol của uranium $^{238}_{92}\\mathrm{U}$ là 238 g/mol. Số neutron trong 238 gam $^{238}_{92}\\mathrm{U}$ là", "explanation": "A. $146N_A\\approx8{,}8\\times10^{25}$ neutron.", "points": 1, "source": {"book": "Sách bài tập Vật lí 12 · Chân trời sáng tạo", "bookId": "ctst", "sequence": 10, "label": "Câu 14.10", "pages": [63], "printedPages": [63]}, "bloom": {"level": "apply", "rationale": "Thực hiện quy tắc hoặc phép tính với dữ kiện của bài.", "review": "reviewed"}, "status": "ready", "notes": ["Phần dẫn và phương án đối chiếu ảnh trang sách; lời giải do người biên soạn kiểm tra.", "Nhãn Bloom là phân loại nội bộ, chưa thẩm định độc lập; mức độ ma trận được rà soát riêng."], "options": ["$8{,}8\\times10^{25}$", "$1{,}2\\times10^{25}$", "$4{,}4\\times10^{25}$", "$2{,}2\\times10^{25}$"], "answer": 0}, {"id": "ctst-nuclear-011", "kind": "choice", "topic": "B21", "chapter": "Vật lí hạt nhân", "level": "Vận dụng", "prompt": "Số proton trong 17,5 gam $^{238}_{92}\\mathrm{U}$ là", "explanation": "C. $(17{,}5/238)N_A\\times92\\approx4{,}07\\times10^{24}$ hạt.", "points": 1, "source": {"book": "Sách bài tập Vật lí 12 · Chân trời sáng tạo", "bookId": "ctst", "sequence": 11, "label": "Câu 14.11", "pages": [63], "printedPages": [63]}, "bloom": {"level": "apply", "rationale": "Thực hiện quy tắc hoặc phép tính với dữ kiện của bài.", "review": "reviewed"}, "status": "ready", "notes": ["Phần dẫn và phương án đối chiếu ảnh trang sách; lời giải do người biên soạn kiểm tra.", "Nhãn Bloom là phân loại nội bộ, chưa thẩm định độc lập; mức độ ma trận được rà soát riêng."], "options": ["$3{,}01\\times10^{23}$ hạt.", "$27{,}7\\times10^{24}$ hạt.", "$4{,}07\\times10^{24}$ hạt.", "$7{,}07\\times10^{25}$ hạt."], "answer": 2}, {"id": "ctst-nuclear-012", "kind": "written", "topic": "B21", "chapter": "Vật lí hạt nhân", "level": "Vận dụng", "prompt": "Điền các số liệu còn thiếu vào bảng sau.\nO: số proton 8; số neutron …; số khối 16; kí hiệu hạt nhân …\nK: số proton …; số neutron 20; số khối 39; kí hiệu hạt nhân …\nNa: số proton 11; số neutron 12; số khối …; kí hiệu hạt nhân …", "explanation": "O: 8 neutron, $^{16}_{8}\\mathrm{O}$. K: 19 proton, $^{39}_{19}\\mathrm{K}$. Na: A=23, $^{23}_{11}\\mathrm{Na}$.", "points": 1, "source": {"book": "Sách bài tập Vật lí 12 · Chân trời sáng tạo", "bookId": "ctst", "sequence": 12, "label": "Bài 14.1", "pages": [63], "printedPages": [63]}, "bloom": {"level": "apply", "rationale": "Thực hiện quy tắc hoặc phép tính với dữ kiện của bài.", "review": "reviewed"}, "status": "ready", "notes": ["Phần dẫn và phương án đối chiếu ảnh trang sách; lời giải do người biên soạn kiểm tra.", "Nhãn Bloom là phân loại nội bộ, chưa thẩm định độc lập; mức độ ma trận được rà soát riêng."]}, {"id": "ctst-nuclear-014", "kind": "written", "topic": "B21", "chapter": "Vật lí hạt nhân", "level": "Vận dụng", "prompt": "Tính bán kính của các hạt nhân nguyên tử $^{4}_{2}\\mathrm{He}$, $^{235}_{92}\\mathrm{U}$, $^{56}_{26}\\mathrm{Fe}$, $^{137}_{55}\\mathrm{Cs}$.", "explanation": "Dùng $R=1{,}2A^{1/3}$ fm. Các bán kính lần lượt khoảng 1,90; 7,41; 4,59; 6,19 fm.", "points": 1, "source": {"book": "Sách bài tập Vật lí 12 · Chân trời sáng tạo", "bookId": "ctst", "sequence": 14, "label": "Bài 14.3", "pages": [64], "printedPages": [64]}, "bloom": {"level": "apply", "rationale": "Thực hiện quy tắc hoặc phép tính với dữ kiện của bài.", "review": "reviewed"}, "status": "ready", "notes": ["Phần dẫn và phương án đối chiếu ảnh trang sách; lời giải do người biên soạn kiểm tra.", "Nhãn Bloom là phân loại nội bộ, chưa thẩm định độc lập; mức độ ma trận được rà soát riêng."]}, {"id": "ctst-nuclear-015", "kind": "numeric", "topic": "B21", "chapter": "Vật lí hạt nhân", "level": "Vận dụng", "prompt": "Giả sử hạt nhân nguyên tử có dạng hình cầu. Hỏi thể tích hạt nhân $^{56}_{26}\\mathrm{Fe}$ gấp bao nhiêu lần thể tích hạt nhân $^{3}_{1}\\mathrm{T}$?", "explanation": "$56/3\\approx18{,}7$ lần. Vì $V\\propto R^3\\propto A$.", "points": 1, "source": {"book": "Sách bài tập Vật lí 12 · Chân trời sáng tạo", "bookId": "ctst", "sequence": 15, "label": "Bài 14.4", "pages": [64], "printedPages": [64]}, "bloom": {"level": "apply", "rationale": "Thực hiện quy tắc hoặc phép tính với dữ kiện của bài.", "review": "reviewed"}, "status": "ready", "notes": ["Phần dẫn và phương án đối chiếu ảnh trang sách; lời giải do người biên soạn kiểm tra.", "Nhãn Bloom là phân loại nội bộ, chưa thẩm định độc lập; mức độ ma trận được rà soát riêng."], "answerText": "$56/3\\approx18{,}7$ lần. Vì $V\\propto R^3\\propto A$."}, {"id": "ctst-nuclear-016", "kind": "written", "topic": "B21", "chapter": "Vật lí hạt nhân", "level": "Vận dụng", "prompt": "Nêu cấu tạo nguyên tử và viết kí hiệu hạt nhân của các nguyên tử trong các trường hợp sau: a) Carbon; b) Aluminium; c) Nitrogen; d) Silicon (xem hình).", "explanation": "a) 6 proton, 6 neutron, 6 electron: $^{12}_{6}\\mathrm{C}$. b) 13 proton, 14 neutron, 13 electron: $^{27}_{13}\\mathrm{Al}$. c) 7 proton, 7 neutron, 7 electron: $^{14}_{7}\\mathrm{N}$. d) 14 proton, 14 neutron, 14 electron: $^{28}_{14}\\mathrm{Si}$.", "points": 1, "source": {"book": "Sách bài tập Vật lí 12 · Chân trời sáng tạo", "bookId": "ctst", "sequence": 16, "label": "Bài 14.5", "pages": [64], "printedPages": [64]}, "bloom": {"level": "apply", "rationale": "Thực hiện quy tắc hoặc phép tính với dữ kiện của bài.", "review": "reviewed"}, "status": "ready", "notes": ["Phần dẫn và phương án đối chiếu ảnh trang sách; lời giải do người biên soạn kiểm tra.", "Nhãn Bloom là phân loại nội bộ, chưa thẩm định độc lập; mức độ ma trận được rà soát riêng."], "figure": {"url": "/api/book-bank/asset?file=ctst%2Fverified-figures%2Fbai-14-5.png", "description": "Hình minh họa của bài", "origin": "source_crop"}}, {"id": "ctst-nuclear-017", "kind": "choice", "topic": "B22", "chapter": "Vật lí hạt nhân", "level": "Nhận biết", "prompt": "Chọn cụm từ phù hợp để hoàn thành nhận định sau: “Khối lượng của một hạt nhân bất kì … tổng khối lượng của các nucleon riêng lẻ cấu tạo thành hạt nhân đó”.", "explanation": "C. Khối lượng giảm do năng lượng liên kết đối với hạt nhân liên kết.", "points": 1, "source": {"book": "Sách bài tập Vật lí 12 · Chân trời sáng tạo", "bookId": "ctst", "sequence": 17, "label": "Câu 15.1", "pages": [65], "printedPages": [65]}, "bloom": {"level": "remember", "rationale": "Nhớ lại định nghĩa, tính chất hoặc quy tắc đã học.", "review": "reviewed"}, "status": "ready", "notes": ["Phần dẫn và phương án đối chiếu ảnh trang sách; lời giải do người biên soạn kiểm tra.", "Nhãn Bloom là phân loại nội bộ, chưa thẩm định độc lập; mức độ ma trận được rà soát riêng."], "options": ["luôn lớn hơn", "luôn bằng", "luôn nhỏ hơn", "có lúc lớn hơn, có lúc nhỏ hơn"], "answer": 2}, {"id": "ctst-nuclear-018", "kind": "choice", "topic": "B22", "chapter": "Vật lí hạt nhân", "level": "Nhận biết", "prompt": "Độ hụt khối của một hạt nhân $^{A}_{Z}\\mathrm{X}$", "explanation": "B. $\\Delta m=Zm_p+(A-Z)m_n-m_X$.", "points": 1, "source": {"book": "Sách bài tập Vật lí 12 · Chân trời sáng tạo", "bookId": "ctst", "sequence": 18, "label": "Câu 15.2", "pages": [65], "printedPages": [65]}, "bloom": {"level": "remember", "rationale": "Nhớ lại định nghĩa, tính chất hoặc quy tắc đã học.", "review": "reviewed"}, "status": "ready", "notes": ["Phần dẫn và phương án đối chiếu ảnh trang sách; lời giải do người biên soạn kiểm tra.", "Nhãn Bloom là phân loại nội bộ, chưa thẩm định độc lập; mức độ ma trận được rà soát riêng."], "options": ["là đại lượng đặc trưng cho mức độ bền vững của hạt nhân.", "được xác định bằng biểu thức $\\Delta m=[Zm_p+(A-Z)m_n]-m_X$.", "càng lớn khi số khối của hạt nhân càng lớn.", "là đại lượng đặc trưng cho mức độ phổ biến của hạt nhân."], "answer": 1}, {"id": "ctst-nuclear-019", "kind": "choice", "topic": "B22", "chapter": "Vật lí hạt nhân", "level": "Thông hiểu", "prompt": "Chỉ ra phát biểu sai.", "explanation": "D. Không phải khối lượng mọi hạt nhân đều lớn hơn A amu.", "points": 1, "source": {"book": "Sách bài tập Vật lí 12 · Chân trời sáng tạo", "bookId": "ctst", "sequence": 19, "label": "Câu 15.3", "pages": [65], "printedPages": [65]}, "bloom": {"level": "understand", "rationale": "Diễn giải, so sánh hoặc giải thích ý nghĩa vật lí.", "review": "reviewed"}, "status": "ready", "notes": ["Phần dẫn và phương án đối chiếu ảnh trang sách; lời giải do người biên soạn kiểm tra.", "Nhãn Bloom là phân loại nội bộ, chưa thẩm định độc lập; mức độ ma trận được rà soát riêng."], "options": ["Hệ thức Einstein về mối liên hệ giữa năng lượng và khối lượng là $E=mc^2$.", "Khối lượng nghỉ là khối lượng của một vật khi ở trạng thái nghỉ.", "Khối lượng của một nguyên tử có giá trị gần bằng khối lượng của hạt nhân nguyên tử đó.", "Một hạt nhân có số khối A thì khối lượng của nó luôn lớn hơn A (amu)."], "answer": 3}, {"id": "ctst-nuclear-020", "kind": "choice", "topic": "B22", "chapter": "Vật lí hạt nhân", "level": "Thông hiểu", "prompt": "Nhận định nào sau đây sai khi nói về lực hạt nhân?", "explanation": "A. Lực hạt nhân là tương tác mạnh còn dư, không phải lực hấp dẫn.", "points": 1, "source": {"book": "Sách bài tập Vật lí 12 · Chân trời sáng tạo", "bookId": "ctst", "sequence": 20, "label": "Câu 15.4", "pages": [65], "printedPages": [65]}, "bloom": {"level": "understand", "rationale": "Diễn giải, so sánh hoặc giải thích ý nghĩa vật lí.", "review": "reviewed"}, "status": "ready", "notes": ["Phần dẫn và phương án đối chiếu ảnh trang sách; lời giải do người biên soạn kiểm tra.", "Nhãn Bloom là phân loại nội bộ, chưa thẩm định độc lập; mức độ ma trận được rà soát riêng."], "options": ["Lực hạt nhân có bản chất là lực hấp dẫn vì nó giúp kết nối các nucleon lại với nhau.", "Lực hạt nhân có bản chất là lực tương tác mạnh.", "Lực hạt nhân có cường độ lớn hơn nhiều lần so với cường độ của lực tĩnh điện.", "Lực hạt nhân có phạm vi tác dụng trong bán kính hạt nhân."], "answer": 0}, {"id": "ctst-nuclear-021", "kind": "choice", "topic": "B22", "chapter": "Vật lí hạt nhân", "level": "Thông hiểu", "prompt": "Đồ thị nào dưới đây mô tả gần đúng mối liên hệ giữa năng lượng liên kết riêng ($E_{lkr}$) với số nucleon (A)?", "explanation": "D. Đồ thị tăng nhanh ở hạt nhân nhẹ, đạt đỉnh vùng khối trung bình rồi giảm chậm ở hạt nhân nặng.", "points": 1, "source": {"book": "Sách bài tập Vật lí 12 · Chân trời sáng tạo", "bookId": "ctst", "sequence": 21, "label": "Câu 15.5", "pages": [66], "printedPages": [66]}, "bloom": {"level": "understand", "rationale": "Diễn giải, so sánh hoặc giải thích ý nghĩa vật lí.", "review": "reviewed"}, "status": "ready", "notes": ["Phần dẫn và phương án đối chiếu ảnh trang sách; lời giải do người biên soạn kiểm tra.", "Nhãn Bloom là phân loại nội bộ, chưa thẩm định độc lập; mức độ ma trận được rà soát riêng."], "options": ["Đồ thị A.", "Đồ thị B.", "Đồ thị C.", "Đồ thị D."], "answer": 3, "figure": {"url": "/api/book-bank/asset?file=ctst%2Fverified-figures%2Fcau-15-5.png", "description": "Hình minh họa của bài", "origin": "source_crop"}}, {"id": "ctst-nuclear-022", "kind": "choice", "topic": "B22", "chapter": "Vật lí hạt nhân", "level": "Vận dụng", "prompt": "Các hạt nhân $^{12}_{6}\\mathrm{C}$, $^{16}_{8}\\mathrm{O}$, $^{4}_{2}\\mathrm{He}$ có năng lượng liên kết lần lượt là 92,16 MeV; 127,6 MeV; 28,3 MeV. Thứ tự giảm dần về mức độ bền vững của hạt nhân là:", "explanation": "B. Năng lượng liên kết riêng O: 7,975; C: 7,68; He: 7,075 MeV/nucleon.", "points": 1, "source": {"book": "Sách bài tập Vật lí 12 · Chân trời sáng tạo", "bookId": "ctst", "sequence": 22, "label": "Câu 15.6", "pages": [66], "printedPages": [66]}, "bloom": {"level": "apply", "rationale": "Thực hiện quy tắc hoặc phép tính với dữ kiện của bài.", "review": "reviewed"}, "status": "ready", "notes": ["Phần dẫn và phương án đối chiếu ảnh trang sách; lời giải do người biên soạn kiểm tra.", "Nhãn Bloom là phân loại nội bộ, chưa thẩm định độc lập; mức độ ma trận được rà soát riêng."], "options": ["$^{4}_{2}\\mathrm{He},{}^{16}_{8}\\mathrm{O},{}^{12}_{6}\\mathrm{C}$", "$^{16}_{8}\\mathrm{O},{}^{12}_{6}\\mathrm{C},{}^{4}_{2}\\mathrm{He}$", "$^{12}_{6}\\mathrm{C},{}^{4}_{2}\\mathrm{He},{}^{16}_{8}\\mathrm{O}$", "$^{4}_{2}\\mathrm{He},{}^{12}_{6}\\mathrm{C},{}^{16}_{8}\\mathrm{O}$"], "answer": 1}, {"id": "ctst-nuclear-023", "kind": "true_false", "topic": "B22", "chapter": "Vật lí hạt nhân", "level": "Vận dụng", "prompt": "Cho khối lượng của proton, neutron, hạt nhân $^{42}_{20}\\mathrm{Ca}$, hạt nhân $^{43}_{20}\\mathrm{Ca}$ lần lượt là $m_p=1{,}007276$ amu, $m_n=1{,}008665$ amu, $m_{Ca42}=41{,}958622$ amu, $m_{Ca43}=42{,}958770$ amu. Trong mỗi phát biểu sau, em hãy chọn đúng hoặc sai.", "explanation": "$\\Delta m_{42}=0{,}377528$ amu; $\\Delta m_{43}=0{,}386045$ amu; chênh năng lượng liên kết khoảng 7,934 MeV. Năng lượng liên kết riêng Ca-42 khoảng 8,373 MeV/nucleon, Ca-43 khoảng 8,363.", "points": 1, "source": {"book": "Sách bài tập Vật lí 12 · Chân trời sáng tạo", "bookId": "ctst", "sequence": 23, "label": "Câu 15.7", "pages": [66], "printedPages": [66]}, "bloom": {"level": "apply", "rationale": "Thực hiện quy tắc hoặc phép tính với dữ kiện của bài.", "review": "reviewed"}, "status": "ready", "notes": ["Phần dẫn và phương án đối chiếu ảnh trang sách; lời giải do người biên soạn kiểm tra.", "Nhãn Bloom là phân loại nội bộ, chưa thẩm định độc lập; mức độ ma trận được rà soát riêng."], "statements": [{"text": "$^{43}_{20}\\mathrm{Ca}$ và $^{42}_{20}\\mathrm{Ca}$ đều là đồng vị của $^{40}_{20}\\mathrm{Ca}$.", "answer": true}, {"text": "Độ hụt khối của $^{43}_{20}\\mathrm{Ca}$ lớn hơn độ hụt khối của $^{42}_{20}\\mathrm{Ca}$.", "answer": true}, {"text": "Năng lượng liên kết của $^{43}_{20}\\mathrm{Ca}$ lớn hơn năng lượng liên kết của $^{42}_{20}\\mathrm{Ca}$ một lượng 9,73 MeV.", "answer": false}, {"text": "Hạt nhân $^{43}_{20}\\mathrm{Ca}$ kém bền vững hơn hạt nhân $^{42}_{20}\\mathrm{Ca}$.", "answer": true}]}, {"id": "ctst-nuclear-024", "kind": "choice", "topic": "B22", "chapter": "Vật lí hạt nhân", "level": "Vận dụng", "prompt": "Cho các hạt nhân $^{238}_{92}\\mathrm{U}$, $^{235}_{92}\\mathrm{U}$, $^{23}_{11}\\mathrm{Na}$, $^{197}_{79}\\mathrm{Au}$. Sắp xếp theo mức độ bền vững tăng dần, biết khối lượng các hạt nhân lần lượt 238,050788; 234,993422; 22,983730; 196,966552 amu; $m_p=1{,}007276$ amu, $m_n=1{,}008665$ amu.", "explanation": "C. Tính $E_{lkr}=[Zm_p+(A-Z)m_n-m]931{,}5/A$, lần lượt khoảng 7,37; 7,59; 8,11; 7,71 MeV/nucleon.", "points": 1, "source": {"book": "Sách bài tập Vật lí 12 · Chân trời sáng tạo", "bookId": "ctst", "sequence": 24, "label": "Câu 15.8", "pages": [67], "printedPages": [67]}, "bloom": {"level": "apply", "rationale": "Thực hiện quy tắc hoặc phép tính với dữ kiện của bài.", "review": "reviewed"}, "status": "ready", "notes": ["Phần dẫn và phương án đối chiếu ảnh trang sách; lời giải do người biên soạn kiểm tra.", "Nhãn Bloom là phân loại nội bộ, chưa thẩm định độc lập; mức độ ma trận được rà soát riêng."], "options": ["$^{23}_{11}\\mathrm{Na},{}^{197}_{79}\\mathrm{Au},{}^{235}_{92}\\mathrm{U},{}^{238}_{92}\\mathrm{U}$", "$^{238}_{92}\\mathrm{U},{}^{235}_{92}\\mathrm{U},{}^{23}_{11}\\mathrm{Na},{}^{197}_{79}\\mathrm{Au}$", "$^{238}_{92}\\mathrm{U},{}^{235}_{92}\\mathrm{U},{}^{197}_{79}\\mathrm{Au},{}^{23}_{11}\\mathrm{Na}$", "$^{23}_{11}\\mathrm{Na},{}^{197}_{79}\\mathrm{Au},{}^{238}_{92}\\mathrm{U},{}^{235}_{92}\\mathrm{U}$"], "answer": 2}, {"id": "ctst-nuclear-025", "kind": "choice", "topic": "B22", "chapter": "Vật lí hạt nhân", "level": "Vận dụng", "prompt": "Cho khối lượng proton, neutron, hạt nhân $^{3}_{1}\\mathrm{T}$ và $^{244}_{95}\\mathrm{Am}$ lần lượt 1,007276; 1,008665; 3,016049; 244,064279 amu. Nhận xét nào sau đây đúng?", "explanation": "B. Độ hụt khối T=0,008557 amu; Am=1,918026 amu.", "points": 1, "source": {"book": "Sách bài tập Vật lí 12 · Chân trời sáng tạo", "bookId": "ctst", "sequence": 25, "label": "Câu 15.9", "pages": [67], "printedPages": [67]}, "bloom": {"level": "apply", "rationale": "Thực hiện quy tắc hoặc phép tính với dữ kiện của bài.", "review": "reviewed"}, "status": "ready", "notes": ["Phần dẫn và phương án đối chiếu ảnh trang sách; lời giải do người biên soạn kiểm tra.", "Nhãn Bloom là phân loại nội bộ, chưa thẩm định độc lập; mức độ ma trận được rà soát riêng."], "options": ["Hai hạt nhân này có độ hụt khối bằng nhau.", "Năng lượng liên kết của $^{244}_{95}\\mathrm{Am}$ lớn hơn năng lượng liên kết của $^{3}_{1}\\mathrm{T}$.", "Năng lượng liên kết riêng của $^{244}_{95}\\mathrm{Am}$ nhỏ hơn năng lượng liên kết riêng của $^{3}_{1}\\mathrm{T}$.", "Mức độ bền vững của hai hạt nhân $^{3}_{1}\\mathrm{T}$ và $^{244}_{95}\\mathrm{Am}$ là bằng nhau."], "answer": 1}, {"id": "ctst-nuclear-026", "kind": "numeric", "topic": "B22", "chapter": "Vật lí hạt nhân", "level": "Vận dụng", "prompt": "Tính năng lượng liên kết của $^{27}_{13}\\mathrm{Al}$, biết khối lượng của hạt nhân $^{27}_{13}\\mathrm{Al}$, proton và neutron lần lượt $m_{Al}=26{,}97435$ amu, $m_p=1{,}00728$ amu, $m_n=1{,}00867$ amu.", "explanation": "$225{,}116$ MeV.\n$\\Delta m=0{,}24167$ amu; $E_{lk}=\\Delta mc^2=0{,}24167\\times931{,}5$.", "points": 1, "source": {"book": "Sách bài tập Vật lí 12 · Chân trời sáng tạo", "bookId": "ctst", "sequence": 26, "label": "Bài 15.1", "pages": [67], "printedPages": [67]}, "bloom": {"level": "apply", "rationale": "Thực hiện quy tắc hoặc phép tính với dữ kiện của bài.", "review": "reviewed"}, "status": "ready", "notes": ["Phần dẫn và phương án đối chiếu ảnh trang sách; lời giải do người biên soạn kiểm tra.", "Nhãn Bloom là phân loại nội bộ, chưa thẩm định độc lập; mức độ ma trận được rà soát riêng."], "answerText": "$225{,}116$ MeV."}, {"id": "ctst-nuclear-027", "kind": "numeric", "topic": "B22", "chapter": "Vật lí hạt nhân", "level": "Vận dụng", "prompt": "Tính năng lượng liên kết riêng của $^{30}_{15}\\mathrm{P}$, biết khối lượng của hạt nhân $^{30}_{15}\\mathrm{P}$, proton và neutron lần lượt $m_P=29{,}97005$ amu, $m_p=1{,}00728$ amu, $m_n=1{,}00867$ amu.", "explanation": "$8{,}35866$ MeV/nucleon.\n$\\Delta m=0{,}26920$ amu; $E_{lkr}=0{,}26920\\times931{,}5/30$.", "points": 1, "source": {"book": "Sách bài tập Vật lí 12 · Chân trời sáng tạo", "bookId": "ctst", "sequence": 27, "label": "Bài 15.2", "pages": [67], "printedPages": [67]}, "bloom": {"level": "apply", "rationale": "Thực hiện quy tắc hoặc phép tính với dữ kiện của bài.", "review": "reviewed"}, "status": "ready", "notes": ["Phần dẫn và phương án đối chiếu ảnh trang sách; lời giải do người biên soạn kiểm tra.", "Nhãn Bloom là phân loại nội bộ, chưa thẩm định độc lập; mức độ ma trận được rà soát riêng."], "answerText": "$8{,}35866$ MeV/nucleon."}, {"id": "ctst-nuclear-028", "kind": "written", "topic": "B22", "chapter": "Vật lí hạt nhân", "level": "Vận dụng", "prompt": "Hình 15.1 cho thấy sự phụ thuộc của năng lượng liên kết riêng theo số khối ở một số hạt nhân. Dựa vào Hình 15.1, sắp xếp mức độ bền vững theo thứ tự giảm dần của $^{126}_{52}\\mathrm{Te}$, $^{238}_{92}\\mathrm{U}$, $^{180}_{72}\\mathrm{Hf}$, $^{56}_{26}\\mathrm{Fe}$, $^{209}_{83}\\mathrm{Bi}$, $^{110}_{48}\\mathrm{Cd}$. Từ đó, nhận xét tính bền vững của các hạt nhân khối lượng lớn (từ sau Fe) theo chiều tăng dần số khối.", "explanation": "Fe, Cd, Te, Hf, Bi, U. Theo các điểm trong hình, từ vùng Fe, năng lượng liên kết riêng có xu hướng giảm khi A tăng; không dùng độ phổ biến tự nhiên làm tiêu chí độ bền.", "points": 1, "source": {"book": "Sách bài tập Vật lí 12 · Chân trời sáng tạo", "bookId": "ctst", "sequence": 28, "label": "Bài 15.3", "pages": [67], "printedPages": [67]}, "bloom": {"level": "analyze", "rationale": "Phân tách thông tin và liên hệ các thành phần để tìm kết quả.", "review": "reviewed"}, "status": "ready", "notes": ["Phần dẫn và phương án đối chiếu ảnh trang sách; lời giải do người biên soạn kiểm tra.", "Nhãn Bloom là phân loại nội bộ, chưa thẩm định độc lập; mức độ ma trận được rà soát riêng."], "figure": {"url": "/api/book-bank/asset?file=ctst%2Fverified-figures%2Fhinh-15-1.png", "description": "Hình minh họa của bài", "origin": "source_crop"}}, {"id": "ctst-nuclear-029", "kind": "numeric", "topic": "B22", "chapter": "Vật lí hạt nhân", "level": "Vận dụng", "prompt": "Hạt nhân $^{56}_{26}\\mathrm{Fe}$ là một trong những hạt nhân bền vững nhất trong tự nhiên (độ phổ biến 91,754% trữ lượng các đồng vị sắt), trong khi hạt nhân nhẹ deuteri $^{2}_{1}\\mathrm{D}$ lại kém bền (độ phổ biến khoảng 0,015% trữ lượng các đồng vị hydrogen). Năng lượng liên kết riêng của Fe lớn hơn D bao nhiêu lần? Cho $m_{Fe}=55{,}93494$ amu, $m_D=2{,}01355$ amu, $m_p=1{,}00728$ amu, $m_n=1{,}00867$ amu.", "explanation": "Khoảng $7{,}66$ lần.\nDùng độ hụt khối, chia năng lượng liên kết cho A; Fe≈8,55716; D≈1,11780 MeV/nucleon. Độ phổ biến không phải nguyên nhân hay thước đo duy nhất của độ bền.", "points": 1, "source": {"book": "Sách bài tập Vật lí 12 · Chân trời sáng tạo", "bookId": "ctst", "sequence": 29, "label": "Bài 15.4", "pages": [68], "printedPages": [68]}, "bloom": {"level": "apply", "rationale": "Thực hiện quy tắc hoặc phép tính với dữ kiện của bài.", "review": "reviewed"}, "status": "ready", "notes": ["Phần dẫn và phương án đối chiếu ảnh trang sách; lời giải do người biên soạn kiểm tra.", "Nhãn Bloom là phân loại nội bộ, chưa thẩm định độc lập; mức độ ma trận được rà soát riêng."], "answerText": "Khoảng $7{,}66$ lần."}, {"id": "ctst-nuclear-030", "kind": "written", "topic": "B22", "chapter": "Vật lí hạt nhân", "level": "Vận dụng", "prompt": "Xét hai hạt nhân X và Y: số proton X bằng số neutron Y và ngược lại, được gọi là cặp hạt nhân gương. Xét $^{23}_{12}\\mathrm{Mg}$ và $^{23}_{11}\\mathrm{Na}$ có khối lượng lần lượt $m_{Mg}=22{,}99413$ amu, $m_{Na}=22{,}98373$ amu. Hạt nhân nào có năng lượng liên kết lớn hơn và lớn hơn bao nhiêu MeV? Biết $m_p=1{,}00728$ amu, $m_n=1{,}00867$ amu.", "explanation": "Na lớn hơn khoảng $10{,}982385$ MeV. $E_{Mg}=175{,}650465$ MeV; $E_{Na}=186{,}632850$ MeV.", "points": 1, "source": {"book": "Sách bài tập Vật lí 12 · Chân trời sáng tạo", "bookId": "ctst", "sequence": 30, "label": "Bài 15.5", "pages": [68], "printedPages": [68]}, "bloom": {"level": "apply", "rationale": "Thực hiện quy tắc hoặc phép tính với dữ kiện của bài.", "review": "reviewed"}, "status": "ready", "notes": ["Phần dẫn và phương án đối chiếu ảnh trang sách; lời giải do người biên soạn kiểm tra.", "Nhãn Bloom là phân loại nội bộ, chưa thẩm định độc lập; mức độ ma trận được rà soát riêng."]}, {"id": "ctst-nuclear-031", "kind": "numeric", "topic": "B22", "chapter": "Vật lí hạt nhân", "level": "Vận dụng", "prompt": "Cần bắn photon có năng lượng tối thiểu bằng bao nhiêu vào hạt nhân deuteri $^{2}_{1}\\mathrm{D}$ (một neutron và một proton) để phân tách thành một neutron và một proton riêng rẽ? Biết $m_D=2{,}01355$ amu, $m_p=1{,}00728$ amu, $m_n=1{,}00867$ amu.", "explanation": "$2{,}2356$ MeV theo mô hình bỏ qua giật lùi của bài.\n$\\Delta m=0{,}00240$ amu; $E_{lk}=\\Delta mc^2$.", "points": 1, "source": {"book": "Sách bài tập Vật lí 12 · Chân trời sáng tạo", "bookId": "ctst", "sequence": 31, "label": "Bài 15.6", "pages": [69], "printedPages": [69]}, "bloom": {"level": "apply", "rationale": "Thực hiện quy tắc hoặc phép tính với dữ kiện của bài.", "review": "reviewed"}, "status": "ready", "notes": ["Phần dẫn và phương án đối chiếu ảnh trang sách; lời giải do người biên soạn kiểm tra.", "Nhãn Bloom là phân loại nội bộ, chưa thẩm định độc lập; mức độ ma trận được rà soát riêng."], "answerText": "$2{,}2356$ MeV theo mô hình bỏ qua giật lùi của bài."}, {"id": "ctst-nuclear-032", "kind": "written", "topic": "B22", "chapter": "Vật lí hạt nhân", "level": "Vận dụng", "prompt": "Bắn photon năng lượng 3,6 MeV vào hạt nhân deuteri $^{2}_{1}\\mathrm{D}$ để phân tách thành neutron và proton riêng rẽ. Ngoài phân tách, photon còn cung cấp động năng ban đầu. Xác định động lượng proton và neutron nếu giả sử động năng sau phân tách bằng nhau. Lấy $m_D=2{,}01355$ amu, $m_p=1{,}00728$ amu, $m_n=1{,}00867$ amu.", "explanation": "Mỗi hạt có K=(3,6−2,2356)/2=0,6822 MeV. Dùng $p=\\sqrt{2mc^2K}/c$ với $mc^2$ đổi từ amu sang MeV: proton≈35,78 MeV/c; neutron≈35,80 MeV/c. Đáp án cuối sách thiếu hệ số đổi amu và có sai đơn vị; không sao chép sai số ấy.", "points": 1, "source": {"book": "Sách bài tập Vật lí 12 · Chân trời sáng tạo", "bookId": "ctst", "sequence": 32, "label": "Bài 15.7", "pages": [69], "printedPages": [69]}, "bloom": {"level": "apply", "rationale": "Thực hiện quy tắc hoặc phép tính với dữ kiện của bài.", "review": "reviewed"}, "status": "ready", "notes": ["Phần dẫn và phương án đối chiếu ảnh trang sách; lời giải do người biên soạn kiểm tra.", "Nhãn Bloom là phân loại nội bộ, chưa thẩm định độc lập; mức độ ma trận được rà soát riêng."]}, {"id": "ctst-nuclear-033", "kind": "choice", "topic": "B22", "chapter": "Vật lí hạt nhân", "level": "Vận dụng", "prompt": "Cho phản ứng hạt nhân: $^{19}_{9}\\mathrm{F}+{}^{1}_{1}\\mathrm{H}\\to{}^{16}_{8}\\mathrm{O}+X$. X là hạt", "explanation": "A. X có A=4, Z=2, là alpha.", "points": 1, "source": {"book": "Sách bài tập Vật lí 12 · Chân trời sáng tạo", "bookId": "ctst", "sequence": 33, "label": "Câu 16.1", "pages": [69], "printedPages": [69]}, "bloom": {"level": "apply", "rationale": "Thực hiện quy tắc hoặc phép tính với dữ kiện của bài.", "review": "reviewed"}, "status": "ready", "notes": ["Phần dẫn và phương án đối chiếu ảnh trang sách; lời giải do người biên soạn kiểm tra.", "Nhãn Bloom là phân loại nội bộ, chưa thẩm định độc lập; mức độ ma trận được rà soát riêng."], "options": ["alpha.", "neutron.", "deuteri.", "proton."], "answer": 0}, {"id": "ctst-nuclear-035", "kind": "choice", "topic": "B22", "chapter": "Vật lí hạt nhân", "level": "Thông hiểu", "prompt": "Trong các phát biểu sau về phản ứng phân hạch và phản ứng nhiệt hạch, có bao nhiêu phát biểu đúng?\n(1) Đều là phản ứng hạt nhân tỏa năng lượng.\n(2) Đều là hiện tượng một hạt nhân nặng vỡ ra thành các hạt nhân nhẹ hơn.\n(3) Đều là phản ứng tổng hợp hạt nhân.\n(4) Đều xảy ra sự biến đổi hạt nhân.", "explanation": "B. (1), (4) đúng theo các phản ứng năng lượng được xét trong sách.", "points": 1, "source": {"book": "Sách bài tập Vật lí 12 · Chân trời sáng tạo", "bookId": "ctst", "sequence": 35, "label": "Câu 16.3", "pages": [69], "printedPages": [69]}, "bloom": {"level": "understand", "rationale": "Diễn giải, so sánh hoặc giải thích ý nghĩa vật lí.", "review": "reviewed"}, "status": "ready", "notes": ["Phần dẫn và phương án đối chiếu ảnh trang sách; lời giải do người biên soạn kiểm tra.", "Nhãn Bloom là phân loại nội bộ, chưa thẩm định độc lập; mức độ ma trận được rà soát riêng."], "options": ["1.", "2.", "3.", "4."], "answer": 1}, {"id": "ctst-nuclear-036", "kind": "choice", "topic": "B22", "chapter": "Vật lí hạt nhân", "level": "Nhận biết", "prompt": "Trong một phản ứng hạt nhân, luôn có sự bảo toàn", "explanation": "B. Tổng số nucleon được bảo toàn trong các phản ứng ở phạm vi SGK.", "points": 1, "source": {"book": "Sách bài tập Vật lí 12 · Chân trời sáng tạo", "bookId": "ctst", "sequence": 36, "label": "Câu 16.4", "pages": [70], "printedPages": [70]}, "bloom": {"level": "remember", "rationale": "Nhớ lại định nghĩa, tính chất hoặc quy tắc đã học.", "review": "reviewed"}, "status": "ready", "notes": ["Phần dẫn và phương án đối chiếu ảnh trang sách; lời giải do người biên soạn kiểm tra.", "Nhãn Bloom là phân loại nội bộ, chưa thẩm định độc lập; mức độ ma trận được rà soát riêng."], "options": ["số proton.", "số nucleon.", "số neutron.", "khối lượng."], "answer": 1}, {"id": "ctst-nuclear-037", "kind": "choice", "topic": "B22", "chapter": "Vật lí hạt nhân", "level": "Vận dụng", "prompt": "Hạt nhân $^{234}_{92}\\mathrm{U}$ phát ra hạt $^{4}_{2}\\alpha$ và biến đổi thành hạt nhân mới, phương trình phản ứng của quá trình này có dạng:", "explanation": "B. Bảo toàn A: 234=4+230, Z: 92=2+90.", "points": 1, "source": {"book": "Sách bài tập Vật lí 12 · Chân trời sáng tạo", "bookId": "ctst", "sequence": 37, "label": "Câu 16.5", "pages": [70], "printedPages": [70]}, "bloom": {"level": "apply", "rationale": "Thực hiện quy tắc hoặc phép tính với dữ kiện của bài.", "review": "reviewed"}, "status": "ready", "notes": ["Phần dẫn và phương án đối chiếu ảnh trang sách; lời giải do người biên soạn kiểm tra.", "Nhãn Bloom là phân loại nội bộ, chưa thẩm định độc lập; mức độ ma trận được rà soát riêng."], "options": ["$^{234}_{92}\\mathrm{U}\\to{}^{4}_{2}\\alpha+{}^{232}_{90}\\mathrm{U}$", "$^{234}_{92}\\mathrm{U}\\to{}^{4}_{2}\\alpha+{}^{230}_{90}\\mathrm{Th}$", "$^{234}_{92}\\mathrm{U}\\to{}^{4}_{2}\\alpha+{}^{230}_{88}\\mathrm{Th}$", "$^{234}_{92}\\mathrm{U}\\to{}^{4}_{2}\\alpha+{}^{230}_{90}\\mathrm{U}$"], "answer": 1}, {"id": "ctst-nuclear-038", "kind": "choice", "topic": "B22", "chapter": "Vật lí hạt nhân", "level": "Vận dụng", "prompt": "Một trong các phản ứng xảy ra trong lò phản ứng là $^{1}_{0}\\mathrm{n}+{}^{235}_{92}\\mathrm{U}\\to{}^{236}_{92}\\mathrm{U}\\to{}^{143}_{57}\\mathrm{La}+{}^{87}_{35}\\mathrm{Br}+y({}^{1}_{0}\\mathrm{n})$ với y là số neutron. Giá trị y bằng", "explanation": "B. $y=236-143-87=6$.", "points": 1, "source": {"book": "Sách bài tập Vật lí 12 · Chân trời sáng tạo", "bookId": "ctst", "sequence": 38, "label": "Câu 16.6", "pages": [70], "printedPages": [70]}, "bloom": {"level": "apply", "rationale": "Thực hiện quy tắc hoặc phép tính với dữ kiện của bài.", "review": "reviewed"}, "status": "ready", "notes": ["Phần dẫn và phương án đối chiếu ảnh trang sách; lời giải do người biên soạn kiểm tra.", "Nhãn Bloom là phân loại nội bộ, chưa thẩm định độc lập; mức độ ma trận được rà soát riêng."], "options": ["4.", "6.", "8.", "10."], "answer": 1}, {"id": "ctst-nuclear-039-tf-1", "kind": "true_false", "topic": "B22", "chapter": "Vật lí hạt nhân", "level": "Thông hiểu", "prompt": "Trong mỗi phát biểu sau, em hãy chọn đúng hoặc sai.", "explanation": "a) Sai vì proton/neutron có thể chuyển hóa.\nb) Đúng: X có A=140,Z=54,N=86.\nc) Sai: 17,6 MeV là năng lượng tỏa.\nd) Đúng.", "points": 1, "source": {"book": "Sách bài tập Vật lí 12 · Chân trời sáng tạo", "bookId": "ctst", "sequence": 39, "label": "Câu 16.7", "pages": [70], "printedPages": [70], "parts": [{"questionId": "ctst-nuclear-039", "book": "Sách bài tập Vật lí 12 · Chân trời sáng tạo", "bookId": "ctst", "sequence": 39, "label": "Câu 16.7", "pages": [70], "printedPages": [70], "statementIndexes": [0, 1, 2, 3]}]}, "bloom": {"level": "understand", "rationale": "Diễn giải, so sánh hoặc giải thích ý nghĩa vật lí.", "review": "reviewed"}, "status": "ready", "notes": ["Phần dẫn và phương án đối chiếu ảnh trang sách; lời giải do người biên soạn kiểm tra.", "Nhãn Bloom là phân loại nội bộ, chưa thẩm định độc lập; mức độ ma trận được rà soát riêng.", "Tách/ghép thành bốn ý cùng chủ đề; lưu vị trí từng ý để đối chiếu nội bộ."], "statements": [{"text": "Trong các phản ứng hạt nhân, điện tích và số khối được bảo toàn nên số neutron cũng được bảo toàn.", "answer": false, "explanation": "Sai vì proton/neutron có thể chuyển hóa."}, {"text": "Cho phản ứng $^{1}_{0}\\mathrm{n}+{}^{235}_{92}\\mathrm{U}\\to{}^{94}_{38}\\mathrm{Sr}+X+2{}^{1}_{0}\\mathrm{n}$. Hạt nhân X có 54 proton và 86 neutron.", "answer": true, "explanation": "Đúng: X có A=140,Z=54,N=86."}, {"text": "Trong phản ứng nhiệt hạch $^{2}_{1}\\mathrm{H}+{}^{3}_{1}\\mathrm{H}\\to{}^{4}_{2}\\mathrm{He}+{}^{1}_{0}\\mathrm{n}+17{,}6$ MeV, năng lượng cần cung cấp cho phản ứng là 17,6 MeV.", "answer": false, "explanation": "Sai: 17,6 MeV là năng lượng tỏa."}, {"text": "Công nghệ hạt nhân đang được ứng dụng nhiều trong y học, công nghiệp, nông nghiệp, khảo cổ học, thực phẩm.", "answer": true, "explanation": "Đúng."}]}, {"id": "ctst-nuclear-039-tf-2", "kind": "true_false", "topic": "B22", "chapter": "Vật lí hạt nhân", "level": "Thông hiểu", "prompt": "Trong mỗi phát biểu sau, em hãy chọn đúng hoặc sai.", "explanation": "a) Sai vì còn bảo toàn năng lượng toàn phần, động lượng.\nb) Đúng.\nc) Đúng.\nd) Sai.", "points": 1, "source": {"book": "Sách bài tập Vật lí 12 · Chân trời sáng tạo", "bookId": "ctst", "sequence": 39, "label": "Câu 16.7", "pages": [70], "printedPages": [70], "parts": [{"questionId": "ctst-nuclear-039", "book": "Sách bài tập Vật lí 12 · Chân trời sáng tạo", "bookId": "ctst", "sequence": 39, "label": "Câu 16.7", "pages": [70], "printedPages": [70], "statementIndexes": [4, 5]}, {"questionId": "sbt-kntt-nuclear-013", "book": "Sách bài tập Vật lí 12 · Kết nối tri thức", "bookId": "sbt-kntt", "sequence": 13, "label": "22.1", "pages": [73, 74], "printedPages": [73, 74], "statementIndexes": [0, 1]}]}, "bloom": {"level": "understand", "rationale": "Diễn giải, so sánh hoặc giải thích ý nghĩa vật lí.", "review": "reviewed"}, "status": "ready", "notes": ["Phần dẫn và phương án đối chiếu ảnh trang sách; lời giải do người biên soạn kiểm tra.", "Nhãn Bloom là phân loại nội bộ, chưa thẩm định độc lập; mức độ ma trận được rà soát riêng.", "Tách/ghép thành bốn ý cùng chủ đề; lưu vị trí từng ý để đối chiếu nội bộ."], "statements": [{"text": "Trong phản ứng hạt nhân chỉ có sự bảo toàn điện tích và bảo toàn số khối.", "answer": false, "explanation": "Sai vì còn bảo toàn năng lượng toàn phần, động lượng."}, {"text": "Phản ứng nhiệt hạch là nguồn năng lượng của Mặt Trời và các sao.", "answer": true, "explanation": "Đúng."}, {"text": "Phản ứng hạt nhân là quá trình biến đổi từ hạt nhân này thành hạt nhân khác, bao gồm phản ứng hạt nhân kích thích và phản ứng hạt nhân tự phát.", "answer": true}, {"text": "Trong một phản ứng hạt nhân, luôn cần từ hai hạt tham gia phản ứng trở lên.", "answer": false}]}, {"id": "ctst-nuclear-042", "kind": "written", "topic": "B22", "chapter": "Vật lí hạt nhân", "level": "Vận dụng", "prompt": "Xác định số hiệu nguyên tử và số khối còn thiếu trong các phản ứng: a) $^{26}_{12}\\mathrm{Mg}+{}^{1}_{0}\\mathrm{n}\\to{}^{?}_{?}\\mathrm{Ne}+{}^{4}_{2}\\mathrm{He}$; b) $^{?}_{94}\\mathrm{Pu}+{}^{22}_{10}\\mathrm{Ne}\\to4{}^{1}_{0}\\mathrm{n}+{}^{260}_{104}\\mathrm{Rf}$; c) $^{2}_{1}\\mathrm{H}+{}^{?}_{3}\\mathrm{Li}\\to2{}^{4}_{2}\\mathrm{He}+{}^{1}_{0}\\mathrm{n}$.", "explanation": "a) $^{23}_{10}\\mathrm{Ne}$; b) $^{242}_{94}\\mathrm{Pu}$; c) $^{7}_{3}\\mathrm{Li}$. Dùng bảo toàn A và điện tích.", "points": 1, "source": {"book": "Sách bài tập Vật lí 12 · Chân trời sáng tạo", "bookId": "ctst", "sequence": 42, "label": "Bài 16.1", "pages": [71], "printedPages": [71]}, "bloom": {"level": "apply", "rationale": "Thực hiện quy tắc hoặc phép tính với dữ kiện của bài.", "review": "reviewed"}, "status": "ready", "notes": ["Phần dẫn và phương án đối chiếu ảnh trang sách; lời giải do người biên soạn kiểm tra.", "Nhãn Bloom là phân loại nội bộ, chưa thẩm định độc lập; mức độ ma trận được rà soát riêng."]}, {"id": "ctst-nuclear-043", "kind": "written", "topic": "B22", "chapter": "Vật lí hạt nhân", "level": "Vận dụng", "prompt": "Xét phản ứng nhiệt hạch $^{2}_{1}\\mathrm{H}+{}^{3}_{1}\\mathrm{H}\\to{}^{4}_{2}\\mathrm{He}+{}^{1}_{0}\\mathrm{n}$. Để tổng hợp được 50 g He thì khối lượng H-2 và H-3 phải sử dụng là bao nhiêu? Coi khối lượng mol gần bằng số khối; $N_A\\approx6{,}022\\times10^{23}\\ \\mathrm{mol}^{-1}$.", "explanation": "Cần 25 g H-2 và 37,5 g H-3. Số mol mỗi chất bằng 50/4=12,5 mol.", "points": 1, "source": {"book": "Sách bài tập Vật lí 12 · Chân trời sáng tạo", "bookId": "ctst", "sequence": 43, "label": "Bài 16.2", "pages": [71], "printedPages": [71]}, "bloom": {"level": "apply", "rationale": "Thực hiện quy tắc hoặc phép tính với dữ kiện của bài.", "review": "reviewed"}, "status": "ready", "notes": ["Phần dẫn và phương án đối chiếu ảnh trang sách; lời giải do người biên soạn kiểm tra.", "Nhãn Bloom là phân loại nội bộ, chưa thẩm định độc lập; mức độ ma trận được rà soát riêng."]}, {"id": "ctst-nuclear-046", "kind": "written", "topic": "B22", "chapter": "Vật lí hạt nhân", "level": "Vận dụng", "prompt": "a) Nhà máy điện hạt nhân công suất phát điện 1920 MW dùng phân hạch U-235, hiệu suất 33%. Mỗi năm 365 ngày; mỗi phân hạch khoảng 200 MeV. Tính khối lượng U-235 tiêu thụ mỗi năm; $N_A\\approx6{,}022\\times10^{23}\\ \\mathrm{mol}^{-1}$. b) Cần khối lượng than bao nhiêu trong nhà máy nhiệt điện để tạo lượng năng lượng như trên? Năng suất tỏa nhiệt than 20 MJ/kg.", "explanation": "a) $m_U=Pt\\times235/(0{,}33\\times200\\times1{,}602\\times10^{-13}N_A)\\approx2235$ kg. b) Nếu so sánh nhiệt năng Q trước chuyển đổi: $m_{than}=Q/(20\\times10^6)\\approx9{,}174\\times10^9$ kg. Nếu so sánh điện năng, cần hiệu suất nhà máy than; nêu giả thiết rõ.", "points": 1, "source": {"book": "Sách bài tập Vật lí 12 · Chân trời sáng tạo", "bookId": "ctst", "sequence": 46, "label": "Bài 16.5", "pages": [72], "printedPages": [72]}, "bloom": {"level": "analyze", "rationale": "Phân tách thông tin và liên hệ các thành phần để tìm kết quả.", "review": "reviewed"}, "status": "ready", "notes": ["Phần dẫn và phương án đối chiếu ảnh trang sách; lời giải do người biên soạn kiểm tra.", "Nhãn Bloom là phân loại nội bộ, chưa thẩm định độc lập; mức độ ma trận được rà soát riêng."]}, {"id": "ctst-nuclear-047", "kind": "numeric", "topic": "B22", "chapter": "Vật lí hạt nhân", "level": "Vận dụng", "prompt": "Năng lượng Mặt Trời và các sao có nguồn gốc từ nhiệt hạch, bắt đầu chu trình proton–proton tạo helium. Xét ngôi sao đã đốt cháy hoàn toàn hydrogen thành helium, tất cả helium tham gia quá trình ba–alpha: $^{4}_{2}\\mathrm{He}+{}^{4}_{2}\\mathrm{He}+{}^{4}_{2}\\mathrm{He}\\to{}^{12}_{6}\\mathrm{C}+7{,}275$ MeV. Khối lượng sao lúc đó $4\\times10^{30}$ kg, công suất tỏa nhiệt $3{,}8\\times10^{30}$ W. Sau bao lâu toàn bộ helium chuyển thành carbon? $N_A\\approx6{,}022\\times10^{23}\\ \\mathrm{mol}^{-1}$.", "explanation": "$t\\approx6{,}157\\times10^{13}$ s (khoảng 1,95 triệu năm).\nSố phản ứng $N=(4\\times10^{33}/12)N_A$; $t=N\\times7{,}275\\times1{,}602\\times10^{-13}/P$.", "points": 1, "source": {"book": "Sách bài tập Vật lí 12 · Chân trời sáng tạo", "bookId": "ctst", "sequence": 47, "label": "Bài 16.6", "pages": [72], "printedPages": [72]}, "bloom": {"level": "apply", "rationale": "Thực hiện quy tắc hoặc phép tính với dữ kiện của bài.", "review": "reviewed"}, "status": "ready", "notes": ["Phần dẫn và phương án đối chiếu ảnh trang sách; lời giải do người biên soạn kiểm tra.", "Nhãn Bloom là phân loại nội bộ, chưa thẩm định độc lập; mức độ ma trận được rà soát riêng."], "answerText": "$t\\approx6{,}157\\times10^{13}$ s (khoảng 1,95 triệu năm)."}, {"id": "ctst-nuclear-048", "kind": "choice", "topic": "B23", "chapter": "Vật lí hạt nhân", "level": "Thông hiểu", "prompt": "Chỉ ra phát biểu sai khi nói về hiện tượng phóng xạ.", "explanation": "B. Trong phạm vi SGK, phân rã không phụ thuộc nhiệt độ, áp suất thông thường.", "points": 1, "source": {"book": "Sách bài tập Vật lí 12 · Chân trời sáng tạo", "bookId": "ctst", "sequence": 48, "label": "Câu 17.1", "pages": [73], "printedPages": [73]}, "bloom": {"level": "understand", "rationale": "Diễn giải, so sánh hoặc giải thích ý nghĩa vật lí.", "review": "reviewed"}, "status": "ready", "notes": ["Phần dẫn và phương án đối chiếu ảnh trang sách; lời giải do người biên soạn kiểm tra.", "Nhãn Bloom là phân loại nội bộ, chưa thẩm định độc lập; mức độ ma trận được rà soát riêng."], "options": ["Hiện tượng phóng xạ là hiện tượng một hạt nhân không bền vững tự phát phân rã, phát ra các tia phóng xạ và biến đổi thành hạt nhân khác.", "Hiện tượng phóng xạ chịu ảnh hưởng bởi các yếu tố bên ngoài như nhiệt độ, áp suất,…", "Có 3 loại phóng xạ là $\\alpha$, $\\beta$ và $\\gamma$; $\\beta$ chia thành $\\beta^-$ và $\\beta^+$.", "Do tia $\\gamma$ có bản chất là sóng điện từ nên phóng xạ $\\gamma$ không đi kèm với việc biến đổi hạt nhân mẹ thành hạt nhân khác."], "answer": 1}, {"id": "ctst-nuclear-049", "kind": "choice", "topic": "B23", "chapter": "Vật lí hạt nhân", "level": "Thông hiểu", "prompt": "Trong các định luật bảo toàn: (1) động lượng; (2) số khối; (3) khối lượng; (4) năng lượng toàn phần; (5) số proton. Hiện tượng phóng xạ tuân theo bao nhiêu định luật bảo toàn?", "explanation": "B. (1), (2), (4) được bảo toàn; tổng khối lượng nghỉ và số proton không luôn bảo toàn.", "points": 1, "source": {"book": "Sách bài tập Vật lí 12 · Chân trời sáng tạo", "bookId": "ctst", "sequence": 49, "label": "Câu 17.2", "pages": [73], "printedPages": [73]}, "bloom": {"level": "understand", "rationale": "Diễn giải, so sánh hoặc giải thích ý nghĩa vật lí.", "review": "reviewed"}, "status": "ready", "notes": ["Phần dẫn và phương án đối chiếu ảnh trang sách; lời giải do người biên soạn kiểm tra.", "Nhãn Bloom là phân loại nội bộ, chưa thẩm định độc lập; mức độ ma trận được rà soát riêng."], "options": ["2.", "3.", "4.", "5."], "answer": 1}, {"id": "ctst-nuclear-050", "kind": "choice", "topic": "B23", "chapter": "Vật lí hạt nhân", "level": "Nhận biết", "prompt": "Mẫu chất phóng xạ ban đầu (t=0) có $N_0$ hạt nhân; hằng số phóng xạ và chu kì bán rã lần lượt $\\lambda$, T. Sau khoảng thời gian $\\Delta t$, số hạt nhân còn lại xác định bằng biểu thức nào?", "explanation": "C. $N_t=N_0e^{-\\lambda\\Delta t}$.", "points": 1, "source": {"book": "Sách bài tập Vật lí 12 · Chân trời sáng tạo", "bookId": "ctst", "sequence": 50, "label": "Câu 17.3", "pages": [73], "printedPages": [73]}, "bloom": {"level": "remember", "rationale": "Nhớ lại định nghĩa, tính chất hoặc quy tắc đã học.", "review": "reviewed"}, "status": "ready", "notes": ["Phần dẫn và phương án đối chiếu ảnh trang sách; lời giải do người biên soạn kiểm tra.", "Nhãn Bloom là phân loại nội bộ, chưa thẩm định độc lập; mức độ ma trận được rà soát riêng."], "options": ["$N_t=N_0e^{\\lambda\\Delta t}$", "$N_t=N_0 2^{\\frac{\\Delta t}{T}}$", "$N_t=N_0e^{-\\lambda\\Delta t}$", "$N_t=N_0 2^{-\\Delta t}$"], "answer": 2}, {"id": "ctst-nuclear-051", "kind": "choice", "topic": "B23", "chapter": "Vật lí hạt nhân", "level": "Thông hiểu", "prompt": "Có bao nhiêu phát biểu đúng? (1) Chu kì bán rã là thời gian để một nửa số hạt nhân ban đầu bị phân rã. (2) $\\lambda=T\\ln2$. (3) Tia $\\gamma$ thường phát kèm theo các tia $\\alpha$ và $\\beta$. (4) Độ phóng xạ đặc trưng tính phóng xạ mạnh hay yếu của một lượng chất phóng xạ. (5) Độ phóng xạ tăng dần theo thời gian theo quy luật hàm mũ.", "explanation": "C. (1), (3), (4) đúng; (2) phải là ln2/T; (5) độ phóng xạ giảm trong mẫu đơn đồng vị.", "points": 1, "source": {"book": "Sách bài tập Vật lí 12 · Chân trời sáng tạo", "bookId": "ctst", "sequence": 51, "label": "Câu 17.4", "pages": [74], "printedPages": [74]}, "bloom": {"level": "understand", "rationale": "Diễn giải, so sánh hoặc giải thích ý nghĩa vật lí.", "review": "reviewed"}, "status": "ready", "notes": ["Phần dẫn và phương án đối chiếu ảnh trang sách; lời giải do người biên soạn kiểm tra.", "Nhãn Bloom là phân loại nội bộ, chưa thẩm định độc lập; mức độ ma trận được rà soát riêng."], "options": ["1.", "2.", "3.", "4."], "answer": 2}, {"id": "ctst-nuclear-052", "kind": "choice", "topic": "B23", "chapter": "Vật lí hạt nhân", "level": "Thông hiểu", "prompt": "Chiếu 3 chùm tia phóng xạ lần lượt qua tấm giấy, nhôm và chì như Hình 17.1. Các tia 1, tia 2, tia 3 theo thứ tự là:", "explanation": "B. Alpha bị giấy chặn, beta xuyên giấy nhưng bị nhôm chặn, gamma đâm xuyên mạnh.", "points": 1, "source": {"book": "Sách bài tập Vật lí 12 · Chân trời sáng tạo", "bookId": "ctst", "sequence": 52, "label": "Câu 17.5", "pages": [74], "printedPages": [74]}, "bloom": {"level": "understand", "rationale": "Diễn giải, so sánh hoặc giải thích ý nghĩa vật lí.", "review": "reviewed"}, "status": "ready", "notes": ["Phần dẫn và phương án đối chiếu ảnh trang sách; lời giải do người biên soạn kiểm tra.", "Nhãn Bloom là phân loại nội bộ, chưa thẩm định độc lập; mức độ ma trận được rà soát riêng."], "options": ["tia $\\beta$, tia $\\alpha$, tia $\\gamma$.", "tia $\\alpha$, tia $\\beta$, tia $\\gamma$.", "tia $\\beta$, tia $\\gamma$, tia $\\alpha$.", "tia $\\gamma$, tia $\\alpha$, tia $\\beta$."], "answer": 1, "figure": {"url": "/api/book-bank/asset?file=ctst%2Fverified-figures%2Fhinh-17-1.png", "description": "Hình minh họa của bài", "origin": "source_crop"}}, {"id": "ctst-nuclear-053", "kind": "true_false", "topic": "B23", "chapter": "Vật lí hạt nhân", "level": "Vận dụng", "prompt": "$^{238}_{92}\\mathrm{U}$ có hằng số phóng xạ $4{,}916\\times10^{-18}\\ \\mathrm{s}^{-1}$, phân rã alpha thành X. Trong mỗi phát biểu sau, chọn đúng hoặc sai.", "explanation": "a) Đúng; b) Sai vì X là Th-234; c) Đúng, $T=\\ln2/\\lambda\\approx1{,}41\\times10^{17}$ s; d) Sai, khối lượng còn khoảng 0,09846 g.", "points": 1, "source": {"book": "Sách bài tập Vật lí 12 · Chân trời sáng tạo", "bookId": "ctst", "sequence": 53, "label": "Câu 17.6", "pages": [74], "printedPages": [74]}, "bloom": {"level": "apply", "rationale": "Thực hiện quy tắc hoặc phép tính với dữ kiện của bài.", "review": "reviewed"}, "status": "ready", "notes": ["Phần dẫn và phương án đối chiếu ảnh trang sách; lời giải do người biên soạn kiểm tra.", "Nhãn Bloom là phân loại nội bộ, chưa thẩm định độc lập; mức độ ma trận được rà soát riêng."], "statements": [{"text": "Quá trình phóng xạ của U-238 là một phản ứng hạt nhân tỏa năng lượng.", "answer": true}, {"text": "Hạt nhân con X là $^{234}_{92}\\mathrm{U}$.", "answer": false}, {"text": "Chu kì bán rã U-238 là $1{,}41\\times10^{17}$ s (làm tròn đến 2 chữ số thập phân sau dấu phẩy).", "answer": true}, {"text": "Mẫu ban đầu chứa 0,1 g U-238. Sau 100 triệu năm (365 ngày/năm), khối lượng U-238 còn khoảng 0,089 g.", "answer": false}]}, {"id": "ctst-nuclear-054", "kind": "choice", "topic": "B23", "chapter": "Vật lí hạt nhân", "level": "Vận dụng", "prompt": "$^{210}_{84}\\mathrm{Po}$ có T=138,4 ngày. Mẫu ban đầu có $N_0$ hạt. Sau bao lâu tỉ số số hạt đã phân rã và số hạt còn lại bằng 7?", "explanation": "A. $N_0/N=8$, nên t=3T=415,2 ngày.", "points": 1, "source": {"book": "Sách bài tập Vật lí 12 · Chân trời sáng tạo", "bookId": "ctst", "sequence": 54, "label": "Câu 17.7", "pages": [75], "printedPages": [75]}, "bloom": {"level": "apply", "rationale": "Thực hiện quy tắc hoặc phép tính với dữ kiện của bài.", "review": "reviewed"}, "status": "ready", "notes": ["Phần dẫn và phương án đối chiếu ảnh trang sách; lời giải do người biên soạn kiểm tra.", "Nhãn Bloom là phân loại nội bộ, chưa thẩm định độc lập; mức độ ma trận được rà soát riêng."], "options": ["415,2 ngày.", "387,5 ngày.", "34,6 ngày.", "968,8 ngày."], "answer": 0}, {"id": "ctst-nuclear-056", "kind": "choice", "topic": "B23", "chapter": "Vật lí hạt nhân", "level": "Vận dụng", "prompt": "Mẫu chất phóng xạ X phân rã phát hạt $\\alpha$. Số hạt này được ghi nhận bằng ống Geiger–Muller, biểu diễn theo t như Hình 17.2. Hằng số phóng xạ của chất là", "explanation": "A. Từ hai điểm (2 s, 3 ô) và (17 s, 15 ô), giải $(1-e^{-2\\lambda})/(1-e^{-17\\lambda})=3/15$ cho $\\lambda\\approx0{,}081\\ \\mathrm{s}^{-1}$. Đây là số hạt tích lũy, không lấy nửa giá trị lớn nhất làm chu kì.", "points": 1, "source": {"book": "Sách bài tập Vật lí 12 · Chân trời sáng tạo", "bookId": "ctst", "sequence": 56, "label": "Câu 17.9", "pages": [75], "printedPages": [75]}, "bloom": {"level": "analyze", "rationale": "Phân tách thông tin và liên hệ các thành phần để tìm kết quả.", "review": "reviewed"}, "status": "ready", "notes": ["Phần dẫn và phương án đối chiếu ảnh trang sách; lời giải do người biên soạn kiểm tra.", "Nhãn Bloom là phân loại nội bộ, chưa thẩm định độc lập; mức độ ma trận được rà soát riêng."], "options": ["$0{,}081\\ \\mathrm{s}^{-1}$", "$0{,}173\\ \\mathrm{s}^{-1}$", "$0{,}231\\ \\mathrm{s}^{-1}$", "$0{,}058\\ \\mathrm{s}^{-1}$"], "answer": 0, "figure": {"url": "/api/book-bank/asset?file=ctst%2Fverified-figures%2Fhinh-17-2.png", "description": "Hình minh họa của bài", "origin": "source_crop"}}, {"id": "ctst-nuclear-058", "kind": "written", "topic": "B23", "chapter": "Vật lí hạt nhân", "level": "Vận dụng", "prompt": "Đặt nguồn phóng xạ trong điện trường đều giữa hai bản kim loại tích điện trái dấu như Hình 17.3. Vẽ đường đi các tia nếu nguồn phát được $\\alpha$, $\\beta^+$, $\\beta^-$, $\\gamma$.", "explanation": "Alpha và beta+ lệch sang bản âm bên phải; beta− sang bản dương bên trái; gamma thẳng. Độ cong không đủ dữ kiện định lượng.", "points": 1, "source": {"book": "Sách bài tập Vật lí 12 · Chân trời sáng tạo", "bookId": "ctst", "sequence": 58, "label": "Bài 17.2", "pages": [76], "printedPages": [76]}, "bloom": {"level": "apply", "rationale": "Thực hiện quy tắc hoặc phép tính với dữ kiện của bài.", "review": "reviewed"}, "status": "ready", "notes": ["Phần dẫn và phương án đối chiếu ảnh trang sách; lời giải do người biên soạn kiểm tra.", "Nhãn Bloom là phân loại nội bộ, chưa thẩm định độc lập; mức độ ma trận được rà soát riêng."], "figure": {"url": "/api/book-bank/asset?file=ctst%2Fverified-figures%2Fhinh-17-3.png", "description": "Hình minh họa của bài", "origin": "source_crop"}}, {"id": "ctst-nuclear-059", "kind": "numeric", "topic": "B23", "chapter": "Vật lí hạt nhân", "level": "Vận dụng", "prompt": "Mẫu ban đầu ($t_0=0$) có $N_0$ hạt, chu kì T. Tính số hạt đã phóng xạ tại t=2T.", "explanation": "$3N_0/4$.\nSố hạt còn $N_0/4$, lấy ban đầu trừ còn lại.", "points": 1, "source": {"book": "Sách bài tập Vật lí 12 · Chân trời sáng tạo", "bookId": "ctst", "sequence": 59, "label": "Bài 17.3", "pages": [76], "printedPages": [76]}, "bloom": {"level": "apply", "rationale": "Thực hiện quy tắc hoặc phép tính với dữ kiện của bài.", "review": "reviewed"}, "status": "ready", "notes": ["Phần dẫn và phương án đối chiếu ảnh trang sách; lời giải do người biên soạn kiểm tra.", "Nhãn Bloom là phân loại nội bộ, chưa thẩm định độc lập; mức độ ma trận được rà soát riêng."], "answerText": "$3N_0/4$."}, {"id": "ctst-nuclear-060", "kind": "written", "topic": "B23", "chapter": "Vật lí hạt nhân", "level": "Thông hiểu", "prompt": "Dựa vào kiến thức đã học, giải thích tại sao nhiệt độ một mẫu chất phóng xạ luôn cao hơn nhiệt độ môi trường xung quanh một chút.", "explanation": "Bức xạ và hạt giật lùi truyền năng lượng thành nhiệt trong mẫu. Độ tăng nhiệt tùy công suất phân rã, phần hấp thụ và trao đổi nhiệt; từ “luôn” không đúng tuyệt đối khi mẫu rất yếu hoặc bức xạ thoát ra, cần nêu điều kiện.", "points": 1, "source": {"book": "Sách bài tập Vật lí 12 · Chân trời sáng tạo", "bookId": "ctst", "sequence": 60, "label": "Bài 17.4", "pages": [76], "printedPages": [76]}, "bloom": {"level": "understand", "rationale": "Diễn giải, so sánh hoặc giải thích ý nghĩa vật lí.", "review": "reviewed"}, "status": "ready", "notes": ["Phần dẫn và phương án đối chiếu ảnh trang sách; lời giải do người biên soạn kiểm tra.", "Nhãn Bloom là phân loại nội bộ, chưa thẩm định độc lập; mức độ ma trận được rà soát riêng."]}, {"id": "ctst-nuclear-061", "kind": "written", "topic": "B23", "chapter": "Vật lí hạt nhân", "level": "Vận dụng", "prompt": "Xác định A, Z trong: a) $^{212}_{83}\\mathrm{Bi}\\to{}^{A}_{Z}\\mathrm{X}+{}^{4}_{2}\\mathrm{He}$; b) $^{234}_{90}\\mathrm{Th}\\to{}^{230}_{88}\\mathrm{Ra}+{}^{A}_{Z}\\mathrm{X}$; c) $^{210}_{84}\\mathrm{Po}\\to{}^{A}_{Z}\\mathrm{X}+\\alpha$; d) $^{12}_{5}\\mathrm{B}\\to{}^{A}_{Z}\\mathrm{X}+\\beta^-+\\mathrm{antineutrino}$.", "explanation": "a) A=208,Z=81 (Tl); b) A=4,Z=2 (He); c) A=206,Z=82 (Pb); d) A=12,Z=6 (C).", "points": 1, "source": {"book": "Sách bài tập Vật lí 12 · Chân trời sáng tạo", "bookId": "ctst", "sequence": 61, "label": "Bài 17.5", "pages": [76], "printedPages": [76]}, "bloom": {"level": "apply", "rationale": "Thực hiện quy tắc hoặc phép tính với dữ kiện của bài.", "review": "reviewed"}, "status": "ready", "notes": ["Phần dẫn và phương án đối chiếu ảnh trang sách; lời giải do người biên soạn kiểm tra.", "Nhãn Bloom là phân loại nội bộ, chưa thẩm định độc lập; mức độ ma trận được rà soát riêng."]}, {"id": "ctst-nuclear-062", "kind": "written", "topic": "B23", "chapter": "Vật lí hạt nhân", "level": "Vận dụng", "prompt": "Hạt nhân không bền có thể phân rã nhiều lần tới hạt nhân bền, tạo một họ phóng xạ. Họ thorium bắt đầu ở $^{232}_{90}\\mathrm{Th}$, kết thúc ở $^{208}_{82}\\mathrm{Pb}$, phương trình thu gọn $^{232}_{90}\\mathrm{Th}\\to{}^{208}_{82}\\mathrm{Pb}+x\\beta^-+y\\alpha$. Xác định x, y.", "explanation": "y=6, x=4. Bảo toàn A: 232=208+4y; điện tích: 90=82−x+2y.", "points": 1, "source": {"book": "Sách bài tập Vật lí 12 · Chân trời sáng tạo", "bookId": "ctst", "sequence": 62, "label": "Bài 17.6", "pages": [77], "printedPages": [77]}, "bloom": {"level": "apply", "rationale": "Thực hiện quy tắc hoặc phép tính với dữ kiện của bài.", "review": "reviewed"}, "status": "ready", "notes": ["Phần dẫn và phương án đối chiếu ảnh trang sách; lời giải do người biên soạn kiểm tra.", "Nhãn Bloom là phân loại nội bộ, chưa thẩm định độc lập; mức độ ma trận được rà soát riêng."]}, {"id": "ctst-nuclear-064", "kind": "written", "topic": "B23", "chapter": "Vật lí hạt nhân", "level": "Vận dụng", "prompt": "Mẫu than bùn từ đầm lầy cổ chứa 980 µg $^{14}_{6}\\mathrm{C}$, T=5730 năm. a) Khối lượng C-14 sau 2000 năm. b) Thời điểm khối lượng còn 100 µg.", "explanation": "a) $m=980\\times2^{-2000/5730}\\approx769{,}4$ µg. b) $t=5730\\log_2(980/100)\\approx18868$ năm.", "points": 1, "source": {"book": "Sách bài tập Vật lí 12 · Chân trời sáng tạo", "bookId": "ctst", "sequence": 64, "label": "Bài 17.8", "pages": [77], "printedPages": [77]}, "bloom": {"level": "apply", "rationale": "Thực hiện quy tắc hoặc phép tính với dữ kiện của bài.", "review": "reviewed"}, "status": "ready", "notes": ["Phần dẫn và phương án đối chiếu ảnh trang sách; lời giải do người biên soạn kiểm tra.", "Nhãn Bloom là phân loại nội bộ, chưa thẩm định độc lập; mức độ ma trận được rà soát riêng."]}, {"id": "ctst-nuclear-065", "kind": "numeric", "topic": "B23", "chapter": "Vật lí hạt nhân", "level": "Vận dụng", "prompt": "Trước máy gia tốc, bệnh viện dùng nguồn gamma $^{60}_{27}\\mathrm{Co}$ để xạ trị, T=5,27 năm (365 ngày/năm). Tính số hạt Co-60 trong nguồn có hoạt độ 5800 Ci.", "explanation": "$N\\approx5{,}146\\times10^{22}$ hạt.\nĐổi H=5800×3,7×10¹⁰ Bq; $N=HT/\\ln2$ với T tính bằng giây.", "points": 1, "source": {"book": "Sách bài tập Vật lí 12 · Chân trời sáng tạo", "bookId": "ctst", "sequence": 65, "label": "Bài 17.9", "pages": [77], "printedPages": [77]}, "bloom": {"level": "apply", "rationale": "Thực hiện quy tắc hoặc phép tính với dữ kiện của bài.", "review": "reviewed"}, "status": "ready", "notes": ["Phần dẫn và phương án đối chiếu ảnh trang sách; lời giải do người biên soạn kiểm tra.", "Nhãn Bloom là phân loại nội bộ, chưa thẩm định độc lập; mức độ ma trận được rà soát riêng."], "answerText": "$N\\approx5{,}146\\times10^{22}$ hạt."}, {"id": "ctst-nuclear-066", "kind": "numeric", "topic": "B23", "chapter": "Vật lí hạt nhân", "level": "Vận dụng", "prompt": "Po-210 là nguồn năng lượng được nêu trong bài về máy phát nhiệt điện đồng vị RTG. T=138 ngày, phân rã alpha tạo $^{206}_{82}\\mathrm{Pb}$. Mẫu polonium ban đầu nguyên chất; tại $t_1$, tỉ số số hạt Pb tạo thành với số hạt Po còn lại bằng 15. Tại $t_2=t_1+966$ ngày, tỉ số này bằng bao nhiêu?", "explanation": "$2047$.\n$t_1=4T$; $966=7T$; t₂=11T nên $N_{Pb}/N_{Po}=2^{11}-1$.", "points": 1, "source": {"book": "Sách bài tập Vật lí 12 · Chân trời sáng tạo", "bookId": "ctst", "sequence": 66, "label": "Bài 17.10", "pages": [78], "printedPages": [78]}, "bloom": {"level": "apply", "rationale": "Thực hiện quy tắc hoặc phép tính với dữ kiện của bài.", "review": "reviewed"}, "status": "ready", "notes": ["Phần dẫn và phương án đối chiếu ảnh trang sách; lời giải do người biên soạn kiểm tra.", "Nhãn Bloom là phân loại nội bộ, chưa thẩm định độc lập; mức độ ma trận được rà soát riêng."], "answerText": "$2047$."}, {"id": "ctst-nuclear-067", "kind": "written", "topic": "B23", "chapter": "Vật lí hạt nhân", "level": "Vận dụng", "prompt": "Hai máy Geiger–Muller giống nhau đo hai mẫu $^{210}_{84}\\mathrm{Po}$ và $^{131}_{53}\\mathrm{I}$ ở cùng khoảng cách, hai phòng khác nhau; mỗi hạt phân rã chỉ phát một tia, tín hiệu tỉ lệ số phân rã. Mỗi mẫu ban đầu 1 g; trong ngày đêm đầu máy nào đếm nhiều hơn? Lấy khối lượng mol gần số khối, T lần lượt 138,40 ngày và 8,02 ngày; $N_A\\approx6{,}022\\times10^{23}\\ \\mathrm{mol}^{-1}$.", "explanation": "$\\Delta N=(m/M)N_A(1-2^{-1/T})$. Po≈1,433×10¹⁹, I≈3,806×10²⁰ phân rã. Máy chiếu bởi I đếm nhiều hơn nếu hiệu suất như giả thiết bài.", "points": 1, "source": {"book": "Sách bài tập Vật lí 12 · Chân trời sáng tạo", "bookId": "ctst", "sequence": 67, "label": "Bài 17.11", "pages": [78], "printedPages": [78]}, "bloom": {"level": "apply", "rationale": "Thực hiện quy tắc hoặc phép tính với dữ kiện của bài.", "review": "reviewed"}, "status": "ready", "notes": ["Phần dẫn và phương án đối chiếu ảnh trang sách; lời giải do người biên soạn kiểm tra.", "Nhãn Bloom là phân loại nội bộ, chưa thẩm định độc lập; mức độ ma trận được rà soát riêng."]}, {"id": "ctst-nuclear-068", "kind": "written", "topic": "B23", "chapter": "Vật lí hạt nhân", "level": "Vận dụng", "prompt": "Xác định tuổi cổ vật bằng C-14: a) Neutron năng lượng cao trong tia vũ trụ phản ứng với $^{14}_{7}\\mathrm{N}$ theo tỉ lệ 1:1 tạo C-14 và X. Viết phản ứng, xác định X. Carbon tạo CO₂, được sinh vật hấp thụ; sau chết không bổ sung C-14 và phân rã beta− với T=5730 năm. b) Viết phương trình phân rã C-14. c) Mảnh gỗ hóa thạch chứa 220 g carbon, hoạt độ 0,52 Bq. Trong gỗ sống tỉ số C-14:C-12=$1{,}3\\times10^{-12}$. Tính tuổi, lấy khối lượng mol gần số khối, $N_A\\approx6{,}022\\times10^{23}\\ \\mathrm{mol}^{-1}$.", "explanation": "a) $^{1}_{0}\\mathrm{n}+{}^{14}_{7}\\mathrm{N}\\to{}^{14}_{6}\\mathrm{C}+{}^{1}_{1}\\mathrm{H}$, X là proton. b) $^{14}_{6}\\mathrm{C}\\to{}^{14}_{7}\\mathrm{N}+{}^{0}_{-1}\\mathrm{e}+\\mathrm{antineutrino}$. c) $N_0=(220/12)N_A\\times1{,}3\\times10^{-12}$; $H_0=(\\ln2/T)N_0$; $t=T\\ln(H_0/0{,}52)/\\ln2\\approx38541$ năm (365 ngày/năm).", "points": 1, "source": {"book": "Sách bài tập Vật lí 12 · Chân trời sáng tạo", "bookId": "ctst", "sequence": 68, "label": "Bài 17.12", "pages": [78, 79], "printedPages": [78, 79]}, "bloom": {"level": "apply", "rationale": "Thực hiện quy tắc hoặc phép tính với dữ kiện của bài.", "review": "reviewed"}, "status": "ready", "notes": ["Phần dẫn và phương án đối chiếu ảnh trang sách; lời giải do người biên soạn kiểm tra.", "Nhãn Bloom là phân loại nội bộ, chưa thẩm định độc lập; mức độ ma trận được rà soát riêng."]}, {"id": "ctst-nuclear-069", "kind": "choice", "topic": "B23", "chapter": "Vật lí hạt nhân", "level": "Nhận biết", "prompt": "Vật liệu nào sau đây hiệu quả nhất để che chắn phóng xạ $\\gamma$?", "explanation": "D. Trong bốn vật liệu của bài, chì có khả năng suy giảm gamma tốt nhất khi so sánh theo điều kiện SGK.", "points": 1, "source": {"book": "Sách bài tập Vật lí 12 · Chân trời sáng tạo", "bookId": "ctst", "sequence": 69, "label": "Câu 18.1", "pages": [79], "printedPages": [79]}, "bloom": {"level": "remember", "rationale": "Nhớ lại định nghĩa, tính chất hoặc quy tắc đã học.", "review": "reviewed"}, "status": "ready", "notes": ["Phần dẫn và phương án đối chiếu ảnh trang sách; lời giải do người biên soạn kiểm tra.", "Nhãn Bloom là phân loại nội bộ, chưa thẩm định độc lập; mức độ ma trận được rà soát riêng."], "options": ["Giấy.", "Gỗ.", "Nhôm.", "Chì."], "answer": 3}, {"id": "ctst-nuclear-070", "kind": "written", "topic": "B23", "chapter": "Vật lí hạt nhân", "level": "Nhận biết", "prompt": "Chọn cụm từ điền chỗ trống: che chắn; phơi nhiễm; khoảng cách; an toàn; màn chắn; kẹp dài.\nBa quy tắc cơ bản để đảm bảo (1)… khi ở khu vực có nguồn hoặc làm việc trực tiếp với nguồn phóng xạ:\n– Bố trí thời lượng công việc để giảm thời gian (2)…\n– Khi thao tác trực tiếp cần đảm bảo (3)… an toàn bằng các (4)… và phương tiện điều khiển từ xa.\n– Việc (5)… thực hiện bằng cách trang bị (6)… như tường bê tông, cửa chì đủ dày, trang phục bảo hộ (mắt kính, găng tay, quần áo có chì).", "explanation": "(1) an toàn; (2) phơi nhiễm; (3) khoảng cách; (4) kẹp dài; (5) che chắn; (6) màn chắn.", "points": 1, "source": {"book": "Sách bài tập Vật lí 12 · Chân trời sáng tạo", "bookId": "ctst", "sequence": 70, "label": "Câu 18.2", "pages": [79], "printedPages": [79]}, "bloom": {"level": "remember", "rationale": "Nhớ lại định nghĩa, tính chất hoặc quy tắc đã học.", "review": "reviewed"}, "status": "ready", "notes": ["Phần dẫn và phương án đối chiếu ảnh trang sách; lời giải do người biên soạn kiểm tra.", "Nhãn Bloom là phân loại nội bộ, chưa thẩm định độc lập; mức độ ma trận được rà soát riêng."]}, {"id": "ctst-nuclear-072", "kind": "choice", "topic": "B23", "chapter": "Vật lí hạt nhân", "level": "Vận dụng", "prompt": "Khoảng giữa tháng 3/2015, khi bàn giao tài sản do đổi người phụ trách an toàn bức xạ, nhà máy thép tại Bà Rịa–Vũng Tàu phát hiện nguồn $^{60}_{27}\\mathrm{Co}$ thất lạc. Nhà chức trách chỉ đạo khẩn cấp tìm nguồn. Việc tìm kiếm rất quan trọng vì nguồn này", "explanation": "C. Nguồn có thể gây phơi nhiễm nguy hiểm nếu không được kiểm soát.", "points": 1, "source": {"book": "Sách bài tập Vật lí 12 · Chân trời sáng tạo", "bookId": "ctst", "sequence": 72, "label": "Câu 18.4", "pages": [80], "printedPages": [80]}, "bloom": {"level": "apply", "rationale": "Thực hiện quy tắc hoặc phép tính với dữ kiện của bài.", "review": "reviewed"}, "status": "ready", "notes": ["Phần dẫn và phương án đối chiếu ảnh trang sách; lời giải do người biên soạn kiểm tra.", "Nhãn Bloom là phân loại nội bộ, chưa thẩm định độc lập; mức độ ma trận được rà soát riêng."], "options": ["rất đắt tiền.", "khó sản xuất nên khó tìm thấy trên thị trường.", "có thể gây nguy hiểm đến sức khỏe dân cư.", "cần thiết trong việc khảo sát sức bền của thép."], "answer": 2}, {"id": "ctst-nuclear-073", "kind": "written", "topic": "B23", "chapter": "Vật lí hạt nhân", "level": "Thông hiểu", "prompt": "So sánh hai biển cảnh báo khu vực có chất phóng xạ trong Hình 18.1 và cho biết điểm khác biệt quan trọng giữa hai biển.", "explanation": "Biển a có kí hiệu ba cánh; biển b thêm sọ và người chạy/mũi tên để diễn đạt nguy hiểm và tránh xa rõ hơn cho người chưa hiểu kí hiệu.", "points": 1, "source": {"book": "Sách bài tập Vật lí 12 · Chân trời sáng tạo", "bookId": "ctst", "sequence": 73, "label": "Bài 18.1", "pages": [80, 81], "printedPages": [80, 81]}, "bloom": {"level": "understand", "rationale": "Diễn giải, so sánh hoặc giải thích ý nghĩa vật lí.", "review": "reviewed"}, "status": "ready", "notes": ["Phần dẫn và phương án đối chiếu ảnh trang sách; lời giải do người biên soạn kiểm tra.", "Nhãn Bloom là phân loại nội bộ, chưa thẩm định độc lập; mức độ ma trận được rà soát riêng."], "figure": {"url": "/api/book-bank/asset?file=ctst%2Fverified-figures%2Fhinh-18-1.png", "description": "Hình minh họa của bài", "origin": "source_crop"}}, {"id": "ctst-nuclear-074", "kind": "written", "topic": "B23", "chapter": "Vật lí hạt nhân", "level": "Thông hiểu", "prompt": "Quan sát Hình 18.2 và nêu các yếu tố quan trọng trong tuân thủ các quy tắc an toàn phóng xạ.", "explanation": "a) Giảm thời gian; b) Tăng khoảng cách; c) Dùng che chắn thích hợp.", "points": 1, "source": {"book": "Sách bài tập Vật lí 12 · Chân trời sáng tạo", "bookId": "ctst", "sequence": 74, "label": "Bài 18.2", "pages": [81], "printedPages": [81]}, "bloom": {"level": "understand", "rationale": "Diễn giải, so sánh hoặc giải thích ý nghĩa vật lí.", "review": "reviewed"}, "status": "ready", "notes": ["Phần dẫn và phương án đối chiếu ảnh trang sách; lời giải do người biên soạn kiểm tra.", "Nhãn Bloom là phân loại nội bộ, chưa thẩm định độc lập; mức độ ma trận được rà soát riêng."], "figure": {"url": "/api/book-bank/asset?file=ctst%2Fverified-figures%2Fhinh-18-2.png", "description": "Hình minh họa của bài", "origin": "source_crop"}}, {"id": "ctst-nuclear-075", "kind": "written", "topic": "B23", "chapter": "Vật lí hạt nhân", "level": "Thông hiểu", "prompt": "Trong sự cố rò rỉ phóng xạ, khi tiếp xúc chất phóng xạ, cởi bỏ trang phục đang mặc có tác dụng giảm khả năng bị nhiễm xạ không? Giải thích.", "explanation": "Có thể loại bỏ chất phóng xạ bám ngoài quần áo, giảm nhiễm bẩn và chiếu xạ tiếp diễn. Không xóa liều đã nhận hay loại chất đã vào cơ thể.", "points": 1, "source": {"book": "Sách bài tập Vật lí 12 · Chân trời sáng tạo", "bookId": "ctst", "sequence": 75, "label": "Bài 18.3", "pages": [81], "printedPages": [81]}, "bloom": {"level": "understand", "rationale": "Diễn giải, so sánh hoặc giải thích ý nghĩa vật lí.", "review": "reviewed"}, "status": "ready", "notes": ["Phần dẫn và phương án đối chiếu ảnh trang sách; lời giải do người biên soạn kiểm tra.", "Nhãn Bloom là phân loại nội bộ, chưa thẩm định độc lập; mức độ ma trận được rà soát riêng."]}, {"id": "ctst-nuclear-076", "kind": "written", "topic": "B23", "chapter": "Vật lí hạt nhân", "level": "Vận dụng", "prompt": "Radon ($^{222}_{86}\\mathrm{Rn}$) và radium ($^{226}_{88}\\mathrm{Ra}$) có phải chất phóng xạ không? Quá trình nhiễm xạ vào cơ thể của hai nguyên tố khác nhau thế nào, có thể tác hại cơ quan nào?", "explanation": "Cả hai đồng vị phóng xạ. Radon là khí, con cháu phân rã có thể hít vào và lắng đường hô hấp, ảnh hưởng phổi; radium có thể vào qua ăn/uống và tích lũy trong xương do tính hóa học gần calcium. Yêu cầu giải thích con đường phơi nhiễm, không suy chẩn đoán cá nhân.", "points": 1, "source": {"book": "Sách bài tập Vật lí 12 · Chân trời sáng tạo", "bookId": "ctst", "sequence": 76, "label": "Bài 18.4", "pages": [81], "printedPages": [81]}, "bloom": {"level": "analyze", "rationale": "Phân tách thông tin và liên hệ các thành phần để tìm kết quả.", "review": "reviewed"}, "status": "ready", "notes": ["Phần dẫn và phương án đối chiếu ảnh trang sách; lời giải do người biên soạn kiểm tra.", "Nhãn Bloom là phân loại nội bộ, chưa thẩm định độc lập; mức độ ma trận được rà soát riêng."]}, {"id": "sbt-kntt-nuclear-001-tf-3", "kind": "true_false", "topic": "B21", "chapter": "Vật lí hạt nhân", "level": "Thông hiểu", "prompt": "Đánh dấu (x) vào các cột đúng hoặc sai tương ứng với các nội dung trong bảng dưới đây.", "explanation": "a) Đúng.\nb) Sai.\nc) Đúng.\nd) Sai.", "points": 1, "source": {"book": "Sách bài tập Vật lí 12 · Kết nối tri thức", "bookId": "sbt-kntt", "sequence": 1, "label": "21.1", "pages": [70, 71], "printedPages": [70, 71], "parts": [{"questionId": "sbt-kntt-nuclear-001", "book": "Sách bài tập Vật lí 12 · Kết nối tri thức", "bookId": "sbt-kntt", "sequence": 1, "label": "21.1", "pages": [70, 71], "printedPages": [70, 71], "statementIndexes": [0, 1, 2, 3]}]}, "bloom": {"level": "understand", "rationale": "Diễn giải, so sánh hoặc giải thích ý nghĩa vật lí.", "review": "reviewed"}, "status": "ready", "notes": ["Phần dẫn và phương án đối chiếu ảnh trang sách; lời giải do người biên soạn kiểm tra.", "Nhãn Bloom là phân loại nội bộ, chưa thẩm định độc lập; mức độ ma trận được rà soát riêng.", "Tách/ghép thành bốn ý cùng chủ đề; lưu vị trí từng ý để đối chiếu nội bộ."], "statements": [{"text": "Hạt nhân mang điện tích dương, có khối lượng gần bằng khối lượng nguyên tử chứa nó nhưng kích thước nhỏ hơn kích thước nguyên tử cỡ $10^4$ lần.", "answer": true}, {"text": "Hạt nhân mang điện tích dương, có khối lượng nhỏ hơn khối lượng nguyên tử chứa nó rất nhiều và kích thước nhỏ hơn kích thước nguyên tử cỡ $10^4$ lần.", "answer": false}, {"text": "Đơn vị khối lượng nguyên tử kí hiệu là amu; 1 amu bằng $1/12$ khối lượng nguyên tử của đồng vị $^{12}_{6}\\mathrm{C}$; $1\\ \\mathrm{amu}=1{,}66054\\times10^{-27}$ kg.", "answer": true}, {"text": "Hạt nhân nguyên tử được tạo thành bởi các hạt nucleon và electron.", "answer": false}]}, {"id": "sbt-kntt-nuclear-001-tf-4", "kind": "true_false", "topic": "B21", "chapter": "Vật lí hạt nhân", "level": "Thông hiểu", "prompt": "Đánh dấu (x) vào các cột đúng hoặc sai tương ứng với các nội dung trong bảng dưới đây.", "explanation": "a) Đúng.\nb) Đúng.\nc) Đúng.\nd) Đúng.", "points": 1, "source": {"book": "Sách bài tập Vật lí 12 · Kết nối tri thức", "bookId": "sbt-kntt", "sequence": 1, "label": "21.1", "pages": [70, 71], "printedPages": [70, 71], "parts": [{"questionId": "sbt-kntt-nuclear-001", "book": "Sách bài tập Vật lí 12 · Kết nối tri thức", "bookId": "sbt-kntt", "sequence": 1, "label": "21.1", "pages": [70, 71], "printedPages": [70, 71], "statementIndexes": [4, 5, 6, 7]}]}, "bloom": {"level": "understand", "rationale": "Diễn giải, so sánh hoặc giải thích ý nghĩa vật lí.", "review": "reviewed"}, "status": "ready", "notes": ["Phần dẫn và phương án đối chiếu ảnh trang sách; lời giải do người biên soạn kiểm tra.", "Nhãn Bloom là phân loại nội bộ, chưa thẩm định độc lập; mức độ ma trận được rà soát riêng.", "Tách/ghép thành bốn ý cùng chủ đề; lưu vị trí từng ý để đối chiếu nội bộ."], "statements": [{"text": "Hạt nhân nguyên tử được tạo thành bởi các hạt nucleon.", "answer": true}, {"text": "Có hai loại nucleon là proton mang điện tích +1e và neutron trung hòa về điện. Các nucleon có khối lượng xấp xỉ bằng 1 amu.", "answer": true}, {"text": "Kí hiệu hạt nhân $^{A}_{Z}\\mathrm{X}$, trong đó X, A, Z lần lượt là kí hiệu hóa học nguyên tố, số khối và số hiệu nguyên tử.", "answer": true}, {"text": "Các nucleon nằm sát nhau và không chồng lấn vào nhau.", "answer": true}]}, {"id": "sbt-kntt-nuclear-002", "kind": "choice", "topic": "B21", "chapter": "Vật lí hạt nhân", "level": "Nhận biết", "prompt": "Hạt nhân nguyên tử gồm", "explanation": "B. Hai loại nucleon là neutron và proton.", "points": 1, "source": {"book": "Sách bài tập Vật lí 12 · Kết nối tri thức", "bookId": "sbt-kntt", "sequence": 2, "label": "21.2", "pages": [71], "printedPages": [71]}, "bloom": {"level": "remember", "rationale": "Nhớ lại định nghĩa, tính chất hoặc quy tắc đã học.", "review": "reviewed"}, "status": "ready", "notes": ["Phần dẫn và phương án đối chiếu ảnh trang sách; lời giải do người biên soạn kiểm tra.", "Nhãn Bloom là phân loại nội bộ, chưa thẩm định độc lập; mức độ ma trận được rà soát riêng."], "options": ["electron và proton.", "neutron và proton.", "neutron và electron.", "electron và pozitron."], "answer": 1}, {"id": "sbt-kntt-nuclear-003", "kind": "choice", "topic": "B21", "chapter": "Vật lí hạt nhân", "level": "Nhận biết", "prompt": "Các nguyên tử là nguyên tử đồng vị khi hạt nhân của chúng có", "explanation": "A. Cùng Z. B và C lặp lại trong bản nguồn, được giữ nguyên.", "points": 1, "source": {"book": "Sách bài tập Vật lí 12 · Kết nối tri thức", "bookId": "sbt-kntt", "sequence": 3, "label": "21.3", "pages": [71], "printedPages": [71]}, "bloom": {"level": "remember", "rationale": "Nhớ lại định nghĩa, tính chất hoặc quy tắc đã học.", "review": "reviewed"}, "status": "ready", "notes": ["Phần dẫn và phương án đối chiếu ảnh trang sách; lời giải do người biên soạn kiểm tra.", "Nhãn Bloom là phân loại nội bộ, chưa thẩm định độc lập; mức độ ma trận được rà soát riêng."], "options": ["cùng số proton.", "cùng số neutron.", "cùng số neutron.", "cùng khối lượng."], "answer": 0}, {"id": "sbt-kntt-nuclear-004", "kind": "choice", "topic": "B21", "chapter": "Vật lí hạt nhân", "level": "Vận dụng", "prompt": "Hạt nhân $^{31}_{15}\\mathrm{P}$ có", "explanation": "C. Z=15, N=31−15=16.", "points": 1, "source": {"book": "Sách bài tập Vật lí 12 · Kết nối tri thức", "bookId": "sbt-kntt", "sequence": 4, "label": "21.4", "pages": [71], "printedPages": [71]}, "bloom": {"level": "apply", "rationale": "Thực hiện quy tắc hoặc phép tính với dữ kiện của bài.", "review": "reviewed"}, "status": "ready", "notes": ["Phần dẫn và phương án đối chiếu ảnh trang sách; lời giải do người biên soạn kiểm tra.", "Nhãn Bloom là phân loại nội bộ, chưa thẩm định độc lập; mức độ ma trận được rà soát riêng."], "options": ["31 proton và 15 neutron.", "16 proton và 15 neutron.", "15 proton và 16 neutron.", "31 neutron và 15 proton."], "answer": 2}, {"id": "sbt-kntt-nuclear-005", "kind": "choice", "topic": "B21", "chapter": "Vật lí hạt nhân", "level": "Vận dụng", "prompt": "Hạt nhân nguyên tử $^{41}_{19}\\mathrm{K}$ gồm", "explanation": "B. Z=19, N=41−19=22.", "points": 1, "source": {"book": "Sách bài tập Vật lí 12 · Kết nối tri thức", "bookId": "sbt-kntt", "sequence": 5, "label": "21.5", "pages": [71], "printedPages": [71]}, "bloom": {"level": "apply", "rationale": "Thực hiện quy tắc hoặc phép tính với dữ kiện của bài.", "review": "reviewed"}, "status": "ready", "notes": ["Phần dẫn và phương án đối chiếu ảnh trang sách; lời giải do người biên soạn kiểm tra.", "Nhãn Bloom là phân loại nội bộ, chưa thẩm định độc lập; mức độ ma trận được rà soát riêng."], "options": ["19 proton và 41 neutron.", "19 proton và 22 neutron.", "41 proton và 19 neutron.", "22 proton và 19 neutron."], "answer": 1}, {"id": "sbt-kntt-nuclear-006", "kind": "choice", "topic": "B21", "chapter": "Vật lí hạt nhân", "level": "Vận dụng", "prompt": "Có 22 neutron trong đồng vị $^{42}\\mathrm{Ca}$. Số proton trong đồng vị $^{40}\\mathrm{Ca}$ là", "explanation": "D. Cùng nguyên tố nên cùng Z=42−22=20.", "points": 1, "source": {"book": "Sách bài tập Vật lí 12 · Kết nối tri thức", "bookId": "sbt-kntt", "sequence": 6, "label": "21.6", "pages": [71], "printedPages": [71]}, "bloom": {"level": "apply", "rationale": "Thực hiện quy tắc hoặc phép tính với dữ kiện của bài.", "review": "reviewed"}, "status": "ready", "notes": ["Phần dẫn và phương án đối chiếu ảnh trang sách; lời giải do người biên soạn kiểm tra.", "Nhãn Bloom là phân loại nội bộ, chưa thẩm định độc lập; mức độ ma trận được rà soát riêng."], "options": ["28.", "26.", "24.", "20."], "answer": 3}, {"id": "sbt-kntt-nuclear-007", "kind": "choice", "topic": "B21", "chapter": "Vật lí hạt nhân", "level": "Vận dụng", "prompt": "Cho số Avogadro $N_A=6{,}02\\times10^{23}\\ \\mathrm{mol}^{-1}$. Số neutron có trong 3,5 g carbon $^{14}_{6}\\mathrm{C}$ có giá trị bằng", "explanation": "D. $(3{,}5/14)N_A\\times8=12{,}04\\times10^{23}$.", "points": 1, "source": {"book": "Sách bài tập Vật lí 12 · Kết nối tri thức", "bookId": "sbt-kntt", "sequence": 7, "label": "21.7", "pages": [71], "printedPages": [71]}, "bloom": {"level": "apply", "rationale": "Thực hiện quy tắc hoặc phép tính với dữ kiện của bài.", "review": "reviewed"}, "status": "ready", "notes": ["Phần dẫn và phương án đối chiếu ảnh trang sách; lời giải do người biên soạn kiểm tra.", "Nhãn Bloom là phân loại nội bộ, chưa thẩm định độc lập; mức độ ma trận được rà soát riêng."], "options": ["$3{,}01\\times10^{23}$", "$6{,}02\\times10^{23}$", "$9{,}03\\times10^{23}$", "$12{,}04\\times10^{23}$"], "answer": 3}, {"id": "sbt-kntt-nuclear-008", "kind": "choice", "topic": "B21", "chapter": "Vật lí hạt nhân", "level": "Vận dụng", "prompt": "Cho khối lượng các nguyên tử oxygen và hydrogen lần lượt là 15,999 amu; 1,0078 amu. Số nguyên tử oxygen có trong 5 g nước xấp xỉ bằng", "explanation": "A. Mỗi phân tử nước có một O: $N=5N_A/(15{,}999+2\\times1{,}0078)\\approx1{,}67\\times10^{23}$.", "points": 1, "source": {"book": "Sách bài tập Vật lí 12 · Kết nối tri thức", "bookId": "sbt-kntt", "sequence": 8, "label": "21.8", "pages": [71], "printedPages": [71]}, "bloom": {"level": "apply", "rationale": "Thực hiện quy tắc hoặc phép tính với dữ kiện của bài.", "review": "reviewed"}, "status": "ready", "notes": ["Phần dẫn và phương án đối chiếu ảnh trang sách; lời giải do người biên soạn kiểm tra.", "Nhãn Bloom là phân loại nội bộ, chưa thẩm định độc lập; mức độ ma trận được rà soát riêng."], "options": ["$1{,}67\\times10^{23}$", "$1{,}51\\times10^{23}$", "$6{,}02\\times10^{23}$", "$3{,}34\\times10^{23}$"], "answer": 0}, {"id": "sbt-kntt-nuclear-009", "kind": "written", "topic": "B21", "chapter": "Vật lí hạt nhân", "level": "Vận dụng", "prompt": "Xác định giá trị gần đúng bán kính của hạt nhân $^{238}_{92}\\mathrm{U}$. Hạt nhân $^{238}_{92}\\mathrm{U}$ có thể tích lớn gấp thể tích của hạt nhân $^{4}_{2}\\mathrm{He}$ khoảng mấy lần?", "explanation": "$R\\approx7{,}44\\times10^{-15}$ m; $V_U/V_{He}=238/4=59{,}5$.", "points": 1, "source": {"book": "Sách bài tập Vật lí 12 · Kết nối tri thức", "bookId": "sbt-kntt", "sequence": 9, "label": "21.9", "pages": [71], "printedPages": [71]}, "bloom": {"level": "apply", "rationale": "Thực hiện quy tắc hoặc phép tính với dữ kiện của bài.", "review": "reviewed"}, "status": "ready", "notes": ["Phần dẫn và phương án đối chiếu ảnh trang sách; lời giải do người biên soạn kiểm tra.", "Nhãn Bloom là phân loại nội bộ, chưa thẩm định độc lập; mức độ ma trận được rà soát riêng."]}, {"id": "sbt-kntt-nuclear-011", "kind": "written", "topic": "B21", "chapter": "Vật lí hạt nhân", "level": "Vận dụng", "prompt": "Khối lượng nguyên tử của một nguyên tố hóa học là khối lượng trung bình của một nguyên tử chất đó (amu). Trong thiên nhiên có các đồng vị với tỉ lệ xác định, nên khối lượng nguyên tử của một nguyên tố hóa học không bao giờ là số nguyên, trong khi A của một hạt nhân luôn là số nguyên. Neon thiên nhiên gồm $^{20}_{10}\\mathrm{Ne}$, $^{21}_{10}\\mathrm{Ne}$, $^{22}_{10}\\mathrm{Ne}$; Ne-21 chiếm 0,26%, chủ yếu còn lại là hai thành phần kia. Khối lượng nguyên tử neon là 20,179 amu. Tính tỉ lệ phần trăm Ne-20 và Ne-22.", "explanation": "Theo gần đúng khối lượng bằng số khối: $20x+21\\times0{,}0026+22(0{,}9974-x)=20{,}179$. Ne-20: 90,92%; Ne-22: 8,82%. Mệnh đề “không bao giờ là số nguyên” không đúng tuyệt đối; lời giải chỉ dùng dữ kiện neon.", "points": 1, "source": {"book": "Sách bài tập Vật lí 12 · Kết nối tri thức", "bookId": "sbt-kntt", "sequence": 11, "label": "21.11", "pages": [72], "printedPages": [72]}, "bloom": {"level": "apply", "rationale": "Thực hiện quy tắc hoặc phép tính với dữ kiện của bài.", "review": "reviewed"}, "status": "ready", "notes": ["Phần dẫn và phương án đối chiếu ảnh trang sách; lời giải do người biên soạn kiểm tra.", "Nhãn Bloom là phân loại nội bộ, chưa thẩm định độc lập; mức độ ma trận được rà soát riêng."]}, {"id": "sbt-kntt-nuclear-012", "kind": "numeric", "topic": "B21", "chapter": "Vật lí hạt nhân", "level": "Vận dụng", "prompt": "Khí chlorine là hỗn hợp hai đồng vị bền: $^{35}_{17}\\mathrm{Cl}$ có khối lượng nguyên tử 34,969 amu, hàm lượng 75,4%; $^{37}_{17}\\mathrm{Cl}$ có khối lượng nguyên tử 36,966 amu, hàm lượng 24,6%. Tính khối lượng nguyên tử của nguyên tố hóa học chlorine.", "explanation": "$35{,}460262$ amu.\n$\\bar m=34{,}969\\times0{,}754+36{,}966\\times0{,}246$.", "points": 1, "source": {"book": "Sách bài tập Vật lí 12 · Kết nối tri thức", "bookId": "sbt-kntt", "sequence": 12, "label": "21.12", "pages": [72], "printedPages": [72]}, "bloom": {"level": "apply", "rationale": "Thực hiện quy tắc hoặc phép tính với dữ kiện của bài.", "review": "reviewed"}, "status": "ready", "notes": ["Phần dẫn và phương án đối chiếu ảnh trang sách; lời giải do người biên soạn kiểm tra.", "Nhãn Bloom là phân loại nội bộ, chưa thẩm định độc lập; mức độ ma trận được rà soát riêng."], "answerText": "$35{,}460262$ amu."}, {"id": "sbt-kntt-nuclear-013-tf-3", "kind": "true_false", "topic": "B22", "chapter": "Vật lí hạt nhân", "level": "Thông hiểu", "prompt": "Đánh dấu (x) vào các cột đúng hoặc sai tương ứng với các nội dung trong bảng dưới đây.", "explanation": "a) Đúng.\nb) Sai.\nc) Đúng.\nd) Đúng.", "points": 1, "source": {"book": "Sách bài tập Vật lí 12 · Kết nối tri thức", "bookId": "sbt-kntt", "sequence": 13, "label": "22.1", "pages": [73, 74], "printedPages": [73, 74], "parts": [{"questionId": "sbt-kntt-nuclear-013", "book": "Sách bài tập Vật lí 12 · Kết nối tri thức", "bookId": "sbt-kntt", "sequence": 13, "label": "22.1", "pages": [73, 74], "printedPages": [73, 74], "statementIndexes": [2, 3, 4, 5]}]}, "bloom": {"level": "understand", "rationale": "Diễn giải, so sánh hoặc giải thích ý nghĩa vật lí.", "review": "reviewed"}, "status": "ready", "notes": ["Phần dẫn và phương án đối chiếu ảnh trang sách; lời giải do người biên soạn kiểm tra.", "Nhãn Bloom là phân loại nội bộ, chưa thẩm định độc lập; mức độ ma trận được rà soát riêng.", "Tách/ghép thành bốn ý cùng chủ đề; lưu vị trí từng ý để đối chiếu nội bộ."], "statements": [{"text": "Trong phản ứng hạt nhân, số khối và điện tích của hệ được bảo toàn.", "answer": true}, {"text": "Trong phản ứng hạt nhân, số khối, điện tích và khối lượng của hệ được bảo toàn.", "answer": false}, {"text": "Phản ứng phân hạch là phản ứng hạt nhân trong đó một hạt nhân nặng vỡ thành hai mảnh nhẹ hơn.", "answer": true}, {"text": "Phản ứng tổng hợp hạt nhân là phản ứng trong đó hai hay nhiều hạt nhân nhẹ tổng hợp lại thành một hạt nhân nặng hơn.", "answer": true}]}, {"id": "sbt-kntt-nuclear-013-tf-4", "kind": "true_false", "topic": "B22", "chapter": "Vật lí hạt nhân", "level": "Thông hiểu", "prompt": "Đánh dấu (x) vào các cột đúng hoặc sai tương ứng với các nội dung trong bảng dưới đây.", "explanation": "a) Sai.\nb) Đúng.\nc) Đúng.\nd) Đúng.", "points": 1, "source": {"book": "Sách bài tập Vật lí 12 · Kết nối tri thức", "bookId": "sbt-kntt", "sequence": 13, "label": "22.1", "pages": [73, 74], "printedPages": [73, 74], "parts": [{"questionId": "sbt-kntt-nuclear-013", "book": "Sách bài tập Vật lí 12 · Kết nối tri thức", "bookId": "sbt-kntt", "sequence": 13, "label": "22.1", "pages": [73, 74], "printedPages": [73, 74], "statementIndexes": [6, 7, 8, 9]}]}, "bloom": {"level": "understand", "rationale": "Diễn giải, so sánh hoặc giải thích ý nghĩa vật lí.", "review": "reviewed"}, "status": "ready", "notes": ["Phần dẫn và phương án đối chiếu ảnh trang sách; lời giải do người biên soạn kiểm tra.", "Nhãn Bloom là phân loại nội bộ, chưa thẩm định độc lập; mức độ ma trận được rà soát riêng.", "Tách/ghép thành bốn ý cùng chủ đề; lưu vị trí từng ý để đối chiếu nội bộ."], "statements": [{"text": "Phản ứng tổng hợp hạt nhân là phản ứng trong đó hai hay nhiều hạt nhân trung bình tổng hợp lại thành một hạt nhân nặng.", "answer": false}, {"text": "Độ hụt khối $\\Delta m$ là độ chênh lệch tổng khối lượng các nucleon tạo thành hạt nhân và khối lượng hạt nhân: $\\Delta m=[Zm_p+(A-Z)m_n]-m_X$.", "answer": true}, {"text": "Năng lượng E và khối lượng m tương ứng của cùng một vật liên hệ theo hệ thức Einstein: $E=mc^2$, c là tốc độ ánh sáng trong chân không.", "answer": true}, {"text": "Năng lượng liên kết riêng của hạt nhân có số khối A bằng $E_{lkr}=E_{lk}/A$, trong đó $E_{lk}$ là năng lượng tối thiểu để tách toàn bộ nucleon ra khỏi hạt nhân, gọi là năng lượng liên kết hạt nhân. Hạt nhân càng bền vững khi $E_{lkr}$ càng lớn.", "answer": true}]}, {"id": "sbt-kntt-nuclear-014", "kind": "choice", "topic": "B22", "chapter": "Vật lí hạt nhân", "level": "Thông hiểu", "prompt": "Một hạt nhân có độ hụt khối càng lớn thì hạt nhân đó", "explanation": "A. Năng lượng liên kết tỉ lệ với độ hụt khối.", "points": 1, "source": {"book": "Sách bài tập Vật lí 12 · Kết nối tri thức", "bookId": "sbt-kntt", "sequence": 14, "label": "22.2", "pages": [74], "printedPages": [74]}, "bloom": {"level": "understand", "rationale": "Diễn giải, so sánh hoặc giải thích ý nghĩa vật lí.", "review": "reviewed"}, "status": "ready", "notes": ["Phần dẫn và phương án đối chiếu ảnh trang sách; lời giải do người biên soạn kiểm tra.", "Nhãn Bloom là phân loại nội bộ, chưa thẩm định độc lập; mức độ ma trận được rà soát riêng."], "options": ["có năng lượng liên kết càng lớn.", "có năng lượng liên kết không đổi.", "có năng lượng liên kết càng nhỏ.", "càng bền vững."], "answer": 0}, {"id": "sbt-kntt-nuclear-015", "kind": "choice", "topic": "B22", "chapter": "Vật lí hạt nhân", "level": "Nhận biết", "prompt": "Năng lượng liên kết của hạt nhân bằng", "explanation": "C. Là năng lượng cần tách rời tất cả nucleon.", "points": 1, "source": {"book": "Sách bài tập Vật lí 12 · Kết nối tri thức", "bookId": "sbt-kntt", "sequence": 15, "label": "22.3", "pages": [74], "printedPages": [74]}, "bloom": {"level": "remember", "rationale": "Nhớ lại định nghĩa, tính chất hoặc quy tắc đã học.", "review": "reviewed"}, "status": "ready", "notes": ["Phần dẫn và phương án đối chiếu ảnh trang sách; lời giải do người biên soạn kiểm tra.", "Nhãn Bloom là phân loại nội bộ, chưa thẩm định độc lập; mức độ ma trận được rà soát riêng."], "options": ["năng lượng trung bình liên kết mỗi nucleon trong hạt nhân.", "năng lượng cần thiết để tách một nucleon khỏi hạt nhân.", "năng lượng cần thiết để tách rời tất cả các nucleon trong hạt nhân.", "tích khối lượng hạt nhân với bình phương tốc độ ánh sáng trong chân không."], "answer": 2}, {"id": "sbt-kntt-nuclear-016", "kind": "choice", "topic": "B22", "chapter": "Vật lí hạt nhân", "level": "Nhận biết", "prompt": "Năng lượng liên kết riêng của hạt nhân có giá trị", "explanation": "C. Lớn nhất ở vùng hạt nhân trung bình.", "points": 1, "source": {"book": "Sách bài tập Vật lí 12 · Kết nối tri thức", "bookId": "sbt-kntt", "sequence": 16, "label": "22.4", "pages": [74], "printedPages": [74]}, "bloom": {"level": "remember", "rationale": "Nhớ lại định nghĩa, tính chất hoặc quy tắc đã học.", "review": "reviewed"}, "status": "ready", "notes": ["Phần dẫn và phương án đối chiếu ảnh trang sách; lời giải do người biên soạn kiểm tra.", "Nhãn Bloom là phân loại nội bộ, chưa thẩm định độc lập; mức độ ma trận được rà soát riêng."], "options": ["lớn nhất đối với các hạt nhân nhẹ.", "lớn nhất đối với các hạt nhân nặng.", "lớn nhất đối với các hạt nhân trung bình.", "như nhau với mọi hạt nhân."], "answer": 2}, {"id": "sbt-kntt-nuclear-017", "kind": "choice", "topic": "B22", "chapter": "Vật lí hạt nhân", "level": "Nhận biết", "prompt": "Độ hụt khối của hạt nhân $^{A}_{Z}\\mathrm{X}$ là", "explanation": "A. Tổng khối lượng nucleon tự do trừ khối lượng hạt nhân.", "points": 1, "source": {"book": "Sách bài tập Vật lí 12 · Kết nối tri thức", "bookId": "sbt-kntt", "sequence": 17, "label": "22.5", "pages": [74], "printedPages": [74]}, "bloom": {"level": "remember", "rationale": "Nhớ lại định nghĩa, tính chất hoặc quy tắc đã học.", "review": "reviewed"}, "status": "ready", "notes": ["Phần dẫn và phương án đối chiếu ảnh trang sách; lời giải do người biên soạn kiểm tra.", "Nhãn Bloom là phân loại nội bộ, chưa thẩm định độc lập; mức độ ma trận được rà soát riêng."], "options": ["$\\Delta m=(Zm_p+Nm_n)-m$", "$\\Delta m=m-Nm_p-Zm_n$", "$\\Delta m=Zm_n-Zm_p$", "$\\Delta m=Zm_n+Nm_p$"], "answer": 0}, {"id": "sbt-kntt-nuclear-019", "kind": "choice", "topic": "B22", "chapter": "Vật lí hạt nhân", "level": "Nhận biết", "prompt": "Đại lượng nào sau đây đặc trưng cho mức độ bền vững của hạt nhân?", "explanation": "B. Năng lượng liên kết riêng.", "points": 1, "source": {"book": "Sách bài tập Vật lí 12 · Kết nối tri thức", "bookId": "sbt-kntt", "sequence": 19, "label": "22.7", "pages": [75], "printedPages": [75]}, "bloom": {"level": "remember", "rationale": "Nhớ lại định nghĩa, tính chất hoặc quy tắc đã học.", "review": "reviewed"}, "status": "ready", "notes": ["Phần dẫn và phương án đối chiếu ảnh trang sách; lời giải do người biên soạn kiểm tra.", "Nhãn Bloom là phân loại nội bộ, chưa thẩm định độc lập; mức độ ma trận được rà soát riêng."], "options": ["Số neutron.", "Năng lượng liên kết riêng.", "Số hạt proton.", "Năng lượng liên kết."], "answer": 1}, {"id": "sbt-kntt-nuclear-020", "kind": "choice", "topic": "B22", "chapter": "Vật lí hạt nhân", "level": "Vận dụng", "prompt": "Hạt alpha có độ hụt khối 0,0308 amu. Năng lượng liên kết của hạt này bằng", "explanation": "D. $E=0{,}0308\\times931{,}5\\approx28{,}69$ MeV.", "points": 1, "source": {"book": "Sách bài tập Vật lí 12 · Kết nối tri thức", "bookId": "sbt-kntt", "sequence": 20, "label": "22.8", "pages": [75], "printedPages": [75]}, "bloom": {"level": "apply", "rationale": "Thực hiện quy tắc hoặc phép tính với dữ kiện của bài.", "review": "reviewed"}, "status": "ready", "notes": ["Phần dẫn và phương án đối chiếu ảnh trang sách; lời giải do người biên soạn kiểm tra.", "Nhãn Bloom là phân loại nội bộ, chưa thẩm định độc lập; mức độ ma trận được rà soát riêng."], "options": ["23,52 MeV.", "25,72 MeV.", "24,72 MeV.", "28,70 MeV."], "answer": 3}, {"id": "sbt-kntt-nuclear-021", "kind": "choice", "topic": "B22", "chapter": "Vật lí hạt nhân", "level": "Vận dụng", "prompt": "Nếu năng lượng liên kết của hạt nhân helium $^{4}_{2}\\mathrm{He}$ là 28,8 MeV thì năng lượng liên kết riêng của nó là", "explanation": "A. 28,8/4=7,20 MeV/nucleon.", "points": 1, "source": {"book": "Sách bài tập Vật lí 12 · Kết nối tri thức", "bookId": "sbt-kntt", "sequence": 21, "label": "22.9", "pages": [75], "printedPages": [75]}, "bloom": {"level": "apply", "rationale": "Thực hiện quy tắc hoặc phép tính với dữ kiện của bài.", "review": "reviewed"}, "status": "ready", "notes": ["Phần dẫn và phương án đối chiếu ảnh trang sách; lời giải do người biên soạn kiểm tra.", "Nhãn Bloom là phân loại nội bộ, chưa thẩm định độc lập; mức độ ma trận được rà soát riêng."], "options": ["7,20 MeV/nucleon.", "14,1 MeV/nucleon.", "0,72 MeV/nucleon.", "1,4 MeV/nucleon."], "answer": 0}, {"id": "sbt-kntt-nuclear-022", "kind": "choice", "topic": "B22", "chapter": "Vật lí hạt nhân", "level": "Nhận biết", "prompt": "Độ bền vững của hạt nhân càng cao khi", "explanation": "D. So sánh năng lượng liên kết trên mỗi nucleon.", "points": 1, "source": {"book": "Sách bài tập Vật lí 12 · Kết nối tri thức", "bookId": "sbt-kntt", "sequence": 22, "label": "22.10", "pages": [75], "printedPages": [75]}, "bloom": {"level": "remember", "rationale": "Nhớ lại định nghĩa, tính chất hoặc quy tắc đã học.", "review": "reviewed"}, "status": "ready", "notes": ["Phần dẫn và phương án đối chiếu ảnh trang sách; lời giải do người biên soạn kiểm tra.", "Nhãn Bloom là phân loại nội bộ, chưa thẩm định độc lập; mức độ ma trận được rà soát riêng."], "options": ["số nucleon của hạt nhân càng nhỏ.", "số nucleon của hạt nhân càng lớn.", "năng lượng liên kết của nó càng lớn.", "năng lượng liên kết riêng của nó càng lớn."], "answer": 3}, {"id": "sbt-kntt-nuclear-023", "kind": "choice", "topic": "B22", "chapter": "Vật lí hạt nhân", "level": "Vận dụng", "prompt": "Một hạt nhân có 8 proton và 9 neutron. Năng lượng liên kết 