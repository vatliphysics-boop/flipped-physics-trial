"use client";

import type { ReactNode } from "react";
import { useEffect, useId, useRef, useState } from "react";
import Link from "next/link";
import { AIStudyHelp } from "@/components/learning/AIStudyHelp";
import { GRADE_12_CURRICULUM } from "@/lib/curriculum";

export type PortalRole = "teacher" | "student";
export type PortalSection = "overview" | "classes" | "curriculum" | "lessons" | "materials" | "students" | "assignments" | "journal" | "plans" | "tutor";
export type NavigationItem = { label: string; href: string; section: PortalSection };

const navigation: Record<PortalRole, NavigationItem[]> = {
  teacher: [
    { section: "overview", label: "Tổng quan", href: "/teacher" },
    { section: "classes", label: "Lớp học", href: "/teacher/classes" },
    { section: "curriculum", label: "Chương trình Vật lí 12", href: "/teacher/curriculum" },
    { section: "materials", label: "Học liệu", href: "/teacher/materials" },
    { section: "plans", label: "Kế hoạch dạy học của tôi", href: "/teacher/plans" },
    { section: "tutor", label: "Không gian giáo viên", href: "/teacher/ai" },
    { section: "students", label: "Học sinh và kết quả", href: "/teacher/students" },
  ],
  student: [
    { section: "materials", label: "Học liệu", href: "/student/materials" },
    { section: "tutor", label: "Học với AI", href: "/student/ai" },
    { section: "overview", label: "Tổng quan", href: "/student" },
    { section: "classes", label: "Lớp học của em", href: "/student/classes" },
    { section: "curriculum", label: "Chương trình Vật lí 12", href: "/student/curriculum" },
    { section: "assignments", label: "Bài tập và kiểm tra", href: "/student/assignments" },
    { section: "journal", label: "Nhật kí học tập", href: "/student/journal" },
  ],
};

const teacherMaterialSubItems = [
  { label: "Học theo hình · 3D · Video", href: "/hoc-lieu/truc-quan" },
  { label: "Hình thức lớp học đảo ngược", href: "/hoc-lieu/lop-hoc-dao-nguoc" },
  { label: "Tất cả học liệu", href: "/teacher/materials" },
  { label: "Ảnh tĩnh & Sơ đồ", href: "/teacher/materials?type=image" },
  { label: "Ảnh động & Minh họa", href: "/teacher/materials?type=animation" },
  { label: "Video thực tế / Thí nghiệm", href: "/teacher/materials?type=real_video" },
  { label: "Video bài giảng", href: "/teacher/materials?type=lecture_video" },
  { label: "Thí nghiệm 3D tương tác", href: "/teacher/materials?type=simulation" },
  { label: "PDF / Phiếu học tập", href: "/teacher/materials?type=document" },
  { label: "Câu hỏi & Nhiệm vụ", href: "/teacher/curriculum" },
  { label: "Đề giữa kỳ & Cuối kỳ", href: "/teacher/materials?type=assessment" },
];

function Navigation({ role, active, onNavigate, publicLibrary }: { role: PortalRole; active: PortalSection; onNavigate?: () => void; publicLibrary?: boolean }) {
  const submenuId = useId();
  const curriculumId = useId();
  const [materialsExpanded, setMaterialsExpanded] = useState(active === "materials");
  const [curriculumExpanded, setCurriculumExpanded] = useState(active === "curriculum");

  return <nav className="portal-nav" aria-label="Điều hướng chính">
    {navigation[role].map((item) => {
      if (item.section === "curriculum") return <div key={item.href} className="portal-nav-group">
        <button type="button" className={`portal-material-toggle ${active === "curriculum" ? "is-active" : ""}`} aria-expanded={curriculumExpanded} aria-controls={curriculumId} onClick={() => setCurriculumExpanded(open => !open)}>
          {item.label}<span aria-hidden="true">{curriculumExpanded ? "▲" : "▼"}</span>
        </button>
        {curriculumExpanded && <div id={curriculumId} className="portal-subnav" aria-label="Bốn chương Vật lí 12">
          {GRADE_12_CURRICULUM.map(chapter => <Link key={chapter.code} className="portal-subnav-link" href={publicLibrary ? `/hoc-lieu/chuong-trinh?chuong=${chapter.code}` : role === "teacher" ? `/teacher/curriculum?chuong=${chapter.code}` : `/student/curriculum/${chapter.code}`} onClick={onNavigate}>
            Chương {chapter.number}: {chapter.shortTitle}
          </Link>)}
        </div>}
      </div>;
      const isMaterials = item.section === "materials";
      if (isMaterials) {
        return (
          <div key={item.href} className="portal-nav-group">
            <button type="button" className={`portal-material-toggle ${active === "materials" ? "is-active" : ""}`} aria-expanded={materialsExpanded} aria-controls={submenuId} onClick={() => setMaterialsExpanded(v => !v)}>
              {item.label}<span aria-hidden="true">{materialsExpanded ? "▲" : "▼"}</span>
            </button>
            {materialsExpanded && (
              <div id={submenuId} className="portal-subnav" aria-label="Danh mục học liệu">
                {teacherMaterialSubItems.map((sub) => (
                  <Link
                    key={sub.href}
                    href={publicLibrary ? sub.href.replace("/teacher/materials", "/hoc-lieu").replace("/teacher/curriculum", "/hoc-lieu?type=colab") : role === "student" ? sub.href.replace("/teacher/", "/student/").replace("/student/curriculum", "/student/materials?type=colab") : sub.href}
                    onClick={onNavigate}
                    className="portal-subnav-link"
                  >
                    {sub.label}
                  </Link>
                ))}
              </div>
            )}
          </div>
        );
      }

      return (
        <Link
          key={item.href}
          href={publicLibrary && item.section === "tutor" ? role === "teacher" ? "/hoc-lieu/ai-giao-vien" : "/hoc-lieu/ai" : item.href}
          onClick={onNavigate}
          aria-current={item.section === active ? "page" : undefined}
          className={item.section === active ? "is-active" : ""}
        >
          {item.label}
        </Link>
      );
    })}
  </nav>;
}

export function PortalShell({ role, active, children, account, publicLibrary = false, aiLessonCode }: { role: PortalRole; active: PortalSection; children: ReactNode; account: ReactNode; publicLibrary?: boolean; aiLessonCode?: string }) {
  const [sidebarOpen, setSidebarOpen] = useState(true);
  const [mobileOpen, setMobileOpen] = useState(false);
  const desktopTrigger = useRef<HTMLButtonElement>(null);
  const mobileTrigger = useRef<HTMLButtonElement>(null);
  const drawer = useRef<HTMLElement>(null);

  useEffect(() => {
    if (!mobileOpen) return;
    const previousOverflow = document.body.style.overflow;
    document.body.style.overflow = "hidden";
    drawer.current?.querySelector<HTMLAnchorElement>("a")?.focus();
    const closeOnEscape = (event: KeyboardEvent) => { if (event.key === "Escape") setMobileOpen(false); };
    window.addEventListener("keydown", closeOnEscape);
    return () => { document.body.style.overflow = previousOverflow; window.removeEventListener("keydown", closeOnEscape); };
  }, [mobileOpen]);
  useEffect(() => { if (!mobileOpen) mobileTrigger.current?.focus(); }, [mobileOpen]);

  const label = sidebarOpen ? "Ẩn menu" : "Hiện menu";
  return <div className={`portal-shell ${sidebarOpen ? "sidebar-open" : "sidebar-closed"}`} data-role={role}>
    <a className="skip-link" href="#main-content">Đi đến nội dung chính</a>
    
    <header className="portal-topbar">
      <div className="topbar-left">
        <button ref={desktopTrigger} type="button" className="menu-toggle desktop-toggle" aria-label={label} aria-expanded={sidebarOpen} aria-controls="portal-sidebar" onClick={() => setSidebarOpen((open) => !open)}>
          <span aria-hidden="true">☰</span>
        </button>
        <button ref={mobileTrigger} type="button" className="menu-toggle mobile-toggle" aria-label="Mở menu" aria-expanded={mobileOpen} aria-controls="portal-mobile-menu" onClick={() => setMobileOpen(true)}>
          <span aria-hidden="true">☰</span>
        </button>
        <Link className="portal-name" href={publicLibrary ? "/hoc-lieu" : role === "teacher" ? "/teacher" : "/student"}>Học liệu Vật lí 12</Link>
      </div>
      <div className="portal-account">{account}</div>
    </header>

    <div className="portal-body">
      <aside id="portal-sidebar" className="portal-sidebar" aria-label="Thanh điều hướng">
        <Navigation publicLibrary={publicLibrary} role={role} active={active} />
      </aside>
      
      {mobileOpen ? <div className="drawer-layer" onMouseDown={(event) => { if (event.target === event.currentTarget) setMobileOpen(false); }}><aside ref={drawer} id="portal-mobile-menu" className="portal-drawer" aria-label="Menu di động" role="dialog" aria-modal="true"><div className="drawer-heading"><strong>Học liệu Vật lí 12</strong><button type="button" className="icon-button" aria-label="Đóng menu" onClick={() => setMobileOpen(false)}>×</button></div><Navigation publicLibrary={publicLibrary} role={role} active={active} onNavigate={() => setMobileOpen(false)} /></aside></div> : null}
      
      <main id="main-content" className="portal-main">{children}</main>
    </div>
    {role === "student" && <AIStudyHelp key={aiLessonCode || "general"} publicLibrary={publicLibrary} defaultLessonCode={aiLessonCode}/>}
  </div>;
}
